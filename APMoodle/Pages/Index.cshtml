@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to APMoodle</h1>
    <p>Your learning management system for university students.</p>
    
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📚 Learn</h5>
                    <p class="card-text">Access modules and learning materials</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📝 Quiz</h5>
                    <p class="card-text">Test your knowledge with quizzes</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📊 Track</h5>
                    <p class="card-text">Monitor your learning progress</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-4">
        <a href="/TestDB" class="btn btn-info">Check Database Status</a>
    </div>
    <div class="mt-4">
        <a href="/Login" class="btn btn-info">Login</a>
    </div>
    <div class="mt-4">
        <a href="/Register" class="btn btn-info">Register</a>
    </div>
</div>