@page "{id}"
@model APMoodle.Pages.BackEnd.TeachingMaterialOverviewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.CurrentMaterial?.Title;
}

@{
    var userRole = HttpContext.Session.GetString("UserRole") ?? "Guest";
    var isLecturer = userRole == "lecturer";
}

<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/materialOverview.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
        <p class="path">@(char.ToUpper(userRole[0]) + userRole.Substring(1)) Dashboard > @(Model.CurrentModule?.Name) > @ViewData["Title"]</p>
    </div>

    <div class="two-column-layout">
        <div class="info-column">
            <div class="material-header-row">
                @if (isLecturer)
                {
                    <a href="/FrontEnd/EditMaterial/@Model.CurrentMaterial?.MaterialID" class="edit-btn">
                        <i class="bi bi-pencil-square" title="Edit teaching material"></i> Edit Material
                    </a>
                    
                    <!-- Delete button that opens modal -->
                    <button type="button" class="delete-btn" 
                            data-id="@Model.CurrentMaterial?.MaterialID" 
                            data-title="@Model.CurrentMaterial?.Title"
                            data-module-id="@Model.CurrentModule?.ModuleID"
                            onclick="openDeleteModal(this)"
                            style="border: none;  cursor: pointer;">
                        <i class="bi bi-trash" title="Delete teaching material"></i> Delete Material
                    </button>
                }
            </div>
            
            <div class="material-meta">
                <span>📅 @(Model.CurrentMaterial?.CreatedAt.ToString("dd MMM yyyy") ?? "N/A")</span>
                <span>👨‍🏫 by @(Model.CurrentModule?.Lecturer?.Name ?? "Unknown")</span>
            </div>
            
            <div class="material-description">
                <p>@(Model.CurrentMaterial?.Description ?? "No description")</p>
            </div>

            @if (Model.CurrentMaterial?.ContentType == "file" && !string.IsNullOrEmpty(Model.CurrentMaterial?.FileURL))
            {
                <div class="file-attachment">
                    <span class="file-icon">📄</span>
                    <span class="file-name">@System.IO.Path.GetFileName(Model.CurrentMaterial.FileURL)</span>
                    <a href="@Model.CurrentMaterial.FileURL" class="download-btn" target="_blank">Download →</a>
                </div>
            }

            @if (Model.CurrentMaterial?.ContentType == "text" && !string.IsNullOrEmpty(Model.CurrentMaterial?.ContentText))
            {
                <div class="text-content">
                    @Html.Raw(Model.CurrentMaterial.ContentText.Replace("\n", "<br />"))
                </div>
            }
        </div>

        <div class="preview-column">
            <div class="preview-card">
                <div class="preview-header">
                    @if (Model.CurrentMaterial?.ContentType == "file")
                    {
                        <span>📄 File Preview</span>
                    }
                    else if (Model.CurrentMaterial?.ContentType == "link")
                    {
                        <span>🔗 Link Preview</span>
                    }
                    else if (Model.CurrentMaterial?.ContentType == "text")
                    {
                        <span>📝 Content Preview</span>
                    }
                </div>
                <div class="preview-body">
                    @if (Model.CurrentMaterial?.ContentType == "link" && !string.IsNullOrEmpty(Model.CurrentMaterial?.ContentUrl))
                    {
                        if (Model.CurrentMaterial.ContentUrl.Contains("youtube.com") || Model.CurrentMaterial.ContentUrl.Contains("youtu.be"))
                        {
                            string videoId = "";
                            if (Model.CurrentMaterial.ContentUrl.Contains("youtube.com/watch"))
                            {
                                videoId = Model.CurrentMaterial.ContentUrl.Split(new[] { "v=" }, StringSplitOptions.None)[1]?.Split('&')[0] ?? "";
                            }
                            else
                            {
                                videoId = Model.CurrentMaterial.ContentUrl.Split('/').Last();
                            }
                            <iframe src="https://www.youtube.com/embed/@videoId" frameborder="0" allowfullscreen></iframe>
                        }
                        else if (Model.CurrentMaterial.ContentUrl.Contains("drive.google.com"))
                        {
                            var fileId = System.Text.RegularExpressions.Regex.Match(Model.CurrentMaterial.ContentUrl, @"/d/(.+?)/").Groups[1].Value;
                            <iframe src="https://drive.google.com/file/d/@fileId/preview" frameborder="0" allowfullscreen></iframe>
                        }
                        else
                        {
                            <a href="@Model.CurrentMaterial.ContentUrl" target="_blank" class="external-link">🔗 Open in New Tab</a>
                        }
                    }
                    else if (Model.CurrentMaterial?.ContentType == "file" && !string.IsNullOrEmpty(Model.CurrentMaterial?.FileURL))
                    {
                        var ext = System.IO.Path.GetExtension(Model.CurrentMaterial.FileURL).ToLower();
                        if (ext == ".pdf")
                        {
                            <iframe src="@Model.CurrentMaterial.FileURL" frameborder="0"></iframe>
                        }
                        else if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".gif")
                        {
                            <img src="@Model.CurrentMaterial.FileURL" alt="Preview" />
                        }
                        else
                        {
                            <div class="no-preview">No preview available for this file type.</div>
                        }
                    }
                    else if (Model.CurrentMaterial?.ContentType == "text" && !string.IsNullOrEmpty(Model.CurrentMaterial?.ContentText))
                    {
                        <div class="text-preview">
                            @Html.Raw(Model.CurrentMaterial.ContentText.Length > 500 ? Model.CurrentMaterial.ContentText.Substring(0, 500) + "..." : Model.CurrentMaterial.ContentText.Replace("\n", "<br />"))
                        </div>
                    }
                    else
                    {
                        <div class="no-preview">No preview available</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quizzes Section -->
    <div class="quizzes-section">
        <div class="quizzes-header">
            <h3>📝 Quizzes</h3>
            @if (isLecturer)
            {
                <a href="/FrontEnd/CreateNewQuiz?materialId=@Model.CurrentMaterial?.MaterialID" class="add-quiz-btn">+ Add Quiz</a>
            }
        </div>
        @if (Model.Quizzes != null && Model.Quizzes.Any())
        {
            <div class="quizzes-list">
                @foreach (var quiz in Model.Quizzes)
                {
                    var quizUrl = isLecturer ? $"/FrontEnd/ManageQuiz/{quiz.QuizID}" : $"/FrontEnd/ViewQuiz/{quiz.QuizID}";
                    <div class="quiz-item">
                        <span class="quiz-icon">📋</span>
                        <div class="quiz-info">
                            <a href="@quizUrl" class="quiz-title">@quiz.Title</a>
                        </div>
                        <a href="@quizUrl" class="take-quiz-link">@(isLecturer ? "Manage →" : "Take →")</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-quizzes">
                <span>📭</span>
                <p>No quizzes available</p>
            </div>
        }
    </div>
</div>

<form id="deleteForm" method="post" asp-page-handler="DeleteMaterial" style="display: none;">
    <input type="hidden" name="id" id="deleteMaterialId" />
</form>

<div id="deleteConfirmModal" class="delete-modal" style="display: none;">
    <div class="delete-modal-overlay"></div>
    <div class="delete-modal-container">
        <div class="delete-modal-content">
            <div class="delete-modal-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3>Confirm Delete</h3>
            <p>Are you sure you want to delete this teaching material?</p>
            <p id="deleteTitle" class="delete-title"></p>
            <p class="delete-warning">This action cannot be undone. The material will be moved to Removed status.</p>
            <div class="delete-modal-actions">
                <button type="button" class="delete-modal-btn cancel-btn" id="modalCancelBtn">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
                <button type="button" class="delete-modal-btn confirm-btn" id="modalConfirmBtn">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    let pendingDeleteId = null;
    let pendingDeleteModuleId = null;
    
    function openDeleteModal(button) {
        pendingDeleteId = button.getAttribute('data-id');
        pendingDeleteModuleId = button.getAttribute('data-module-id');
        const title = button.getAttribute('data-title');
        
        document.getElementById('deleteTitle').innerHTML = `<strong>"${title}"</strong>`;
        document.getElementById('deleteConfirmModal').style.display = 'flex';
    }
    
    function closeDeleteModal() {
        document.getElementById('deleteConfirmModal').style.display = 'none';
        pendingDeleteId = null;
        pendingDeleteModuleId = null;
    }
    
    function submitDelete() {
        if (pendingDeleteId) {
            document.getElementById('deleteMaterialId').value = pendingDeleteId;
            document.getElementById('deleteForm').submit();
        }
        closeDeleteModal();
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('modalCancelBtn')?.addEventListener('click', closeDeleteModal);
        document.getElementById('modalConfirmBtn')?.addEventListener('click', submitDelete);
        document.querySelector('.delete-modal-overlay')?.addEventListener('click', closeDeleteModal);
        
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('deleteConfirmModal');
                if (modal && modal.style.display === 'flex') {
                    closeDeleteModal();
                }
            }
        });
    });
</script>