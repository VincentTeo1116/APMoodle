@page
@model APMoodle.Pages.BackEnd.TestDBModel
@{
    ViewData["Title"] = "Database Connection";
}
<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/testdb.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<div class="teaching-material-page">

    <div class="page-header">
        <div class="header-left">
            <div id="horizontalNavbar">
                <h1>@ViewData["Title"] - APMoodle</h1>
                <p class="path">Admin Dashboard > @ViewData["Title"]</p>
            </div>
        </div>
    </div>
    
    <div class="main-content" style="padding-left: 30px; padding-right: 30px;">
        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">
                <strong>❌ Error:</strong> @Model.ErrorMessage
            </div>
        }
        else if (Model.ConnectionSuccessful)
        {
            <div class="alert alert-success">
                <strong><i class="bi bi-database-check"></i> Database Connected Successfully!</strong>
                <p>Your Supabase database is online and accessible.</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h4><i class="bi bi-bar-chart-steps"></i> Database Statistics</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Students Card -->
                        <div class="col-md-4">
                            <div class="stat-card students">
                                <div class="card-body">
                                    <div class="stat-icon">
                                        <i class="bi bi-people-fill"></i>
                                    </div>
                                    <div class="stat-title">Students</div>
                                    <div class="stat-number">@Model.StudentCount</div>
                                </div>
                            </div>
                        </div>

                        <!-- Lecturers Card -->
                        <div class="col-md-4">
                            <div class="stat-card lecturers">
                                <div class="card-body">
                                    <div class="stat-icon">
                                        <i class="bi bi-person-badge-fill"></i>
                                    </div>
                                    <div class="stat-title">Lecturers</div>
                                    <div class="stat-number">@Model.LecturerCount</div>
                                </div>
                            </div>
                        </div>

                        <!-- Modules Card -->
                        <div class="col-md-4">
                            <div class="stat-card modules">
                                <div class="card-body">
                                    <div class="stat-icon">
                                        <i class="bi bi-grid-3x3-gap-fill"></i>
                                    </div>
                                    <div class="stat-title">Modules</div>
                                    <div class="stat-number">@Model.ModuleCount</div>
                                </div>
                            </div>
                        </div>

                        <!-- Quizzes Card -->
                        <div class="col-md-4">
                            <div class="stat-card quizzes">
                                <div class="card-body">
                                    <div class="stat-icon">
                                        <i class="bi bi-question-circle-fill"></i>
                                    </div>
                                    <div class="stat-title">Quizzes</div>
                                    <div class="stat-number">@Model.QuizCount</div>
                                </div>
                            </div>
                        </div>

                        <!-- Questions Card -->
                        <div class="col-md-4">
                            <div class="stat-card questions">
                                <div class="card-body">
                                    <div class="stat-icon">
                                        <i class="bi bi-pencil-square"></i>
                                    </div>
                                    <div class="stat-title">Questions</div>
                                    <div class="stat-number">@Model.QuestionCount</div>
                                </div>
                            </div>
                        </div>

                        <!-- Announcements Card -->
                        <div class="col-md-4">
                            <div class="stat-card announcements">
                                <div class="card-body">
                                    <div class="stat-icon">
                                        <i class="bi bi-megaphone-fill"></i>
                                    </div>
                                    <div class="stat-title">Announcements</div>
                                    <div class="stat-number">@Model.AnnouncementCount</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <strong><i class="bi bi-database-exclamation"></i> Database connection check passed but no data found.</strong>
            </div>
        }

        <div class="mt-3">
            <a href="/FrontEnd/AdminDashboard" class="btn btn-primary">
                <i class="bi bi-house"></i> Back to Home
            </a>
            <a href="/FrontEnd/TestDB" class="btn btn-secondary">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </a>
        </div>
    </div>
</div>