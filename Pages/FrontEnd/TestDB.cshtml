@page
@model APMoodle.Pages.BackEnd.TestDBModel
@{
    ViewData["Title"] = "Database Connection Test";
}

<div id="horizontalNavbar" class="container">
    <h1>Database Connection Test</h1>
    <hr />

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <strong>❌ Error:</strong> @Model.ErrorMessage
        </div>
    }
    else if (Model.ConnectionSuccessful)
    {
        <div class="alert alert-success">
            <strong>✅ Database Connected Successfully!</strong>
            <p>Your Supabase database is online and accessible.</p>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h4>Database Statistics</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="card bg-info text-white mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Students</h5>
                                <h2>@Model.StudentCount</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-success text-white mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Lecturers</h5>
                                <h2>@Model.LecturerCount</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-warning text-white mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Modules</h5>
                                <h2>@Model.ModuleCount</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-secondary text-white mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Quizzes</h5>
                                <h2>@Model.QuizCount</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-dark text-white mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Questions</h5>
                                <h2>@Model.QuestionCount</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-danger text-white mb-3">
                            <div class="card-body">
                                <h5 class="card-title">Announcements</h5>
                                <h2>@Model.AnnouncementCount</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <strong>⚠️ Database connection check passed but no data found.</strong>
        </div>
    }

    <div class="mt-3">
        <a href="/FrontEnd/Index" class="btn btn-primary">Back to Home</a>
        <a href="/FrontEnd/TestDB" class="btn btn-secondary">Refresh</a>
    </div>
</div>