@page
@model APMoodle.Pages.BackEnd.TestDBModel
@{
    ViewData["Title"] = "Database Connection";
}

<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/testdb.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<div class="database-page">
    <div class="database-header-section">
        <h1><i class="bi bi-database"></i> Database Connection</h1>
        <p class="database-subtitle">Check database status and explore table data</p>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <strong><i class="bi bi-exclamation-triangle-fill"></i> Error:</strong> @Model.ErrorMessage
        </div>
    }
    else if (Model.ConnectionSuccessful)
    {
        <div class="alert alert-success">
            <strong><i class="bi bi-database-check"></i> Database Connected Successfully!</strong>
            <p>Your Supabase database is online and accessible.</p>
        </div>

        <div class="database-stats-grid">
            <div class="database-stat-card" data-table="Students">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-number">@Model.StudentCount</div>
                <div class="stat-label">Students</div>
            </div>
            <div class="database-stat-card" data-table="Lecturers">
                <div class="stat-icon"><i class="bi bi-person-badge-fill"></i></div>
                <div class="stat-number">@Model.LecturerCount</div>
                <div class="stat-label">Lecturers</div>
            </div>
            <div class="database-stat-card" data-table="Admins">
                <div class="stat-icon"><i class="bi bi-person-gear"></i></div>
                <div class="stat-number">@Model.AdminCount</div>
                <div class="stat-label">Admins</div>
            </div>
            <div class="database-stat-card" data-table="Modules">
                <div class="stat-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
                <div class="stat-number">@Model.ModuleCount</div>
                <div class="stat-label">Modules</div>
            </div>
            <div class="database-stat-card" data-table="Materials">
                <div class="stat-icon"><i class="bi bi-file-earmark-text"></i></div>
                <div class="stat-number">@Model.MaterialCount</div>
                <div class="stat-label">Materials</div>
            </div>
            <div class="database-stat-card" data-table="Quizzes">
                <div class="stat-icon"><i class="bi bi-question-circle-fill"></i></div>
                <div class="stat-number">@Model.QuizCount</div>
                <div class="stat-label">Quizzes</div>
            </div>
            <div class="database-stat-card" data-table="Questions">
                <div class="stat-icon"><i class="bi bi-pencil-square"></i></div>
                <div class="stat-number">@Model.QuestionCount</div>
                <div class="stat-label">Questions</div>
            </div>
            <div class="database-stat-card" data-table="Announcements">
                <div class="stat-icon"><i class="bi bi-megaphone-fill"></i></div>
                <div class="stat-number">@Model.AnnouncementCount</div>
                <div class="stat-label">Announcements</div>
            </div>
        </div>

        <div class="database-actions">
            <a href="/FrontEnd/AdminDashboard" class="btn btn-primary">
                <i class="bi bi-house"></i> Back to Home
            </a>
            <a href="/FrontEnd/TestDB" class="btn btn-secondary">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <strong><i class="bi bi-database-exclamation"></i> Database connection check passed but no data found.</strong>
        </div>
    }
</div>

<div id="terminalModal" class="terminal-modal">
    <div class="terminal-modal-content">
        <div class="terminal-modal-header">
            <div class="terminal-modal-title">
                <i class="bi bi-terminal"></i>
                <h3 id="modalTitle">SQL Query</h3>
            </div>
            <span class="terminal-modal-close" id="terminalModalClose">&times;</span>
        </div>
        <div class="terminal-modal-body" id="terminalOutput">
            <span class="sql-comment">⏳ Click a card to load data...</span>
        </div>
        <div class="terminal-modal-footer">
            <button class="btn btn-secondary" id="terminalCloseBtn">Close</button>
        </div>
    </div>
</div>

<script src="~/js/testdb.js" asp-append-version="true"></script>