@page
@model APMoodle.Pages.BackEnd.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}

<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/login.css" />
</head>

<div class="login-wrapper">

    <!-- LEFT SIDE -->
    <div class="login-left">
        <div class="logo-box">
            <img src="~/images/logo.png" alt="Logo" />
        </div>
    </div>

    <!-- RIGHT SIDE -->
    <div class="login-right">

        <!-- Toggle -->
        <div class="toggle-box">
            <button type="button" class="active" id="loginTab">Login</button>
            <button type="button" id="registerTab">Register</button>
        </div>

        <h2>WELCOME BACK !</h2>

        <form method="post">

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert-error">
                    ❌ @Model.Message
                </div>
            }

            <label>User ID or Email</label>
            <input type="text" name="Input.UserId" placeholder="Enter User ID or Email" required />

            <label>Password</label>
            <div class="password-box">
                <input type="password" name="Input.Password" id="password" placeholder="Enter Password" required />
                <span class="eye" onclick="togglePassword()">👁️</span>
            </div>

            <div class="forgot">
                <a href="/FrontEnd/ForgotPassword">FORGOT PASSWORD?</a>
            </div>

            <button type="submit" class="btn-login">SIGN IN</button>

        </form>

        <div class="register-text">
            DON’T HAVE ACCOUNT YET ?
            <a href="/FrontEnd/Register">JOIN US NOW !</a>
        </div>

    </div>

</div>

<script src="~/js/login.js"></script>