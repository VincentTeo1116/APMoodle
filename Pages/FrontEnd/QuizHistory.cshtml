@page
@model APMoodle.Pages.BackEnd.QuizHistoryModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quiz History";

    var sessions = Model.Sessions;
    var attempts = sessions.Count;
    var scored = sessions.Where(s => s.TotalScore.HasValue).ToList();
    var avg = scored.Any() ? (int)System.Math.Round(scored.Average(s => s.TotalScore!.Value)) : 0;
    var best = scored.Any() ? scored.Max(s => s.TotalScore!.Value) : 0;
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/css/quizHistory.css" />
</head>

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
    </div>

    <div class="PageComponent">
        <div class="qh-page">
            @if (attempts > 0)
            {
                <div class="qh-stats">
                    <div class="qh-stat">
                        <div class="qh-stat-ico qh-ico-attempts"><i class="fas fa-list-check"></i></div>
                        <div>
                            <div class="qh-stat-val">@attempts</div>
                            <div class="qh-stat-lbl">Total Attempts</div>
                        </div>
                    </div>
                    <div class="qh-stat">
                        <div class="qh-stat-ico qh-ico-avg"><i class="fas fa-chart-line"></i></div>
                        <div>
                            <div class="qh-stat-val">@avg<span>%</span></div>
                            <div class="qh-stat-lbl">Average Score</div>
                        </div>
                    </div>
                    <div class="qh-stat">
                        <div class="qh-stat-ico qh-ico-best"><i class="fas fa-trophy"></i></div>
                        <div>
                            <div class="qh-stat-val">@best<span>%</span></div>
                            <div class="qh-stat-lbl">Best Score</div>
                        </div>
                    </div>
                </div>

                <div class="qh-list-head">
                    <h3><i class="fas fa-clock-rotate-left"></i> Your Attempts</h3>
                    <span class="qh-list-sub">Newest first</span>
                </div>

                <div class="qh-list">
                    @foreach (var s in sessions)
                    {
                        var sc = s.TotalScore ?? -1;
                        var b = sc < 0 ? "none"
                            : sc >= 80 ? "good"
                            : sc >= 60 ? "ok"
                            : sc >= 40 ? "low"
                            : "bad";
                        <a class="qh-item qh-band-@b" href="/FrontEnd/QuizResult/@s.SessionID">
                            <div class="qh-score">
                                <span class="qh-score-val">@(s.TotalScore.HasValue ? s.TotalScore.ToString() : "—")</span>
                                @if (s.TotalScore.HasValue)
                                {
                                    <span class="qh-score-pct">%</span>
                                }
                            </div>
                            <div class="qh-info">
                                <div class="qh-title">@(s.Quiz?.Title ?? "Quiz")</div>
                                <div class="qh-meta">
                                    @if (!string.IsNullOrWhiteSpace(s.Quiz?.Subject))
                                    {
                                        <span class="qh-chip"><i class="fas fa-book"></i> @s.Quiz!.Subject</span>
                                    }
                                    <span class="qh-date"><i class="far fa-clock"></i> @s.Timestamp.ToLocalTime().ToString("dd MMM yyyy • hh:mm tt")</span>
                                </div>
                            </div>
                            <div class="qh-go">
                                <span>View</span>
                                <i class="fas fa-chevron-right"></i>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="qh-empty">
                    <i class="fas fa-clipboard-question"></i>
                    <p>You haven't attempted any quizzes yet.</p>
                    <a class="qh-btn qh-btn-primary" href="/FrontEnd/ModuleOverview">
                        <i class="fas fa-layer-group"></i> Browse Modules
                    </a>
                </div>
            }
        </div>
    </div>
</div>


