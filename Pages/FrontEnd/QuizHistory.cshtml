@page
@model APMoodle.Pages.BackEnd.QuizHistoryModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quiz History";

    var sessions = Model.Sessions;
    var attempts = sessions.Count;
    var scored = sessions.Where(s => s.TotalScore.HasValue).ToList();
    var avg = scored.Any() ? (int)System.Math.Round(scored.Average(s => s.TotalScore!.Value)) : 0;
    var best = scored.Any() ? scored.Max(s => s.TotalScore!.Value) : 0;
}

@*
    Front-end / styling: Moses — matches the APMoodle dashboard design system (dashboard.css tokens).
    Backend contract:
        Model.Sessions — completed Session list, newest first
            .SessionID, .TotalScore (int?), .Timestamp, .Quiz?.Title, .Quiz?.Subject, .Quiz?.Theme
        Each card links to /FrontEnd/QuizResult/{SessionID}.
*@

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
</head>

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
    </div>

    <div class="PageComponent">
        <div class="qh-page">
            @if (attempts > 0)
            {
                <!-- ===== Summary stats ===== -->
                <div class="qh-stats">
                    <div class="qh-stat">
                        <div class="qh-stat-ico qh-ico-attempts"><i class="fas fa-list-check"></i></div>
                        <div>
                            <div class="qh-stat-val">@attempts</div>
                            <div class="qh-stat-lbl">Total Attempts</div>
                        </div>
                    </div>
                    <div class="qh-stat">
                        <div class="qh-stat-ico qh-ico-avg"><i class="fas fa-chart-line"></i></div>
                        <div>
                            <div class="qh-stat-val">@avg<span>%</span></div>
                            <div class="qh-stat-lbl">Average Score</div>
                        </div>
                    </div>
                    <div class="qh-stat">
                        <div class="qh-stat-ico qh-ico-best"><i class="fas fa-trophy"></i></div>
                        <div>
                            <div class="qh-stat-val">@best<span>%</span></div>
                            <div class="qh-stat-lbl">Best Score</div>
                        </div>
                    </div>
                </div>

                <!-- ===== Attempts list ===== -->
                <div class="qh-list-head">
                    <h3><i class="fas fa-clock-rotate-left"></i> Your Attempts</h3>
                    <span class="qh-list-sub">Newest first</span>
                </div>

                <div class="qh-list">
                    @foreach (var s in sessions)
                    {
                        var sc = s.TotalScore ?? -1;
                        var b = sc < 0 ? "none"
                            : sc >= 80 ? "good"
                            : sc >= 60 ? "ok"
                            : sc >= 40 ? "low"
                            : "bad";
                        <a class="qh-item qh-band-@b" href="/FrontEnd/QuizResult/@s.SessionID">
                            <div class="qh-score">
                                <span class="qh-score-val">@(s.TotalScore.HasValue ? s.TotalScore.ToString() : "—")</span>
                                @if (s.TotalScore.HasValue)
                                {
                                    <span class="qh-score-pct">%</span>
                                }
                            </div>
                            <div class="qh-info">
                                <div class="qh-title">@(s.Quiz?.Title ?? "Quiz")</div>
                                <div class="qh-meta">
                                    @if (!string.IsNullOrWhiteSpace(s.Quiz?.Subject))
                                    {
                                        <span class="qh-chip"><i class="fas fa-book"></i> @s.Quiz!.Subject</span>
                                    }
                                    <span class="qh-date"><i class="far fa-clock"></i> @s.Timestamp.ToLocalTime().ToString("dd MMM yyyy • hh:mm tt")</span>
                                </div>
                            </div>
                            <div class="qh-go">
                                <span>View</span>
                                <i class="fas fa-chevron-right"></i>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="qh-empty">
                    <i class="fas fa-clipboard-question"></i>
                    <p>You haven't attempted any quizzes yet.</p>
                    <a class="qh-btn qh-btn-primary" href="/FrontEnd/ModuleOverview">
                        <i class="fas fa-layer-group"></i> Browse Modules
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== APMoodle Quiz History — design tokens mirror dashboard.css ===== */

    /* Center the page title to match the result screen */
    #horizontalNavbar > .PageTitle { text-align: center; }
    #horizontalNavbar > .PageTitle h1 { display: inline-block; }

    .qh-page {
        --primary: #4f46e5;
        --primary-light: #818cf8;
        --dark: #1f2937;
        --gray: #6b7280;
        --gray-light: #9ca3af;
        --line: #e5e7eb;
        --light: #f9fafb;
        font-family: 'Inter', system-ui, sans-serif;
        max-width: 920px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 3rem;
        color: var(--dark);
    }

    /* ---- Summary stats ---- */
    .qh-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2rem; }
    @@media (max-width: 640px) { .qh-stats { grid-template-columns: 1fr; } }
    .qh-stat {
        display: flex; align-items: center; gap: 1rem;
        background: #fff; border-radius: 1.25rem; padding: 1.25rem 1.4rem;
        box-shadow: 0 6px 18px rgba(31, 41, 55, .07);
        position: relative; overflow: hidden;
        animation: qhFade .4s ease both;
    }
    .qh-stat::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 4px; background: linear-gradient(90deg, var(--primary), var(--primary-light)); }
    .qh-stat-ico { width: 3rem; height: 3rem; flex-shrink: 0; border-radius: .9rem; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.3rem; }
    .qh-ico-attempts { background: linear-gradient(135deg, #6366f1, #818cf8); }
    .qh-ico-avg { background: linear-gradient(135deg, #0ea5e9, #38bdf8); }
    .qh-ico-best { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
    .qh-stat-val { font-size: 1.75rem; font-weight: 800; line-height: 1; color: var(--dark); }
    .qh-stat-val span { font-size: 1rem; color: var(--gray-light); font-weight: 700; }
    .qh-stat-lbl { font-size: .72rem; color: var(--gray-light); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; margin-top: .35rem; }

    /* ---- List header ---- */
    .qh-list-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 0 .25rem 1rem; }
    .qh-list-head h3 { font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: .55rem; margin: 0; }
    .qh-list-head h3 i { color: var(--primary); }
    .qh-list-sub { font-size: .8rem; color: var(--gray-light); font-weight: 600; }

    /* ---- Attempt cards ---- */
    .qh-list { display: flex; flex-direction: column; gap: .85rem; }
    .qh-item {
        display: flex; align-items: center; gap: 1.1rem;
        background: #fff; border-radius: 1rem; padding: 1rem 1.25rem;
        box-shadow: 0 4px 14px rgba(31, 41, 55, .06);
        border-left: 5px solid var(--line);
        text-decoration: none; color: inherit;
        transition: transform .16s, box-shadow .16s;
        animation: qhFade .4s ease both;
    }
    .qh-item:hover { transform: translateX(4px); box-shadow: 0 8px 22px rgba(31, 41, 55, .12); }

    .qh-band-good { border-left-color: #10b981; }
    .qh-band-ok   { border-left-color: #f59e0b; }
    .qh-band-low  { border-left-color: #f97316; }
    .qh-band-bad  { border-left-color: #ef4444; }
    .qh-band-none { border-left-color: var(--gray-light); }

    .qh-score {
        flex-shrink: 0; width: 3.6rem; height: 3.6rem; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 800; line-height: 1;
        box-shadow: 0 4px 12px rgba(0, 0, 0, .12);
    }
    .qh-band-good .qh-score { background: linear-gradient(135deg, #10b981, #34d399); }
    .qh-band-ok   .qh-score { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
    .qh-band-low  .qh-score { background: linear-gradient(135deg, #f97316, #fb923c); }
    .qh-band-bad  .qh-score { background: linear-gradient(135deg, #ef4444, #f87171); }
    .qh-band-none .qh-score { background: linear-gradient(135deg, #9ca3af, #d1d5db); }
    .qh-score-val { font-size: 1.15rem; }
    .qh-score-pct { font-size: .7rem; font-weight: 700; margin-left: 1px; }

    .qh-info { flex: 1; min-width: 0; }
    .qh-title { font-size: 1.02rem; font-weight: 700; color: var(--dark); margin-bottom: .3rem; }
    .qh-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .8rem; }
    .qh-chip { display: inline-flex; align-items: center; gap: .35rem; font-size: .72rem; font-weight: 600; color: var(--primary); background: #eef2ff; padding: .22rem .6rem; border-radius: 999px; }
    .qh-date { display: inline-flex; align-items: center; gap: .35rem; font-size: .76rem; color: var(--gray-light); }

    .qh-go { flex-shrink: 0; display: inline-flex; align-items: center; gap: .4rem; font-size: .82rem; font-weight: 700; color: var(--gray-light); transition: color .16s, gap .16s; }
    .qh-item:hover .qh-go { color: var(--primary); gap: .6rem; }

    /* ---- Empty state ---- */
    .qh-empty { text-align: center; padding: 4rem 1rem; color: var(--gray-light); }
    .qh-empty i { font-size: 3rem; opacity: .5; margin-bottom: 1rem; display: block; }
    .qh-empty p { margin-bottom: 1.5rem; font-size: .95rem; }
    .qh-btn { display: inline-flex; align-items: center; gap: .55rem; padding: .8rem 1.5rem; border-radius: .85rem; font-weight: 700; font-size: .9rem; text-decoration: none; transition: all .18s; }
    .qh-btn-primary { background: linear-gradient(135deg, var(--primary), var(--primary-light)); color: #fff; box-shadow: 0 6px 18px rgba(79, 70, 229, .35); }
    .qh-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 9px 24px rgba(79, 70, 229, .45); color: #fff; }

    @@keyframes qhFade { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
</style>
