@page
@model APMoodle.Pages.BackEnd.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/forgotPassword.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <div class="login-wrapper">

        <div class="login-left">
            <div class="logo-particles" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
            </div>
            <div class="logo-stage">
                <div class="logo-orbit" aria-hidden="true"></div>
                <div class="logo-orbit-inner" aria-hidden="true"></div>
                <div class="logo-sparkles" aria-hidden="true">
                    <span></span><span></span><span></span>
                    <span></span><span></span><span></span>
                </div>
                <svg class="logo-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" role="img"
                     aria-label="APMoodle logo">
                    <g class="tassel-group">
                        <path class="draw tassel-line" d="M150 60 L150 95" />
                        <circle class="fill-tassel-bead" cx="150" cy="100" r="6" fill="#f5ebdc" />
                    </g>
                    <path class="draw" d="M100 50 L170 80 L100 110 L30 80 Z" />
                    <path class="fill-cap" d="M100 50 L170 80 L100 110 L30 80 Z" fill="#f5ebdc" />
                    <path class="draw s2" d="M40 90 L40 120 Q70 140 100 130 Q130 140 160 120 L160 90" />
                    <path class="draw s3"
                          d="M30 135 Q65 155 100 145 Q135 155 170 135 L170 165 Q135 180 100 170 Q65 180 30 165 Z" />
                    <path class="fill-book-left" d="M30 140 Q65 158 100 148 L100 170 Q65 180 30 165 Z" fill="#f5ebdc"
                          opacity="0.9" />
                    <path class="fill-book-right" d="M170 140 Q135 158 100 148 L100 170 Q135 180 170 165 Z" fill="#f5ebdc"
                          opacity="0.75" />
                </svg>
                <div class="logo-wordmark">
                    APMoodle
                    <span class="tag">LEARN · TEACH · GROW</span>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDE – FORGOT PASSWORD -->
        <div class="login-right">
            <h2><i class="bi bi-key"></i></h2>
            <h2>Forgot Password</h2>
            <p class="subtitle">Reset your password in a few steps</p>

            <div class="step-indicator" id="stepIndicator">
                <span class="step-dot active" id="dot1"></span>
                <span class="step-dot" id="dot2"></span>
                <span class="step-dot" id="dot3"></span>
            </div>

            <!-- Message area -->
            <div id="messageArea">
                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <div class="alert @(Model.IsSuccess ? "alert-success" : (Model.IsOtpSent ? "alert-info" : "alert-danger"))">
                        <i class="bi @(Model.IsSuccess ? "bi-check-circle" : (Model.IsOtpSent ? "bi-info-circle" : "bi-exclamation-triangle"))"></i>
                        @Model.Message
                    </div>
                }
            </div>

            <div id="step1">
                <form method="post" asp-page-handler="SendOtp" id="sendOtpForm">
                    <div class="form-group">
                        <label for="Input.Email">Email Address</label>
                        <input type="email" id="Input.Email" name="Input.Email" value="@Model.Input.Email"
                               placeholder="your@email.com" required />
                        @Html.ValidationMessageFor(m => m.Input.Email, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <div class="g-recaptcha" data-sitekey="@ViewData["RecaptchaSiteKey"]"></div>
                    </div>
                    <button type="submit" class="btn-primary">Send OTP</button>
                </form>
            </div>

            <div id="step2" style="display: none;">
                <div class="form-group">
                    <label for="otpInput">Enter OTP</label>
                    <div class="otp-row">
                        <input type="text" id="otpInput" placeholder="6-digit code" maxlength="6" />
                        <button type="button" class="btn-resend" id="resendBtn">Resend</button>
                    </div>
                    <small class="text-muted">Enter the 6-digit code sent to your email.</small>
                </div>
                <button type="button" class="btn-primary" id="verifyOtpBtn">Verify OTP</button>
                <div id="otpError" class="alert alert-danger" style="display:none; margin-top:12px;"></div>
            </div>

            <div id="step3" style="display: none;">
                <form method="post" asp-page-handler="ResetPassword" id="resetForm">
                    <input type="hidden" name="Input.Email" value="@Model.Email" />
                    <input type="hidden" name="Input.Otp" id="hiddenOtp" />
                    <div class="form-group">
                        <label for="Input.NewPassword">New Password</label>
                        <input type="password" id="Input.NewPassword" name="Input.NewPassword"
                               placeholder="Min 6 characters" required />
                        @Html.ValidationMessageFor(m => m.Input.NewPassword, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group">
                        <label for="Input.ConfirmPassword">Confirm Password</label>
                        <input type="password" id="Input.ConfirmPassword" name="Input.ConfirmPassword"
                               placeholder="Confirm new password" required />
                        @Html.ValidationMessageFor(m => m.Input.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>
                    <button type="submit" class="btn-primary">Reset Password</button>
                </form>
            </div>

            <div class="text-center">
                <a href="/FrontEnd/Login" class="back-link"><i class="bi bi-arrow-left"></i> Back to Login</a>
            </div>

        </div>
    </div>

    <!-- Success Popup -->
    <div id="successPopup" style="display: none;">
        <div>
            <i class="bi bi-check-circle-fill"></i>
            <h2>Success!</h2>
            <p id="successMessage">Your password has been reset successfully!</p>
            <button id="popupContinueBtn">Continue</button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://www.google.com/recaptcha/api.js?hl=en" async defer></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Show popup if success
            @if (Model.IsSuccess)
            {
                <text>showSuccessPopup('@Model.Message');</text>
            }

            // If OTP was sent, move to step 2
            @if (Model.IsOtpSent && !Model.IsSuccess)
            {
                <text>goToStep(2);</text>
            }
        });

        // Step navigation
        function goToStep(step) {
            document.getElementById('step1').style.display = step === 1 ? 'block' : 'none';
            document.getElementById('step2').style.display = step === 2 ? 'block' : 'none';
            document.getElementById('step3').style.display = step === 3 ? 'block' : 'none';

            // Update dots
            for (let i = 1; i <= 3; i++) {
                const dot = document.getElementById('dot' + i);
                dot.className = 'step-dot';
                if (i < step) dot.classList.add('done');
                else if (i === step) dot.classList.add('active');
            }
        }

        // Verify OTP via AJAX
        document.getElementById('verifyOtpBtn').addEventListener('click', function () {
            const otp = document.getElementById('otpInput').value.trim();
            if (otp.length !== 6) {
                showOtpError('Please enter a valid 6-digit OTP.');
                return;
            }

            const email = document.querySelector('input[name="Input.Email"]').value;
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : null;

            fetch('?handler=VerifyOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { 'RequestVerificationToken': token } : {})
                },
                body: JSON.stringify({ email, otp })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('hiddenOtp').value = otp;
                    goToStep(3);
                } else {
                    showOtpError(data.message || 'Invalid OTP. Please try again.');
                }
            })
            .catch(err => {
                showOtpError('An error occurred. Please try again.');
                console.error(err);
            });
        });

        function showOtpError(msg) {
            const errDiv = document.getElementById('otpError');
            errDiv.textContent = msg;
            errDiv.style.display = 'block';
        }

        // Resend OTP
        document.getElementById('resendBtn').addEventListener('click', function () {
            const email = document.querySelector('input[name="Input.Email"]').value;
            if (!email) {
                alert('Email address is missing. Please go back to step 1.');
                return;
            }
            // Submit the send OTP form via fetch
            const form = document.getElementById('sendOtpForm');
            const formData = new FormData(form);
            fetch('?handler=SendOtp', {
                method: 'POST',
                body: formData
            })
            .then(response => response.text())
            .then(html => {
                // Reload page to reflect new OTP sent message
                window.location.reload();
            })
            .catch(err => alert('Failed to resend OTP.'));
        });

        // Success popup functions
        function showSuccessPopup(message) {
            const popup = document.getElementById('successPopup');
            const msgEl = document.getElementById('successMessage');
            if (message) msgEl.textContent = message;
            if (popup) {
                popup.style.display = 'flex';
                setTimeout(() => {
                    window.location.href = '/FrontEnd/Login';
                }, 5000);
            }
        }

        document.getElementById('popupContinueBtn').addEventListener('click', function () {
            window.location.href = '/FrontEnd/Login';
        });
    </script>

</body>
</html>