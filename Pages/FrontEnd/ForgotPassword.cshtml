@page
@model APMoodle.Pages.BackEnd.ForgotPasswordModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .forgot-container {
            max-width: 480px;
            margin: 0 auto;
            padding: 30px 20px;
        }

        .forgot-card {
            background: white;
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e9edf2;
        }

        .forgot-card h2 {
            color: #1e293b;
            margin-bottom: 8px;
        }

        .forgot-card .subtitle {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            color: #1e293b;
            margin-bottom: 6px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            font-size: 14px;
            transition: 0.2s;
        }

        .form-group input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
            outline: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            width: 100%;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59,130,246,0.3);
        }

        .btn-secondary {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 600;
            width: 100%;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 10px;
        }

        .btn-secondary:hover {
            background: #e2e8f0;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-success {
            background: #d1fae5;
            color: #065f46;
            border-left: 4px solid #10b981;
        }

        .alert-danger {
            background: #fee2e2;
            color: #991b1b;
            border-left: 4px solid #ef4444;
        }

        .alert-info {
            background: #dbeafe;
            color: #1e40af;
            border-left: 4px solid #3b82f6;
        }

        .step-indicator {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .step-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #e2e8f0;
            transition: 0.3s;
        }

        .step-dot.active {
            background: #3b82f6;
            width: 30px;
            border-radius: 10px;
        }

        .step-dot.done {
            background: #10b981;
        }

        .otp-row {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .otp-row input {
            flex: 1;
        }

        .otp-row .btn-resend {
            background: none;
            border: none;
            color: #3b82f6;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            padding: 12px 0;
        }

        .otp-row .btn-resend:hover {
            text-decoration: underline;
        }

        .mt-3 {
            margin-top: 20px;
        }

        .text-center {
            text-align: center;
        }

        .back-link {
            display: inline-block;
            margin-top: 16px;
            color: #64748b;
            text-decoration: none;
            font-size: 14px;
        }

        .back-link:hover {
            color: #1e293b;
            text-decoration: underline;
        }
    </style>
</head>

<div class="forgot-container">
    <div class="forgot-card">
        <h2><i class="bi bi-key"></i> Forgot Password</h2>
        <p class="subtitle">Enter your email to receive a one-time password (OTP).</p>

        <!-- Step Indicator -->
        <div class="step-indicator">
            <span class="step-dot @(Model.IsOtpSent ? "done" : "active")"></span>
            <span class="step-dot @(Model.IsOtpSent ? "active" : "")"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert @(Model.IsSuccess ? "alert-success" : (Model.IsOtpSent ? "alert-info" : "alert-danger"))">
                <i class="bi @(Model.IsSuccess ? "bi-check-circle" : (Model.IsOtpSent ? "bi-info-circle" : "bi-exclamation-triangle"))"></i>
                @Model.Message
            </div>
        }

        @if (!Model.IsOtpSent)
        {
            <!-- Step 1: Request OTP -->
            <form method="post" asp-page-handler="SendOtp">
                <div class="form-group">
                    <label for="Input.Email">Email Address</label>
                    <input type="email" id="Input.Email" name="Input.Email" value="@Model.Input.Email" placeholder="your@email.com" required />
                    @Html.ValidationMessageFor(m => m.Input.Email, "", new { @class = "text-danger" })
                </div>

                <!-- reCAPTCHA (optional) -->
                <div class="form-group">
                    <div class="g-recaptcha" data-sitekey="@ViewData["RecaptchaSiteKey"]"></div>
                </div>

                <button type="submit" class="btn-primary">Send OTP</button>
            </form>
        }
        else if (!Model.IsSuccess)
        {
            <!-- Step 2: Verify OTP and Reset Password -->
            <form method="post" asp-page-handler="ResetPassword">
                <input type="hidden" name="Input.Email" value="@Model.Email" />
                <div class="form-group">
                    <label for="Input.Otp">OTP</label>
                    <div class="otp-row">
                        <input type="text" id="Input.Otp" name="Input.Otp" placeholder="6-digit code" maxlength="6" required />
                        <button type="submit" class="btn-resend" formnovalidate>Resend</button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Input.Otp, "", new { @class = "text-danger" })
                    <small class="text-muted">Enter the 6-digit code sent to your email.</small>
                </div>

                <div class="form-group">
                    <label for="Input.NewPassword">New Password</label>
                    <input type="password" id="Input.NewPassword" name="Input.NewPassword" placeholder="Min 6 characters" required />
                    @Html.ValidationMessageFor(m => m.Input.NewPassword, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label for="Input.ConfirmPassword">Confirm Password</label>
                    <input type="password" id="Input.ConfirmPassword" name="Input.ConfirmPassword" placeholder="Confirm new password" required />
                    @Html.ValidationMessageFor(m => m.Input.ConfirmPassword, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn-primary">Reset Password</button>
            </form>
        }
        else
        {
            <!-- Success: Password reset -->
            <div class="text-center">
                <i class="bi bi-check-circle-fill" style="font-size: 64px; color: #10b981;"></i>
                <p style="font-size: 16px; color: #1e293b; margin-top: 16px;">Your password has been reset!</p>
                <a href="/FrontEnd/Login" class="btn-primary" style="display: inline-block; text-decoration: none; text-align: center; margin-top: 12px;">Go to Login</a>
            </div>
        }

        <div class="text-center">
            <a href="/FrontEnd/Login" class="back-link"><i class="bi bi-arrow-left"></i> Back to Login</a>
        </div>
    </div>
</div>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}