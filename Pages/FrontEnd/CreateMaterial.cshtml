@page
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}
@model APMoodle.Pages.BackEnd.CreateMaterialModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Teaching Material";
}

<link rel="stylesheet" href="~/css/materialCreation.css" />
<br />
<br />
<br />
<div class="material-create-container">
    <div class="form-card">
        <div class="form-header">
            <h2>📚 Add Teaching Material</h2>
        </div>
        
        <form id="materialForm" enctype="multipart/form-data">
            <input type="hidden" name="moduleId" value="@Model.ModuleId" />
            
            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" required placeholder="e.g., Lecture 1: Introduction" />
            </div>
            
            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="3" placeholder="Brief description..."></textarea>
            </div>
            
            <div class="form-group">
                <label>Content Type</label>
                <div class="type-selector">
                    <button type="button" id="fileTypeBtn" class="type-btn active">📁 File</button>
                    <button type="button" id="linkTypeBtn" class="type-btn">🔗 Link/URL</button>
                    <button type="button" id="textTypeBtn" class="type-btn">📝 Text</button>
                </div>
            </div>
            
            <!-- File Upload Section -->
            <div id="fileSection" class="content-section">
                <div class="drop-zone" id="dropZone">
                    <div class="drop-zone-icon">📁</div>
                    <p class="drop-zone-text">Drag & drop your file here</p>
                    <p class="drop-zone-subtext">or click to browse</p>
                    <input type="file" id="fileInput" name="file" style="display: none;" />
                </div>
                <div class="file-preview" id="filePreview" style="display: none;">
                    <div class="file-preview-icon" id="previewIcon">📄</div>
                    <div class="file-preview-info">
                        <span class="file-preview-name" id="previewName"></span>
                        <span class="file-preview-size" id="previewSize"></span>
                    </div>
                    <button type="button" class="file-preview-remove" onclick="clearFile()">✖</button>
                </div>
            </div>
            
            <!-- Link/URL Section -->
            <div id="linkSection" class="content-section" style="display: none;">
                <div class="form-group">
                    <label for="contentUrl">URL (YouTube, Google Drive, Website)</label>
                    <input type="url" id="contentUrl" name="contentUrl" placeholder="https://www.youtube.com/watch?v=... or any URL" />
                </div>
                <div id="urlPreview" class="url-preview" style="display: none;">
                    <div class="preview-header">
                        <span>🔍 Preview</span>
                        <button type="button" onclick="clearUrl()">✖</button>
                    </div>
                    <div id="previewContent" class="preview-content"></div>
                </div>
            </div>
            
            <!-- Text Section -->
            <div id="textSection" class="content-section" style="display: none;">
                <div class="form-group">
                    <label for="contentText">Text Content</label>
                    <textarea id="contentText" name="contentText" rows="10" placeholder="Enter your content here..."></textarea>
                </div>
            </div>
            
            <div class="form-actions">
                <a href="/FrontEnd/TeachingMaterial/@Model.ModuleId" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">📤 Upload</button>
            </div>
        </form>
    </div>
</div>

<script src="~/js/createMaterial.js"></script>