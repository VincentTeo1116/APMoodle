@page
@model APMoodle.Pages.BackEnd.AddAnnouncementModel
@{
    ViewData["Title"] = "Add Announcement";
}

<head>
    <link rel="stylesheet" href="~/css/addAnnouncement.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<div class="announcement-page">
    <!-- Header Section -->
    <div class="announcement-header-section">
        <h1>Create Announcement</h1>
        <p class="announcement-subtitle">Create a new announcement for your users</p>
    </div>

    <!-- Display Error Messages only -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-error">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <!-- Progress Bar -->
    <div class="progress-container">
        <div class="progress-steps">
            <div class="step active" id="step1">
                <div class="step-circle">1</div>
                <div class="step-label">Details</div>
            </div>
            <div class="step-line"></div>
            <div class="step" id="step2">
                <div class="step-circle">2</div>
                <div class="step-label">Review</div>
            </div>
            <div class="step-line"></div>
            <div class="step" id="step3">
                <div class="step-circle">3</div>
                <div class="step-label">Publish</div>
            </div>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" id="progressFill" style="width: 33%;"></div>
        </div>
    </div>

    <!-- Step 1: Title & Message -->
    <div class="form-card" id="step1Content">
        <h2 class="step-title">
            <i class="bi bi-pencil-square"></i>
            Announcement Details
        </h2>
        <p class="step-description">Enter the title and message for your announcement</p>

        <div class="form-group">
            <label for="title" class="form-label">
                <i class="bi bi-megaphone"></i>
                Announcement Title <span class="required">*</span>
            </label>
            <input type="text" id="title" name="Title" class="form-control" 
                   placeholder="Enter announcement title" maxlength="200" />
            <div class="char-counter">
                <span id="titleCount">0</span> / 200 characters
            </div>
        </div>

        <div class="form-group">
            <label for="message" class="form-label">
                <i class="bi bi-chat-text"></i>
                Announcement Message <span class="required">*</span>
            </label>
            <textarea id="message" name="Message" class="form-control" 
                      rows="8" placeholder="Enter announcement message..." maxlength="2000"></textarea>
            <div class="char-counter">
                <span id="messageCount">0</span> / 2000 characters
            </div>
        </div>

        <div class="form-actions step-actions">
            <button type="button" class="btn-cancel" id="cancelBtn1">
                <i class="bi bi-x-circle"></i>
                Cancel
            </button>
            <button type="button" class="btn-next" id="nextToReview">
                Next: Review
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- Step 2: Review -->
    <div class="form-card" id="step2Content" style="display: none;">
        <h2 class="step-title">
            <i class="bi bi-eye"></i>
            Review Announcement
        </h2>
        <p class="step-description">Please review your announcement details before publishing</p>

        <div class="review-card">
            <div class="review-section">
                <div class="review-label">
                    <i class="bi bi-megaphone"></i>
                    Title
                </div>
                <div class="review-value" id="reviewTitle">-</div>
            </div>

            <div class="review-section">
                <div class="review-label">
                    <i class="bi bi-chat-text"></i>
                    Message
                </div>
                <div class="review-value review-message" id="reviewMessage">-</div>
            </div>

            <div class="review-section">
                <div class="review-label">
                    <i class="bi bi-person"></i>
                    Created By
                </div>
                <div class="review-value" id="reviewCreatedBy">@(User.Identity?.Name ?? "Admin User")</div>
            </div>

            <div class="review-section">
                <div class="review-label">
                    <i class="bi bi-calendar"></i>
                    Created At
                </div>
                <div class="review-value" id="reviewCreatedAt">@DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")</div>
            </div>
        </div>

        <div class="form-actions step-actions">
            <button type="button" class="btn-back" id="backToDetails">
                <i class="bi bi-arrow-left"></i>
                Back to Details
            </button>
            <button type="button" class="btn-next" id="nextToPublish">
                Next: Publish
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>

    <!-- Step 3: Publish -->
    <div class="form-card" id="step3Content" style="display: none;">
        <h2 class="step-title">
            <i class="bi bi-rocket-takeoff"></i>
            Ready to Publish
        </h2>
        <p class="step-description">Confirm and publish your announcement</p>

        <div class="publish-card">
            <div class="publish-icon">
                <i class="bi bi-send-check"></i>
            </div>
            <h3>You're all set!</h3>
            <p>Your announcement is ready to be published. Once published, it will be visible to all users.</p>
            
            <div class="publish-details">
                <div class="publish-detail">
                    <span class="detail-label">Title:</span>
                    <span class="detail-value" id="publishTitle">-</span>
                </div>
                <div class="publish-detail">
                    <span class="detail-label">Message length:</span>
                    <span class="detail-value" id="publishLength">-</span>
                </div>
            </div>
        </div>

        <div class="form-actions step-actions">
            <button type="button" class="btn-back" id="backToReview">
                <i class="bi bi-arrow-left"></i>
                Back to Review
            </button>
            <form method="post" id="publishForm" style="display: inline;">
                <input type="hidden" id="hiddenTitle" name="Title" />
                <input type="hidden" id="hiddenMessage" name="Message" />
                <button type="submit" class="btn-publish" id="publishBtn">
                    <i class="bi bi-send"></i>
                    Publish Announcement
                </button>
            </form>
        </div>
    </div>
</div>

<script src="~/js/addAnnouncement.js"></script>

<!-- SUCCESS POPUP - OUTSIDE ALL CONTAINERS WITH INLINE STYLES -->
@if (Model.ShowSuccessPopup)
{
    <div id="successPopup" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 999999; display: flex; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.6); backdrop-filter: blur(4px);">
        <div style="background: white; border-radius: 20px; padding: 40px 32px; text-align: center; max-width: 380px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.3); animation: popupSlideIn 0.3s ease-out;">
            <div style="margin-bottom: 20px;">
                <i class="bi bi-check-circle-fill" style="font-size: 80px; color: #28a745;"></i>
            </div>
            <h2 style="color: #1e293b; font-size: 28px; font-weight: 700; margin: 0 0 12px 0;">Success!</h2>
            <p style="color: #64748b; font-size: 15px; line-height: 1.5; margin: 0 0 32px 0;">Everything is OK, continue to the next step</p>
            <button id="popupContinueBtn" style="background: linear-gradient(135deg, #28a745, #059669); color: white; border: none; padding: 12px 32px; font-size: 16px; font-weight: 600; border-radius: 40px; cursor: pointer; transition: all 0.2s ease; min-width: 140px;">Continue</button>
        </div>
    </div>
}