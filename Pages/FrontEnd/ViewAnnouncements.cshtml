@page
@model APMoodle.Pages.BackEnd.ViewAnnouncementsModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Announcements";

    var items = Model.Announcements;
    var latest = items.FirstOrDefault();
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/viewAnnouncement.css" />
</head>

<div id="horizontalNavbar">
    <div class="PageComponent">
        <div class="va-page">

            <div class="va-head">
                <div class="va-head-icon"><i class="fas fa-bullhorn"></i></div>
                <div>
                    <h2>Latest Announcements</h2>
                    <p>
                        @if (items.Any())
                        {
                            <span>@items.Count active announcement@(items.Count == 1 ? "" : "s")</span>
                            @if (latest != null)
                            {
                                <span> · last posted @latest.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            }
                        }
                        else
                        {
                            <span>You're all caught up</span>
                        }
                    </p>
                </div>
            </div>

            @if (items.Any())
            {
                <div class="va-list">
                    @foreach (var a in items)
                    {
                        <article class="va-card">
                            <div class="va-card-icon"><i class="fas fa-bullhorn"></i></div>
                            <div class="va-card-body">
                                <h3 class="va-card-title">@a.Title</h3>
                                <p class="va-card-msg">@a.Message</p>
                                <div class="va-card-meta">
                                    <span><i class="fas fa-user-shield"></i> @(a.Creator?.Name ?? "Admin")</span>
                                    <span><i class="far fa-clock"></i> @a.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="va-empty">
                    <i class="fas fa-bullhorn"></i>
                    <h3>No announcements yet</h3>
                    <p>When your admin posts an announcement, it'll show up right here.</p>
                </div>
            }
        </div>
    </div>
</div>
