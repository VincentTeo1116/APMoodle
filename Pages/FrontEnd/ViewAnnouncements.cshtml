@page
@model APMoodle.Pages.BackEnd.ViewAnnouncementsModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Announcements";

    var items = Model.Announcements;
    var latest = items.FirstOrDefault();
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<div id="horizontalNavbar">
    <div class="PageComponent">
        <div class="va-page">

            <div class="va-head">
                <div class="va-head-icon"><i class="fas fa-bullhorn"></i></div>
                <div>
                    <h2>Latest Announcements</h2>
                    <p>
                        @if (items.Any())
                        {
                            <span>@items.Count active announcement@(items.Count == 1 ? "" : "s")</span>
                            @if (latest != null)
                            {
                                <span> · last posted @latest.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                            }
                        }
                        else
                        {
                            <span>You're all caught up</span>
                        }
                    </p>
                </div>
            </div>

            @if (items.Any())
            {
                <div class="va-list">
                    @foreach (var a in items)
                    {
                        <article class="va-card">
                            <div class="va-card-icon"><i class="fas fa-bullhorn"></i></div>
                            <div class="va-card-body">
                                <h3 class="va-card-title">@a.Title</h3>
                                <p class="va-card-msg">@a.Message</p>
                                <div class="va-card-meta">
                                    <span><i class="fas fa-user-shield"></i> @(a.Creator?.Name ?? "Admin")</span>
                                    <span><i class="far fa-clock"></i> @a.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="va-empty">
                    <i class="fas fa-bullhorn"></i>
                    <h3>No announcements yet</h3>
                    <p>When your admin posts an announcement, it'll show up right here.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .va-page {
        margin: 0 auto;
        padding: 0.5rem 0 2rem;
        font-family: 'Inter', sans-serif;
    }

    .va-head {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }

    .va-head-icon {
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        border-radius: 1rem;
        display: grid;
        place-items: center;
        color: #fff;
        font-size: 1.4rem;
        background: linear-gradient(135deg, #b8935a 0%, #8b7355 55%, #6b5d4f 100%);
        box-shadow: 0 8px 20px rgba(61, 48, 39, 0.32);
    }

    .va-head h2 {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--dark, #1f2937);
        margin: 0 0 0.15rem;
    }

    .va-head p {
        color: var(--muted, #64748b);
        font-size: 0.9rem;
        margin: 0;
    }

    .va-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .va-card {
        display: flex;
        gap: 1.1rem;
        background: #fff;
        border: 1px solid #eef0f4;
        border-left: 4px solid #c9a24b;
        border-radius: 1rem;
        padding: 1.4rem 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .va-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 28px -12px rgba(61, 48, 39, 0.26);
        border-left-color: #8b7355;
    }

    .va-card:hover .va-card-icon {
        transform: scale(1.08) rotate(-4deg);
        background: #ecdcbd;
    }

    .va-card-icon {
        transition: transform 0.25s ease, background 0.25s ease;
    }

    .va-card-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 0.75rem;
        display: grid;
        place-items: center;
        color: #8b7355;
        font-size: 1.05rem;
        background: #f5ecd9;
    }

    .va-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 0.4rem;
    }

    .va-card-msg {
        color: #4b5563;
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0 0 0.9rem;
        white-space: pre-line;
    }

    .va-card-meta {
        display: flex;
        gap: 1.25rem;
        flex-wrap: wrap;
        font-size: 0.82rem;
        color: #94a3b8;
    }

    .va-card-meta span {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .va-card-meta i {
        color: #c9a24b;
    }

    .va-empty {
        text-align: center;
        padding: 4rem 1.5rem;
        background: #fff;
        border: 1px dashed #e8ddc9;
        border-radius: 1.25rem;
        color: #94a3b8;
    }

    .va-empty i {
        font-size: 2.5rem;
        color: #d9c9a3;
        margin-bottom: 1rem;
    }

    .va-empty h3 {
        color: #475569;
        font-weight: 700;
        margin: 0 0 0.4rem;
    }

    .va-empty p {
        margin: 0;
        font-size: 0.9rem;
    }

    @@media (max-width: 560px) {
        .va-card { flex-direction: column; gap: 0.75rem; }
    }
</style>
