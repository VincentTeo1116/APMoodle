@page
@model PrivacyModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Privacy Policy";
}

@*
    Front-end / styling: Moses — matches the APMoodle dashboard design system (dashboard.css tokens).
    Static content page; no backend contract.
*@

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
</head>

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
    </div>

    <div class="PageComponent">
        <div class="pp-page">

            <!-- Hero -->
            <div class="pp-hero">
                <div class="pp-hero-ico"><i class="fas fa-shield-halved"></i></div>
                <h2>Privacy Policy</h2>
                <p>How APMoodle collects, uses, and protects your information.</p>
                <span class="pp-updated"><i class="far fa-calendar"></i> Last updated: @DateTime.Now.ToString("dd MMMM yyyy")</span>
            </div>

            <p class="pp-intro">
                APMoodle ("we", "our", or "the platform") is a learning management system built for educational use.
                We respect your privacy and are committed to protecting the personal information you share with us.
                This policy explains what we collect, why we collect it, and the choices you have.
            </p>

            <div class="pp-sections">

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-id-card"></i></span><h3>1. Information We Collect</h3></div>
                    <ul class="pp-list">
                        <li><strong>Account details</strong> — your name, email address, contact number, date of birth, and gender, provided when you register.</li>
                        <li><strong>Learning activity</strong> — modules you join, quizzes you attempt, your scores, answers, and time spent per question.</li>
                        <li><strong>Messages</strong> — chat messages exchanged with your lecturers through the platform.</li>
                        <li><strong>Technical data</strong> — a secure session cookie used to keep you signed in.</li>
                    </ul>
                </section>

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-gears"></i></span><h3>2. How We Use Your Information</h3></div>
                    <ul class="pp-list">
                        <li>To provide and operate the platform — enrolling you in modules and recording quiz results.</li>
                        <li>To display your progress, scores, and personalised dashboard.</li>
                        <li>To enable communication between you and your lecturers.</li>
                        <li>To send essential account emails, such as password resets.</li>
                        <li>To maintain the security and reliability of the service.</li>
                    </ul>
                </section>

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-lock"></i></span><h3>3. Data Storage &amp; Security</h3></div>
                    <p>
                        Your data is stored in a managed cloud PostgreSQL database and transmitted over encrypted (SSL/TLS)
                        connections. Passwords are never stored in plain text — they are hashed before being saved.
                        We restrict access to personal data to authorised lecturers and administrators only.
                    </p>
                </section>

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-cookie-bite"></i></span><h3>4. Cookies &amp; Sessions</h3></div>
                    <p>
                        We use a single session cookie to keep you logged in while you use the platform. We do
                        <strong>not</strong> use third-party advertising or tracking cookies. Signing out or closing
                        your session ends it.
                    </p>
                </section>

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-share-nodes"></i></span><h3>5. Sharing Your Information</h3></div>
                    <p>
                        We do <strong>not</strong> sell or rent your personal information. Your learning data is visible
                        to the lecturers and administrators of the modules you are enrolled in, strictly for educational
                        purposes. We only disclose data otherwise where required by law.
                    </p>
                </section>

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-user-shield"></i></span><h3>6. Your Rights</h3></div>
                    <ul class="pp-list">
                        <li>Access the personal information we hold about you.</li>
                        <li>Request corrections to inaccurate details.</li>
                        <li>Request deletion of your account and associated data.</li>
                    </ul>
                    <p class="pp-muted">To exercise any of these rights, contact your administrator using the details below.</p>
                </section>

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-clock-rotate-left"></i></span><h3>7. Data Retention</h3></div>
                    <p>
                        We keep your information for as long as your account is active or as needed to provide the service.
                        When an account is removed, its associated records are deleted or anonymised.
                    </p>
                </section>

                <section class="pp-card">
                    <div class="pp-card-head"><span class="pp-num"><i class="fas fa-file-pen"></i></span><h3>8. Changes to This Policy</h3></div>
                    <p>
                        We may update this policy from time to time. When we do, we will revise the "Last updated" date at
                        the top of this page. Continued use of APMoodle after changes means you accept the updated policy.
                    </p>
                </section>

            </div>

            <!-- Contact -->
            <div class="pp-contact">
                <div class="pp-contact-ico"><i class="fas fa-envelope-open-text"></i></div>
                <div>
                    <h3>Contact Us</h3>
                    <p>Questions about your privacy or this policy? Reach out to your module lecturer or the APMoodle administrator at <a href="mailto:privacy@apmoodle.edu">privacy@apmoodle.edu</a>.</p>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* ===== APMoodle Privacy Policy — design tokens mirror dashboard.css ===== */

    /* Center the page title at the top */
    #horizontalNavbar > .PageTitle { text-align: center; }
    #horizontalNavbar > .PageTitle h1 { display: inline-block; }

    .pp-page {
        --primary: #4f46e5;
        --primary-light: #818cf8;
        --dark: #1f2937;
        --gray: #6b7280;
        --gray-light: #9ca3af;
        --line: #e5e7eb;
        --light: #f9fafb;
        font-family: 'Inter', system-ui, sans-serif;
        max-width: 820px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 3rem;
        color: var(--dark);
    }

    /* Hero */
    .pp-hero {
        text-align: center;
        background: #fff;
        border-radius: 1.5rem;
        padding: 2.25rem 2rem;
        box-shadow: 0 10px 30px rgba(31, 41, 55, .08);
        position: relative; overflow: hidden;
        animation: ppFade .45s ease both;
    }
    .pp-hero::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 5px; background: linear-gradient(90deg, var(--primary), var(--primary-light)); }
    .pp-hero-ico {
        width: 4rem; height: 4rem; margin: .25rem auto 1rem;
        border-radius: 1.1rem; display: flex; align-items: center; justify-content: center;
        font-size: 1.7rem; color: #fff;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        box-shadow: 0 10px 24px rgba(79, 70, 229, .35);
        animation: ppPop .5s cubic-bezier(.34, 1.4, .64, 1) both;
    }
    .pp-hero h2 { font-size: 1.7rem; font-weight: 800; margin: 0 0 .4rem; }
    .pp-hero p { color: var(--gray); font-size: .95rem; margin: 0 0 1rem; }
    .pp-updated { display: inline-flex; align-items: center; gap: .4rem; font-size: .78rem; font-weight: 600; color: var(--primary); background: #eef2ff; padding: .35rem .85rem; border-radius: 999px; }

    .pp-intro { color: var(--gray); font-size: .95rem; line-height: 1.65; margin: 1.75rem .25rem; }

    /* Section cards */
    .pp-sections { display: flex; flex-direction: column; gap: 1rem; }
    .pp-card {
        background: #fff; border-radius: 1rem; padding: 1.4rem 1.6rem;
        box-shadow: 0 4px 14px rgba(31, 41, 55, .06);
        animation: ppFade .45s ease both;
    }
    .pp-card-head { display: flex; align-items: center; gap: .8rem; margin-bottom: .85rem; }
    .pp-num {
        width: 2.4rem; height: 2.4rem; flex-shrink: 0;
        border-radius: .7rem; display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 1rem;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
    }
    .pp-card-head h3 { font-size: 1.08rem; font-weight: 700; margin: 0; color: var(--dark); }
    .pp-card p { color: var(--gray); font-size: .9rem; line-height: 1.65; margin: 0; }
    .pp-muted { margin-top: .65rem !important; font-size: .82rem !important; color: var(--gray-light) !important; }

    .pp-list { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: .5rem; }
    .pp-list li { color: var(--gray); font-size: .9rem; line-height: 1.6; }
    .pp-list li strong { color: var(--dark); }
    .pp-list li::marker { color: var(--primary-light); }

    /* Contact */
    .pp-contact {
        display: flex; align-items: center; gap: 1.1rem;
        margin-top: 1.5rem; padding: 1.5rem 1.75rem;
        border-radius: 1.25rem; color: #fff;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        box-shadow: 0 12px 28px rgba(79, 70, 229, .3);
        animation: ppFade .45s ease both;
    }
    .pp-contact-ico { width: 3.2rem; height: 3.2rem; flex-shrink: 0; border-radius: 50%; background: rgba(255, 255, 255, .2); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .pp-contact h3 { margin: 0 0 .3rem; font-size: 1.15rem; font-weight: 800; }
    .pp-contact p { margin: 0; font-size: .9rem; opacity: .95; line-height: 1.55; }
    .pp-contact a { color: #fff; font-weight: 700; text-decoration: underline; }

    @@keyframes ppFade { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    @@keyframes ppPop  { from { opacity: 0; transform: scale(.8); } to { opacity: 1; transform: scale(1); } }
</style>
