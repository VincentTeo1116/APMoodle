@page
@model APMoodle.Pages.BackEnd.AddModuleModel
@{
    ViewData["Title"] = "Add Module";
}

<head>
    <link rel="stylesheet" href="~/css/editModule.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<div class="module-form-page">
    <div class="module-form-header">
        <h1><i class="bi bi-plus-circle"></i> Create Module</h1>
        <p class="module-form-subtitle">Add a new module to the system</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-error">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="form-card">
        <form method="post">
            <div class="form-group">
                <label class="form-label"><i class="bi bi-tag"></i> Module Category <span class="required">*</span></label>
                <select name="SelectedCategory" class="form-control" id="categorySelect" required>
                    <option value="">Select Category</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Code">[@cat.Code] @cat.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label"><i class="bi bi-code"></i> Module Code</label>
                <input type="text" class="form-control" id="generatedCode" value="CS###_Month_Year" disabled readonly />
                <small class="text-muted">This code will be generated automatically based on your selection.</small>
            </div>

            <div class="form-group">
                <label class="form-label"><i class="bi bi-book"></i> Module Name <span class="required">*</span></label>
                <input type="text" name="Name" class="form-control" placeholder="e.g., Data Structures" required />
            </div>

            <div class="form-group">
                <label class="form-label"><i class="bi bi-text-paragraph"></i> Description</label>
                <textarea name="Description" class="form-control" rows="4" placeholder="Enter module description..."></textarea>
            </div>

            <div class="form-group">
                <label class="form-label"><i class="bi bi-person-badge"></i> Lecturer <span class="required">*</span></label>
                <select name="LecturerID" class="form-control" required>
                    <option value="">Select Lecturer</option>
                    @foreach (var lecturer in Model.Lecturers)
                    {
                        <option value="@lecturer.LecturerID">@lecturer.Name (@lecturer.LecturerCode)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label"><i class="bi bi-calendar-check"></i> Start Date <span class="required">*</span></label>
                <input type="date" name="StartDate" class="form-control" required />
            </div>

            <div class="form-group">
                <label class="form-label"><i class="bi bi-calendar-x"></i> End Date <span class="required">*</span></label>
                <input type="date" name="EndDate" class="form-control" required />
            </div>

            <div class="form-actions">
                <a href="/FrontEnd/ModuleList" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-next">Create Module</button>
            </div>
        </form>
    </div>
</div>

@if (Model.ShowSuccessPopup)
{
    <div id="successPopup">
        <div>
            <i class="bi bi-check-circle-fill"></i>
            <h2>Success!</h2>
            <p>Module created successfully!</p>
            <button id="popupContinueBtn">Continue</button>
        </div>
    </div>
}

<script>
    // Live preview of generated code
    document.addEventListener('DOMContentLoaded', function() {
        const categorySelect = document.getElementById('categorySelect');
        const codeInput = document.getElementById('generatedCode');

        function updateCodePreview() {
            const cat = categorySelect.value || 'CS';
            const random = String(Math.floor(Math.random() * 900) + 100).padStart(3, '0');
            const now = new Date();
            const month = String(now.getMonth() + 1).padStart(2, '0'); 
            const year = String(now.getFullYear()).slice(-2); 
            codeInput.value = `${cat}${random}_${month}_${year}`;
        }

        categorySelect.addEventListener('change', updateCodePreview);
        // initial preview
        updateCodePreview();

        // handle success popup
        const popup = document.getElementById('successPopup');
        const btn = document.getElementById('popupContinueBtn');
        if (popup) {
            popup.style.display = 'flex';
            if (btn) btn.onclick = function() { window.location.href = '/FrontEnd/ModuleList'; };
        }
    });
</script>