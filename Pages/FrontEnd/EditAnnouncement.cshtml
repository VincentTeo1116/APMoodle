<script>
    // Pass Razor model data to JavaScript
    window.announcementData = {
        id: @Model.Announcement.AnnouncementID,
        title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Announcement.Title)),
        message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Announcement.Message))
    };
</script>

@if (TempData["ShowSuccessPopup"] != null && (bool)TempData["ShowSuccessPopup"])
{
    <div id="successPopup">
        <div>
            <div>
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h2>Success!</h2>
            <p>Announcement updated successfully!</p>
            <button id="popupContinueBtn">Continue</button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="errorPopup">
        <div>
            <div>
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2>Error!</h2>
            <p>@TempData["ErrorMessage"]</p>
            <button id="errorPopupContinueBtn">Continue</button>
        </div>
    </div>
}