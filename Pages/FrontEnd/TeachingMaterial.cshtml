@page "{id}"
@using Microsoft.AspNetCore.Http
@model APMoodle.Pages.BackEnd.TeachingMaterialModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.CurrentModule?.Name + " - Teaching Materials";
}

@{
    var userId = HttpContext.Session.GetString("UserID");
    var userRole = HttpContext.Session.GetString("UserRole") ?? "Guest";
    var isLoggedIn = !string.IsNullOrEmpty(userId) && userRole != "Guest";

    var hasMaterials = Model.Materials != null && Model.Materials.Any();
    var isLecturer = userRole == "lecturer";
}

<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/material.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="~/js/module.js"></script>
</head>

<div class="teaching-material-page">

    <!-- Header Section -->
    <div class="page-header">
        <div class="header-left">
            <div id="horizontalNavbar">
                <h1>@(Model.CurrentModule?.Name ?? "Teaching Materials")</h1>
                <p class="path">@(char.ToUpper(userRole[0]) + userRole.Substring(1)) Dashboard >
                    @(Model.CurrentModule?.Name) >
                    Teaching Material</p>
                </div>
            </div>
        </div>

        <div class="main-content">
            <div class="materials-section">
                <div class="section-header">
                    <h2>Teaching Material</h2>
                    @if (isLecturer && !hasMaterials)
                    {
                        <a href="/FrontEnd/CreateMaterial?moduleId=@Model.CurrentModule?.ModuleID" class="add-btn">+ Add Your
                            First Material</a>
                    }
                    else if (isLecturer && hasMaterials)
                    {
                        <a href="/FrontEnd/CreateMaterial?moduleId=@Model.CurrentModule?.ModuleID" class="add-btn">+ Add
                                Material</a>
                    }
                        </div>

                        <div class="materials-list">
                            @if (hasMaterials)
                            {
                                foreach (var material in Model.Materials)
                                {
                                    <div class="material-card">
                                        <div class="material-card-header">
                                            <div class="material-icon">📘</div>
                                            <div class="material-info">
                                                <h3 class="material-title">@material.Title</h3>
                                                <p class="material-description">@(material.Description ?? "No description")</p>
                                            </div>
                                        </div>
                                        <div class="material-card-footer">
                                            <span class="material-date">Updated @(material.CreatedAt.ToString("MMM dd, yyyy")??"Unknown")</span>
                                            @if (isLecturer)
                                            {
                                                <a href="/FrontEnd/TeachingMaterialOverview/@material.MaterialID" class="view-link" title="Edit teaching material"><i class="bi bi-pencil-square"></i> Edit</a>
                                            }
                                            else
                                            {
                                                <a href="/FrontEnd/TeachingMaterialOverview/@material.MaterialID" class="view-link" title="View teaching material"><i class="bi bi-eye"></i>View</a>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state">
                                    <span>📭</span>
                                    <p>No teaching materials yet.</p>
                                    @* @if (isLecturer)
                                    {
                                    <a href="/FrontEnd/CreateMaterial?moduleId=@Model.CurrentModule?.ModuleID" class="add-btn">Add Your
                                        First Material</a>
                                    } *@
                                </div>
                            }
                        </div>
                    </div>
                    <!-- Right Section: Module Details -->
                    <div class="details-section">
                        <div class="module-details-card">
                            <h3>@Model.CurrentModule?.Name</h3>
                            <div class="module-info-vertical">
                                <div class="info-group">
                                    <span class="info-label">Description</span>
                                    <span class="info-value">@(Model.CurrentModule?.Description ?? "No description")</span>
                                </div>
                                <div class="info-group">
                                    <span class="info-label">Start Date</span>
                                    <span class="info-value">@(Model.CurrentModule?.StartDate.ToString("dd/MM/yyyy") ??
                                                                                                                                                                                          "N/A")</span>
                                    </div>
                                    <div class="info-group">
                                        <span class="info-label">End Date</span>
                                        <span class="info-value">@(Model.CurrentModule?.EndDate.ToString("dd/MM/yyyy") ?? "N/A")</span>
                                    </div>
                                    <!-- Invitation Code Section - Independent -->
                                    <div class="invitation-section">
                                        <span class="invitation-label">Invitation Code</span>
                                        <div class="code-row">
                                            <span class="code-value" id="invitationCode">@(Model.CurrentModule?.InvitationCode ?? "N/A")</span>
                                                @if (isLecturer)
                                                {
                                                    <button class="regenerate-btn" onclick="regenerateCode(@Model.CurrentModule?.ModuleID)">⟳
                                                        Regenerate Code</button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        