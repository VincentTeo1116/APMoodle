@page
@{
    Layout = null;
    ViewData["Title"] = "Loader Preview";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Loader Preview - APMoodle</title>
    <link rel="stylesheet" href="~/css/loader.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: "Segoe UI", Arial, sans-serif;
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, #f4e4c1, transparent),
                radial-gradient(circle at bottom right, #e8d5b7, transparent),
                #c9b697;
            padding: 40px 24px;
            color: #3d3027;
        }
        .preview-head {
            text-align: center;
            margin-bottom: 32px;
        }
        .preview-head h1 {
            font-size: 32px;
            letter-spacing: 3px;
            margin-bottom: 6px;
            text-shadow: 1px 1px 2px rgba(255,255,255,0.5);
        }
        .preview-head p {
            color: #5d4e37;
            font-size: 14px;
        }
        .preview-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            max-width: 1100px;
            margin: 0 auto;
        }
        @@media (max-width: 820px) {
            .preview-grid { grid-template-columns: 1fr; }
        }
        .preview-card {
            background: rgba(245, 235, 220, 0.5);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(139, 115, 85, 0.3);
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 18px 40px rgba(0,0,0,0.18);
        }
        .preview-card h2 {
            font-size: 20px;
            margin-bottom: 4px;
            letter-spacing: 2px;
            color: #3d3027;
        }
        .preview-card .sub {
            color: #6b5d4f;
            font-size: 12px;
            margin-bottom: 14px;
            letter-spacing: 1px;
        }
        .preview-frame {
            width: 100%;
            height: 360px;
            border-radius: 14px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(139, 115, 85, 0.25);
        }
        .actions {
            margin-top: 18px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .btn {
            border: none;
            border-radius: 10px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: all 0.25s ease;
            font-family: inherit;
        }
        .btn-primary {
            background: linear-gradient(135deg, #8b7355, #6b5d4f);
            color: #f5ebdc;
            box-shadow: 0 6px 16px rgba(61, 48, 39, 0.25);
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(61, 48, 39, 0.35); }
        .btn-ghost {
            background: rgba(255, 250, 240, 0.7);
            border: 1px solid rgba(139, 115, 85, 0.5);
            color: #5d4e37;
        }
        .btn-ghost:hover { background: rgba(255, 250, 240, 0.95); border-color: #8b7355; }
        .btn.active {
            outline: 2px solid #3d3027;
            outline-offset: 2px;
        }
        .status {
            margin-top: 18px;
            text-align: center;
            font-size: 13px;
            color: #5d4e37;
            min-height: 18px;
        }
        .status b { color: #3d3027; }
        .footer-links {
            margin-top: 26px;
            text-align: center;
            font-size: 12px;
        }
        .footer-links a {
            color: #6b5d4f;
            text-decoration: none;
            margin: 0 10px;
            font-weight: 600;
            letter-spacing: 1px;
        }
        .footer-links a:hover { color: #3d3027; text-decoration: underline; }
    </style>
</head>
<body>

    <div class="preview-head">
        <h1>LOADER · SIDE BY SIDE</h1>
        <p>Pick the one you like, then click "Set as active" — every page will use it from now on.</p>
    </div>

    <div class="preview-grid">

        <!-- ───────── VARIANT A · PAPER ───────── -->
        <div class="preview-card">
            <h2>A · Paper draw</h2>
            <div class="sub">Vintage paper · drawing logo · shimmer wordmark</div>

            <div class="preview-frame">
                <div class="apm-loader apm-loader--inline" id="previewA">
                    <div class="apm-loader-stage">
                        <svg class="apm-loader-logo" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                            <g class="tassel-group">
                                <path class="draw tassel-line" d="M150 60 L150 95" />
                                <circle class="fill-tassel-bead" cx="150" cy="100" r="6" />
                            </g>
                            <path class="draw" d="M100 50 L170 80 L100 110 L30 80 Z" />
                            <path class="fill-cap" d="M100 50 L170 80 L100 110 L30 80 Z" />
                            <path class="draw s2" d="M40 90 L40 120 Q70 140 100 130 Q130 140 160 120 L160 90" />
                            <path class="draw s3" d="M30 135 Q65 155 100 145 Q135 155 170 135 L170 165 Q135 180 100 170 Q65 180 30 165 Z" />
                            <path class="fill-book-left"  d="M30 140 Q65 158 100 148 L100 170 Q65 180 30 165 Z" />
                            <path class="fill-book-right" d="M170 140 Q135 158 100 148 L100 170 Q65 180 30 165 Z" />
                        </svg>
                        <div class="apm-loader-wordmark">APMoodle</div>
                        <div class="apm-loader-bar"><span></span></div>
                    </div>
                </div>
            </div>

            <div class="actions">
                <button class="btn btn-primary" data-fullscreen="paper">▶ Full-screen preview</button>
                <button class="btn btn-ghost" data-activate="paper" id="activatePaper">Set as active</button>
            </div>
        </div>

        <!-- ───────── VARIANT B · RINGS ───────── -->
        <div class="preview-card">
            <h2>B · Triple rings</h2>
            <div class="sub">Dark gradient · three concentric rings · vintage palette</div>

            <div class="preview-frame">
                <div class="apm-loader apm-loader--inline apm-loader--rings" id="previewB">
                    <div class="apm-loader-stage">
                        <div class="apm-loader-rings">
                            <div class="ring r1"></div>
                            <div class="ring r2"></div>
                            <div class="ring r3"></div>
                        </div>
                        <div class="apm-loader-wordmark">APMoodle</div>
                        <div class="apm-loader-subtext">Loading Experience...</div>
                    </div>
                </div>
            </div>

            <div class="actions">
                <button class="btn btn-primary" data-fullscreen="rings">▶ Full-screen preview</button>
                <button class="btn btn-ghost" data-activate="rings" id="activateRings">Set as active</button>
            </div>
        </div>

    </div>

    <div class="status" id="statusMsg"></div>

    <div class="footer-links">
        <a href="/FrontEnd/Login">← Back to Login</a>
        <a href="#" id="testNav">Click here to trigger active loader</a>
    </div>

    <!-- Full-screen preview overlay -->
    <div id="apm-loader" class="apm-loader is-hidden" style="display:none;">
        <div class="apm-loader-stage">
            <svg class="apm-loader-logo" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                <g class="tassel-group">
                    <path class="draw tassel-line" d="M150 60 L150 95" />
                    <circle class="fill-tassel-bead" cx="150" cy="100" r="6" />
                </g>
                <path class="draw" d="M100 50 L170 80 L100 110 L30 80 Z" />
                <path class="fill-cap" d="M100 50 L170 80 L100 110 L30 80 Z" />
                <path class="draw s2" d="M40 90 L40 120 Q70 140 100 130 Q130 140 160 120 L160 90" />
                <path class="draw s3" d="M30 135 Q65 155 100 145 Q135 155 170 135 L170 165 Q135 180 100 170 Q65 180 30 165 Z" />
                <path class="fill-book-left"  d="M30 140 Q65 158 100 148 L100 170 Q65 180 30 165 Z" />
                <path class="fill-book-right" d="M170 140 Q135 158 100 148 L100 170 Q65 180 30 165 Z" />
            </svg>
            <div class="apm-loader-wordmark">APMoodle</div>
            <div class="apm-loader-bar"><span></span></div>
        </div>
    </div>

    <script>
        (function () {
            var STORAGE_KEY = 'apmLoaderVariant';
            var loader = document.getElementById('apm-loader');
            var statusMsg = document.getElementById('statusMsg');

            function activeVariant() {
                try { return localStorage.getItem(STORAGE_KEY) || 'rings'; }
                catch (e) { return 'rings'; }
            }

            function refreshActiveUi() {
                var active = activeVariant();
                document.getElementById('activatePaper').classList.toggle('active', active === 'paper');
                document.getElementById('activateRings').classList.toggle('active', active === 'rings');
                statusMsg.innerHTML = 'Active loader: <b>' + (active === 'rings' ? 'B · Triple rings' : 'A · Paper draw') + '</b>';
            }

            // Inject ring DOM into the full-screen loader on demand
            function ensureRings() {
                var stage = loader.querySelector('.apm-loader-stage');
                if (!stage.querySelector('.apm-loader-rings')) {
                    var r = document.createElement('div');
                    r.className = 'apm-loader-rings';
                    r.innerHTML = '<div class="ring r1"></div><div class="ring r2"></div><div class="ring r3"></div>';
                    var wm = stage.querySelector('.apm-loader-wordmark');
                    stage.insertBefore(r, wm);
                }
                if (!stage.querySelector('.apm-loader-subtext')) {
                    var s = document.createElement('div');
                    s.className = 'apm-loader-subtext';
                    s.textContent = 'Loading Experience...';
                    stage.appendChild(s);
                }
            }

            function showFullscreen(variant, ms) {
                if (variant === 'rings') {
                    loader.classList.add('apm-loader--rings');
                    ensureRings();
                } else {
                    loader.classList.remove('apm-loader--rings');
                }
                loader.style.display = '';
                void loader.offsetWidth;
                loader.classList.remove('is-hidden');
                setTimeout(function () {
                    loader.classList.add('is-hidden');
                    setTimeout(function () { loader.style.display = 'none'; }, 600);
                }, ms || 2500);
            }

            // Full-screen preview buttons
            document.querySelectorAll('[data-fullscreen]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    showFullscreen(btn.getAttribute('data-fullscreen'), 2800);
                });
            });

            // Set-as-active buttons
            document.querySelectorAll('[data-activate]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var v = btn.getAttribute('data-activate');
                    try { localStorage.setItem(STORAGE_KEY, v); } catch (e) {}
                    refreshActiveUi();
                    statusMsg.innerHTML += ' &nbsp;·&nbsp; <span style="color:#3d3027">Saved.</span>';
                });
            });

            // Trigger active loader so user can see it on this page
            document.getElementById('testNav').addEventListener('click', function (e) {
                e.preventDefault();
                showFullscreen(activeVariant(), 2200);
            });

            refreshActiveUi();
        })();
    </script>

</body>
</html>
