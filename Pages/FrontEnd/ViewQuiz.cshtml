                        to { opacity: 1; transform: none; }
                    }

                    .std-qnum { font-size: 12px; color: #6366f1; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 6px; }
                    .std-qtext { font-size: 22px; font-weight: 700; color: #1e1b4b; margin: 0 0 24px; line-height: 1.4; }

                    .std-options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
                    .std-option {
                        display: grid; grid-template-columns: 36px 1fr auto; gap: 14px; align-items: center;
                        background: #fff; border: 2px solid #e0e7ff; border-radius: 14px;
                        padding: 14px 18px; cursor: pointer; transition: all .2s;
                    }
                    .std-option:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(99, 102, 241, .12); border-color: #c7d2fe; }
                    .std-option input { display: none; }
                    .std-bullet {
                        width: 32px; height: 32px; border-radius: 10px;
                        display: flex; align-items: center; justify-content: center;
                        color: #fff; font-weight: 800; font-size: 14px;
                        transition: transform .15s;
                    }
                    .std-a .std-bullet { background: linear-gradient(135deg, #6366f1, #4f46e5); }
                    .std-b .std-bullet { background: linear-gradient(135deg, #a855f7, #9333ea); }
                    .std-c .std-bullet { background: linear-gradient(135deg, #ec4899, #db2777); }
                    .std-d .std-bullet { background: linear-gradient(135deg, #14b8a6, #0d9488); }

                    .std-text { font-size: 15px; color: #1e293b; font-weight: 500; line-height: 1.4; }
                    .std-check {
                        width: 26px; height: 26px; border-radius: 50%;
                        background: transparent; border: 2px solid #e0e7ff;
                        color: transparent; font-weight: 800; font-size: 13px;
                        display: flex; align-items: center; justify-content: center;
                        transition: all .15s;
                    }
                    .std-option:has(input:checked) {
                        background: linear-gradient(90deg, #eef2ff 0%, #fdf4ff 100%);
                        border-color: #a855f7;
                        box-shadow: 0 4px 18px rgba(168, 85, 247, .2);
                    }
                    .std-option:has(input:checked) .std-bullet { transform: scale(1.1); }
                    .std-option:has(input:checked) .std-check {
                        background: linear-gradient(135deg, #6366f1, #a855f7);
                        border-color: transparent; color: #fff;
                    }

                    .std-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
                    .std-btn {
                        font-family: inherit; font-weight: 600; font-size: 14px;
                        padding: 11px 24px; border-radius: 12px; border: none;
                        cursor: pointer; transition: all .15s;
                    }
                    .std-btn-ghost { background: #f1f5f9; color: #475569; }
                    .std-btn-ghost:hover { background: #e2e8f0; }
                    .std-btn-primary {
                        background: linear-gradient(135deg, #6366f1, #a855f7);
                        color: #fff; box-shadow: 0 4px 14px rgba(99, 102, 241, .35);
                    }
                    .std-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99, 102, 241, .5); }
                    .std-btn-finish {
                        background: linear-gradient(135deg, #10b981, #059669);
                        color: #fff; box-shadow: 0 4px 14px rgba(16, 185, 129, .35);
                    }
                    .std-btn-finish:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(16, 185, 129, .5); }
                </style>

                <script>
                    (function () {
                        const root = document.querySelector('.std-quiz');
                        if (!root) return;
                        const slides = root.querySelectorAll('.std-slide');
                        const fill = document.getElementById('stdFill');
                        const count = document.getElementById('stdCount');
                        const total = slides.length;
                        let idx = 0;
                        let enterAt = Date.now();

                        const renderProgress = () => {
                            fill.style.width = ((idx + 1) / total * 100) + '%';
                            count.textContent = `${idx + 1} / ${total}`;
                        };
                        const recordTime = () => {
                            const slide = slides[idx];
                            const qid = slide.dataset.qid;
                            const hidden = slide.querySelector(`[data-time-for="${qid}"]`);
                            if (hidden) {
                                const prev = parseInt(hidden.value, 10) || 0;
                                hidden.value = prev + Math.round((Date.now() - enterAt) / 1000);
                            }
                        };
                        const show = (newIdx) => {
                            recordTime();
                            slides[idx].classList.remove('active');
                            idx = newIdx;
                            slides[idx].classList.add('active');
                            enterAt = Date.now();
                            renderProgress();
                        };
                        root.addEventListener('click', (e) => {
                            const act = e.target.closest('[data-action]');
                            if (!act) return;
                            if (act.dataset.action === 'next' && idx < total - 1) show(idx + 1);
                            if (act.dataset.action === 'prev' && idx > 0) show(idx - 1);
                        });
                        document.getElementById('quizForm').addEventListener('submit', recordTime);
                        renderProgress();
                    })();
                </script>
            }
        }
    </div>
</div>
