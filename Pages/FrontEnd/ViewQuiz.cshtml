                                        <input type="hidden" name="TimeUsed_@q.QuestionID" value="0" data-time-for="@q.QuestionID" />

                                        <div class="cm-actions">
                                            @if (i > 0) { <button type="button" class="cm-btn cm-btn-back" data-action="prev">◀ BACK</button> } else { <span></span> }
                                            @if (i < Model.Questions.Count - 1) { <button type="button" class="cm-btn cm-btn-next" data-action="next">NEXT ▶</button> }
                                            else { <button type="submit" class="cm-btn cm-btn-finish">★ FINISH! ★</button> }
