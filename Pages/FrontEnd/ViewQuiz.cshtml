                <style>
                    /* Comic — softer pop-art: subtle dots, smaller bursts, lighter borders */
                    .cm-quiz { font-family: 'Comic Neue', 'Comic Sans MS', cursive; }
                    .cm-stage {
                        position: relative; overflow: hidden;
                        min-height: 80vh; padding: 40px 20px;
                        border-radius: 14px;
                        background:
                            radial-gradient(circle at 22% 25%, #fef9c3 0%, transparent 45%),
                            radial-gradient(circle at 78% 75%, #fecaca 0%, transparent 45%),
                            #fffbeb;
                        background-image: radial-gradient(circle, rgba(0,0,0,.06) 1px, transparent 1.5px);
                        background-size: 18px 18px;
                        display: flex; align-items: center; justify-content: center;
                    }
                    .cm-burst {
                        position: absolute; font-family: 'Bangers', cursive;
                        font-size: 18px; color: #fff;
                        padding: 6px 10px; pointer-events: none;
                        letter-spacing: 1px; opacity: .85;
                        border-radius: 4px; box-shadow: 2px 2px 0 rgba(0,0,0,.85);
                    }
                    .cm-burst-1 { background: #f43f5e; top: 18px; right: 22px; transform: rotate(8deg); }
                    .cm-burst-2 { display: none; }
                    .cm-burst-3 { background: #f59e0b; bottom: 22px; left: 22px; transform: rotate(-6deg); }

                    .cm-card {
                        position: relative; z-index: 1; width: 100%; max-width: 640px;
                        background: #fff;
                        border: 2.5px solid #1f2937;
                        border-radius: 12px;
                        padding: 32px 36px;
                        box-shadow: 5px 5px 0 #1f2937;
                    }
                    .cm-cap {
                        display: inline-block; background: #fde047;
                        border: 2px solid #1f2937; padding: 3px 12px;
                        font-family: 'Permanent Marker', cursive;
                        font-size: 13px; color: #1f2937;
                        margin-bottom: 10px;
                        border-radius: 4px;
                    }
                    .cm-title {
                        font-family: 'Bangers', cursive; font-size: 30px; color: #1f2937;
                        margin: 0 0 16px; line-height: 1.15; letter-spacing: 1px;
                    }
                    .cm-progress { display: flex; gap: 6px; margin-bottom: 22px; }
                    .cm-dot { flex: 1; height: 6px; border: 1.5px solid #1f2937; background: #fff; border-radius: 3px; transition: background .15s; }
                    .cm-dot.done { background: #fde047; }
                    .cm-dot.current { background: #f43f5e; }

                    .cm-slide { display: none; animation: cmPop .25s cubic-bezier(.34, 1.4, .64, 1); }
                    .cm-slide.active { display: block; }
                    @@keyframes cmPop { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }

                    .cm-bubble {
                        position: relative; background: #fff;
                        border: 2px solid #1f2937; border-radius: 14px;
                        padding: 16px 20px; margin-bottom: 22px;
                        box-shadow: 3px 3px 0 #1f2937;
                    }
                    .cm-bubble::after {
                        content: ''; position: absolute; bottom: -11px; left: 34px;
                        width: 0; height: 0;
                        border-left: 10px solid transparent; border-right: 10px solid transparent;
                        border-top: 12px solid #1f2937;
                    }
                    .cm-bubble::before {
                        content: ''; position: absolute; bottom: -7px; left: 37px;
                        width: 0; height: 0;
                        border-left: 7px solid transparent; border-right: 7px solid transparent;
                        border-top: 8px solid #fff; z-index: 1;
                    }
                    .cm-q-num { font-family: 'Permanent Marker', cursive; font-size: 11px; color: #f43f5e; letter-spacing: 1.5px; margin-bottom: 4px; }
                    .cm-qtext { font-family: 'Comic Neue', cursive; font-size: 18px; font-weight: 700; color: #1f2937; line-height: 1.4; }

                    .cm-options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 22px; }
                    @@media (max-width: 580px) { .cm-options { grid-template-columns: 1fr; } }
                    .cm-option {
                        display: flex; align-items: center; gap: 12px;
                        padding: 13px 15px; background: #fff;
                        border: 2px solid #1f2937; border-radius: 10px;
                        cursor: pointer; transition: transform .12s, box-shadow .12s, background .15s;
                        box-shadow: 3px 3px 0 #1f2937;
                        font-family: 'Comic Neue', cursive; font-weight: 700;
                    }
                    .cm-option:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #1f2937; }
                    .cm-option:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #1f2937; }
                    .cm-option input { display: none; }
                    .cm-letter {
                        width: 32px; height: 32px; border: 2px solid #1f2937;
                        border-radius: 50%; background: #fff;
                        display: flex; align-items: center; justify-content: center;
                        font-family: 'Bangers', cursive; font-size: 17px;
                        flex-shrink: 0;
                    }
                    .cm-text { font-size: 14px; color: #1f2937; line-height: 1.3; }
                    .cm-red    .cm-letter { background: #fda4af; color: #1f2937; }
                    .cm-blue   .cm-letter { background: #93c5fd; color: #1f2937; }
                    .cm-yellow .cm-letter { background: #fde047; color: #1f2937; }
                    .cm-green  .cm-letter { background: #86efac; color: #1f2937; }
                    .cm-option:has(input:checked) {
                        background: #fffbeb;
                        box-shadow: 4px 4px 0 #f43f5e;
                    }
                    .cm-option:has(input:checked) .cm-letter { background: #f43f5e; color: #fff; }

                    .cm-actions { display: flex; justify-content: space-between; gap: 10px; }
                    .cm-btn {
                        font-family: 'Bangers', cursive; font-size: 16px; letter-spacing: 1px;
                        padding: 11px 22px; background: #fff;
                        border: 2px solid #1f2937; border-radius: 10px;
                        cursor: pointer; transition: transform .12s, box-shadow .12s;
                        box-shadow: 3px 3px 0 #1f2937; color: #1f2937;
                    }
                    .cm-btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 #1f2937; }
                    .cm-btn-next { background: #3b82f6; color: #fff; }
                    .cm-btn-finish { background: #22c55e; color: #fff; }
                </style>

                <script>
                    (function () {
                        const root = document.querySelector('.cm-quiz'); if (!root) return;
                        const slides = root.querySelectorAll('.cm-slide');
                        const dots = root.querySelectorAll('.cm-dot');
                        const total = slides.length; let idx = 0; let enterAt = Date.now();
                        const render = () => dots.forEach((d, k) => { d.classList.toggle('current', k === idx); d.classList.toggle('done', k < idx); });
                        const recordTime = () => { const s = slides[idx]; const qid = s.dataset.qid; const h = s.querySelector(`[data-time-for="${qid}"]`); if (h) h.value = (parseInt(h.value, 10) || 0) + Math.round((Date.now() - enterAt) / 1000); };
                        const show = (n) => { recordTime(); slides[idx].classList.remove('active'); idx = n; slides[idx].classList.add('active'); enterAt = Date.now(); render(); };
                        root.addEventListener('click', (e) => { const b = e.target.closest('[data-action]'); if (!b) return;
                            if (b.dataset.action === 'next' && idx < total - 1) show(idx + 1);
                            if (b.dataset.action === 'prev' && idx > 0) show(idx - 1);
                        });
                        document.getElementById('quizForm').addEventListener('submit', recordTime);
                        render();
                    })();
                </script>
            }

