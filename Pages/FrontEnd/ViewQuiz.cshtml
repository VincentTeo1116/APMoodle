@page "{id:int}"
@model APMoodle.Pages.BackEnd.ViewQuizModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.CurrentQuiz?.Title ?? "Attempt Quiz";

    var theme = Model.CurrentQuiz?.Theme?.Trim() ?? string.Empty;
    var subject = Model.CurrentQuiz?.Subject ?? "";

    // Per-theme body background so the theme reaches the shell edges
    var bodyBg = theme switch
    {
        "Midterm"    => "linear-gradient(135deg, #46178f 0%, #6b1cae 40%, #864cd1 100%)",
        "Forest"     => "linear-gradient(135deg, #d8e8c4 0%, #f0ebd8 60%, #e9d6b6 100%)",
        "Comic"      => "#fffbeb",
        "Watercolor" => "#fdfaf3",
        _            => "linear-gradient(135deg, #e0e7ff 0%, #f5d0fe 45%, #fce7f3 100%)"
    };
}

@* Fullbleed shell: collapse container/navbar padding, hide title duplicate + footer,
   stretch the themed stage to fill the viewport (minus the fixed top navbar).
   PageTitle block is kept in markup per the layout convention but hidden visually
   because each theme renders its own title inside the stage. *@
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<style>
    body { background: @Html.Raw(bodyBg) !important; margin-bottom: 0 !important; }
    .container { padding-left: 0 !important; padding-right: 0 !important; max-width: 100% !important; }
    main.pb-3 { padding-bottom: 0 !important; }
    .footer { display: none !important; }
    #horizontalNavbar { padding: 0 !important; }
    #horizontalNavbar > .PageTitle { display: none !important; }
    #horizontalNavbar > .PageComponent { padding: 0 !important; }
    .kh-stage, .fr-stage, .cm-stage, .wc-stage, .std-stage {
        border-radius: 0 !important;
        min-height: calc(100vh - 55px) !important;
    }
</style>

@*
    Front-end / styling: Moses
    Backend contract (do not change):
        Model.CurrentQuiz   — Quiz (Title, Subject, Theme)
        Model.Questions     — ordered List<Question>
        Model.SessionId     — int; posted back as hidden "SessionId"
        Model.Message       — string, nullable
    Form contract:
        SessionId                  — hidden
        Answer_{QuestionID}        — radio "A" | "B" | "C" | "D"
        TimeUsed_{QuestionID}      — hidden, seconds (filled by JS)
    Theme routing:
        "Midterm"  → Theme 1 (Kahoot game show)
        "Mid-term" → Theme 2 (Academic exam paper)
        "Edited"   → Theme 3 (Messaging app)
        "lab"      → Theme 4 (Retro arcade)
        anything else → fallback (Theme 0)
*@

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
    </div>

    <div class="PageComponent">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-warning">@Model.Message</div>
        }

        @if (Model.CurrentQuiz != null && Model.Questions.Any())
        {
            @* ============================================================== *@
            @* THEME 1 — Midterm — Kahoot-style game show                     *@
            @* ============================================================== *@
            if (theme == "Midterm")
            {
                <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@@700;900&display=swap" rel="stylesheet" />

                <div class="kh-quiz">
                    <div class="kh-stage">
                        <div class="kh-blob kh-blob-a"></div>
                        <div class="kh-blob kh-blob-b"></div>
                        <div class="kh-blob kh-blob-c"></div>

                        <header class="kh-top">
                            <div class="kh-pill"><span>QUIZ</span> @Model.CurrentQuiz.Title</div>
                            <div class="kh-score-wrap">
                                <div class="kh-score-label">SCORE</div>
                                <div class="kh-score" id="khScore">0</div>
                            </div>
                        </header>

                        <form method="post" id="quizForm" class="kh-form">
                            <input type="hidden" name="SessionId" value="@Model.SessionId" />

                            <div class="kh-progress">
                                @for (int i = 0; i < Model.Questions.Count; i++)
                                {
                                    <span class="kh-step" data-step="@i"></span>
                                }
                            </div>

                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                var q = Model.Questions[i];
                                <div class="kh-slide @(i == 0 ? "active" : "")" data-idx="@i" data-qid="@q.QuestionID">
                                    <div class="kh-qbox">
                                        <div class="kh-qnum">QUESTION @(i + 1) / @Model.Questions.Count</div>
                                        <div class="kh-qtext">@q.QuestionText</div>
                                    </div>

                                    <div class="kh-timer-row">
                                        <div class="kh-timer" data-timer><span class="kh-timer-num">30</span></div>
                                    </div>

                                    <div class="kh-tiles">
                                        @{
                                            var khTiles = new[]
                                            {
                                                ("A", q.Option1, "kh-red",    "triangle"),
                                                ("B", q.Option2, "kh-blue",   "diamond"),
                                                ("C", q.Option3, "kh-yellow", "circle"),
                                                ("D", q.Option4, "kh-green",  "square"),
                                            };
                                        }
                                        @foreach (var (letter, text, color, shape) in khTiles)
                                        {
                                            <label class="kh-tile @color">
                                                <input type="radio" name="Answer_@q.QuestionID" value="@letter" />
                                                <span class="kh-shape kh-shape-@shape"></span>
                                                <span class="kh-tile-text">@text</span>
                                            </label>
                                        }
                                    </div>

                                    <input type="hidden" name="TimeUsed_@q.QuestionID" value="0" data-time-for="@q.QuestionID" />

                                    <div class="kh-actions">
                                        @if (i < Model.Questions.Count - 1)
                                        {
                                            <button type="button" class="kh-btn-next" data-action="next">NEXT →</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="kh-btn-submit">FINISH! ✓</button>
                                        }
                                    </div>
                                </div>
                            }
                        </form>
                    </div>
                </div>

                <style>
                    .kh-quiz { font-family: 'Montserrat', system-ui, sans-serif; }
                    .kh-stage {
                        position: relative; overflow: hidden;
                        min-height: 85vh; padding: 30px 40px;
                        border-radius: 22px; color: #fff;
                        background: linear-gradient(135deg, #46178f 0%, #6b1cae 40%, #864cd1 100%);
                    }
                    .kh-blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .45; pointer-events: none; }
                    .kh-blob-a { width: 320px; height: 320px; background: #ff5a8c; top: -80px; right: -80px; }
                    .kh-blob-b { width: 260px; height: 260px; background: #00d4ff; bottom: -60px; left: 10%; }
                    .kh-blob-c { width: 200px; height: 200px; background: #ffd400; top: 30%; right: 30%; opacity: .25; }

                    .kh-top {
                        position: relative; display: flex; justify-content: space-between;
                        align-items: center; gap: 16px; margin-bottom: 18px;
                    }
                    .kh-pill {
                        font-weight: 700; font-size: 14px; background: rgba(255,255,255,.18);
                        padding: 10px 18px; border-radius: 999px; backdrop-filter: blur(8px);
                    }
                    .kh-pill span { background: #ffd400; color: #46178f; padding: 2px 8px; border-radius: 6px; margin-right: 8px; font-weight: 900; }
                    .kh-score-wrap { text-align: right; }
                    .kh-score-label { font-size: 11px; letter-spacing: 3px; opacity: .8; font-weight: 700; }
                    .kh-score { font-size: 36px; font-weight: 900; line-height: 1; }

                    .kh-progress { position: relative; display: flex; gap: 6px; margin-bottom: 24px; }
                    .kh-step { flex: 1; height: 5px; border-radius: 3px; background: rgba(255,255,255,.2); transition: background .25s; }
                    .kh-step.done { background: #ffd400; }
                    .kh-step.current { background: #fff; box-shadow: 0 0 12px rgba(255,255,255,.7); }

                    .kh-slide { position: relative; display: none; animation: khFade .35s ease; }
                    .kh-slide.active { display: block; }
                    @@keyframes khFade { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }

                    .kh-qbox {
                        background: rgba(255,255,255,.96); color: #1a103d;
                        padding: 28px 32px; border-radius: 18px; margin-bottom: 20px;
                        box-shadow: 0 10px 30px rgba(0,0,0,.2);
                    }
                    .kh-qnum { font-size: 13px; letter-spacing: 2px; color: #864cd1; font-weight: 900; margin-bottom: 8px; }
                    .kh-qtext { font-size: 26px; font-weight: 900; line-height: 1.3; }

                    .kh-timer-row { display: flex; justify-content: center; margin-bottom: 18px; position: relative; }
                    .kh-timer {
                        width: 70px; height: 70px; border-radius: 50%;
                        background: #ffd400; color: #46178f;
                        display: flex; align-items: center; justify-content: center;
                        font-size: 32px; font-weight: 900;
                        box-shadow: 0 6px 20px rgba(255,212,0,.5);
                        animation: khPulse 1s ease-in-out infinite;
                    }
                    @@keyframes khPulse { 50% { transform: scale(1.06); } }
                    .kh-timer.danger { background: #ff3355; color: #fff; box-shadow: 0 6px 20px rgba(255,51,85,.6); }

                    .kh-tiles {
                        display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
                        margin-bottom: 20px;
                    }
                    @@media (max-width: 600px) { .kh-tiles { grid-template-columns: 1fr; } }

                    .kh-tile {
                        position: relative; display: flex; align-items: center; gap: 16px;
                        padding: 24px 22px; border-radius: 14px; cursor: pointer;
                        color: #fff; font-weight: 800; font-size: 18px;
                        transition: transform .15s, box-shadow .15s, filter .15s;
                        box-shadow: 0 6px 0 rgba(0,0,0,.18), 0 12px 22px rgba(0,0,0,.18);
                    }
                    .kh-tile:hover { transform: translateY(-2px); filter: brightness(1.06); }
                    .kh-tile:active { transform: translateY(2px); box-shadow: 0 2px 0 rgba(0,0,0,.18), 0 4px 10px rgba(0,0,0,.15); }
                    .kh-tile input { display: none; }
                    .kh-tile:has(input:checked) {
                        outline: 4px solid #fff; outline-offset: -4px;
                        transform: translateY(-2px) scale(1.02);
                    }

                    .kh-red    { background: #e21b3c; }
                    .kh-blue   { background: #1368ce; }
                    .kh-yellow { background: #d89e00; }
                    .kh-green  { background: #26890c; }

                    .kh-shape { display: inline-block; width: 30px; height: 30px; flex-shrink: 0; filter: drop-shadow(0 2px 3px rgba(0,0,0,.3)); }
                    .kh-shape-triangle { background: #fff; clip-path: polygon(50% 0%, 0% 100%, 100% 100%); }
                    .kh-shape-diamond  { background: #fff; clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); }
                    .kh-shape-circle   { background: #fff; border-radius: 50%; }
                    .kh-shape-square   { background: #fff; border-radius: 4px; }
                    .kh-tile-text { line-height: 1.3; }

                    .kh-actions { display: flex; justify-content: flex-end; }
                    .kh-btn-next, .kh-btn-submit {
                        font-family: inherit; font-weight: 900; font-size: 16px; letter-spacing: 1px;
                        padding: 14px 32px; border: none; border-radius: 12px;
                        cursor: pointer; transition: all .15s;
                    }
                    .kh-btn-next { background: #ffd400; color: #46178f; box-shadow: 0 5px 0 rgba(0,0,0,.2); }
                    .kh-btn-next:hover { transform: translateY(-2px); box-shadow: 0 7px 0 rgba(0,0,0,.2); }
                    .kh-btn-submit { background: #00d68f; color: #fff; box-shadow: 0 5px 0 rgba(0,0,0,.2); }
                    .kh-btn-submit:hover { transform: translateY(-2px); box-shadow: 0 7px 0 rgba(0,0,0,.2); }
                </style>

                <script>
                    (function () {
                        const root = document.querySelector('.kh-quiz');
                        if (!root) return;
                        const slides = root.querySelectorAll('.kh-slide');
                        const steps = root.querySelectorAll('.kh-step');
                        const scoreEl = document.getElementById('khScore');
                        let idx = 0;
                        let seconds = 30;
                        let score = 0;
                        let timerId = null;
                        let enterAt = Date.now();

                        const renderTimer = () => {
                            const slide = slides[idx];
                            const t = slide.querySelector('[data-timer]');
                            if (!t) return;
                            t.querySelector('.kh-timer-num').textContent = seconds;
                            t.classList.toggle('danger', seconds <= 5);
                        };
                        const recordTime = () => {
                            const slide = slides[idx];
                            const qid = slide.dataset.qid;
                            const used = Math.min(30, Math.round((Date.now() - enterAt) / 1000));
                            const hidden = slide.querySelector(`[data-time-for="${qid}"]`);
                            if (hidden) hidden.value = used;
                            // Bump score if anything was selected for this question
                            const answered = slide.querySelector('input[type=radio]:checked');
                            if (answered) {
                                const bonus = 700 + Math.max(0, seconds) * 10;
                                score += bonus;
                                scoreEl.textContent = score.toLocaleString();
                            }
                        };
                        const startTimer = () => {
                            stopTimer();
                            seconds = 30;
                            enterAt = Date.now();
                            renderTimer();
                            timerId = setInterval(() => {
                                seconds--;
                                if (seconds <= 0) {
                                    seconds = 0;
                                    renderTimer();
                                    stopTimer();
                                    if (idx < slides.length - 1) show(idx + 1);
                                    return;
                                }
                                renderTimer();
                            }, 1000);
                        };
                        const stopTimer = () => { if (timerId) { clearInterval(timerId); timerId = null; } };
                        const show = (newIdx) => {
                            recordTime();
                            slides[idx].classList.remove('active');
                            steps[idx].classList.remove('current');
                            steps[idx].classList.add('done');
                            idx = newIdx;
                            slides[idx].classList.add('active');
                            steps[idx].classList.add('current');
                            startTimer();
                        };
                        steps[0]?.classList.add('current');
                        root.addEventListener('click', (e) => {
                            const btn = e.target.closest('[data-action]');
                            if (!btn) return;
                            if (btn.dataset.action === 'next' && idx < slides.length - 1) show(idx + 1);
                        });
                        document.getElementById('quizForm').addEventListener('submit', () => { recordTime(); stopTimer(); });
                        startTimer();
                    })();
                </script>
            }

            @* ============================================================== *@
            @* THEME — Forest — calming green, eye-comfortable                *@
            @* ============================================================== *@
            else if (theme == "Forest")
            {
                <link href="https://fonts.googleapis.com/css2?family=Lora:wght@@500;700&family=Inter:wght@@400;600&display=swap" rel="stylesheet" />

                <div class="fr-quiz">
                    <div class="fr-stage">
                        <svg class="fr-leaf fr-leaf-1" viewBox="0 0 80 80"><path d="M40 5 Q70 30 40 75 Q10 30 40 5" fill="#7ba05b" opacity=".4"/></svg>
                        <svg class="fr-leaf fr-leaf-2" viewBox="0 0 80 80"><path d="M40 5 Q70 30 40 75 Q10 30 40 5" fill="#a3c585" opacity=".5"/></svg>
                        <svg class="fr-leaf fr-leaf-3" viewBox="0 0 80 80"><path d="M40 5 Q70 30 40 75 Q10 30 40 5" fill="#5d7d3e" opacity=".35"/></svg>

                        <div class="fr-card">
                            <div class="fr-pill">🌿 @subject</div>
                            <h2 class="fr-title">@Model.CurrentQuiz.Title</h2>

                            <div class="fr-progress">
                                <span class="fr-progress-text" id="frCount">Q 1 of @Model.Questions.Count</span>
                                <div class="fr-progress-bar"><div class="fr-progress-fill" id="frFill"></div></div>
                            </div>

                            <form method="post" id="quizForm">
                                <input type="hidden" name="SessionId" value="@Model.SessionId" />
                                @for (int i = 0; i < Model.Questions.Count; i++)
                                {
                                    var q = Model.Questions[i];
                                    <div class="fr-slide @(i == 0 ? "active" : "")" data-idx="@i" data-qid="@q.QuestionID">
                                        <h3 class="fr-qtext">@q.QuestionText</h3>
                                        <div class="fr-options">
                                            @foreach (var (l, t) in new[] { ("A", q.Option1), ("B", q.Option2), ("C", q.Option3), ("D", q.Option4) })
                                            {
                                                <label class="fr-option">
                                                    <input type="radio" name="Answer_@q.QuestionID" value="@l" />
                                                    <span class="fr-bullet">@l</span>
                                                    <span class="fr-text">@t</span>
                                                </label>
                                            }
                                        </div>
                                        <input type="hidden" name="TimeUsed_@q.QuestionID" value="0" data-time-for="@q.QuestionID" />
                                        <div class="fr-actions">
                                            @if (i > 0) { <button type="button" class="fr-btn fr-btn-ghost" data-action="prev">← Back</button> } else { <span></span> }
                                            @if (i < Model.Questions.Count - 1) { <button type="button" class="fr-btn fr-btn-primary" data-action="next">Next →</button> }
                                            else { <button type="submit" class="fr-btn fr-btn-finish">🌳 Finish</button> }
                                        </div>
                                    </div>
                                }
                            </form>
                        </div>
                    </div>
                </div>

                <style>
                    .fr-quiz { font-family: 'Inter', sans-serif; }
                    .fr-stage {
                        position: relative; overflow: hidden;
                        min-height: 78vh; padding: 50px 20px;
                        border-radius: 22px;
                        background: linear-gradient(135deg, #d8e8c4 0%, #f0ebd8 60%, #e9d6b6 100%);
                        display: flex; align-items: center; justify-content: center;
                    }
                    .fr-leaf { position: absolute; pointer-events: none; }
                    .fr-leaf-1 { width: 200px; height: 200px; top: -40px; left: -40px; transform: rotate(-20deg); }
                    .fr-leaf-2 { width: 140px; height: 140px; bottom: 20px; right: 60px; transform: rotate(140deg); }
                    .fr-leaf-3 { width: 110px; height: 110px; top: 40%; left: 8%; transform: rotate(70deg); }

                    .fr-card {
                        position: relative; z-index: 1; width: 100%; max-width: 620px;
                        background: #fdfbf3; border-radius: 22px; padding: 36px 38px;
                        box-shadow: 0 12px 40px rgba(46, 64, 28, .15);
                        border: 1px solid rgba(125, 96, 60, .15);
                    }
                    .fr-pill {
                        display: inline-block; background: #2d5016; color: #fdfbf3;
                        padding: 5px 14px; border-radius: 999px; font-size: 12px; font-weight: 700;
                        margin-bottom: 12px;
                    }
                    .fr-title { font-family: 'Lora', serif; font-size: 28px; font-weight: 700; color: #2d3a18; margin: 0 0 18px; line-height: 1.3; }

                    .fr-progress { display: flex; flex-direction: column; gap: 6px; margin-bottom: 22px; }
                    .fr-progress-text { font-size: 12px; color: #6b5a3a; font-weight: 600; letter-spacing: .5px; }
                    .fr-progress-bar { height: 8px; background: rgba(45, 80, 22, .15); border-radius: 4px; overflow: hidden; }
                    .fr-progress-fill { height: 100%; background: linear-gradient(90deg, #7ba05b, #2d5016); border-radius: 4px; transition: width .35s; }

                    .fr-slide { display: none; animation: frFade .35s ease; }
                    .fr-slide.active { display: block; }
                    @@keyframes frFade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

                    .fr-qtext { font-family: 'Lora', serif; font-size: 20px; color: #2d3a18; font-weight: 700; margin: 0 0 20px; line-height: 1.5; }
                    .fr-options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
                    .fr-option {
                        display: flex; align-items: center; gap: 14px;
                        padding: 14px 18px; background: #fff;
                        border: 2px solid #d4cba8; border-radius: 12px;
                        cursor: pointer; transition: all .18s;
                    }
                    .fr-option:hover { border-color: #7ba05b; transform: translateX(3px); }
                    .fr-option input { display: none; }
                    .fr-bullet {
                        width: 32px; height: 32px; border-radius: 50%;
                        background: #e6dcc0; color: #5d7d3e;
                        display: flex; align-items: center; justify-content: center;
                        font-weight: 700; font-size: 14px; transition: all .15s;
                    }
                    .fr-text { font-size: 15px; color: #3a3520; flex: 1; }
                    .fr-option:has(input:checked) {
                        border-color: #2d5016; background: #ecf2dd;
                        box-shadow: 0 4px 14px rgba(45, 80, 22, .2);
                    }
                    .fr-option:has(input:checked) .fr-bullet { background: #2d5016; color: #fff; }

                    .fr-actions { display: flex; justify-content: space-between; gap: 10px; }
                    .fr-btn { font-family: inherit; padding: 11px 24px; border-radius: 12px; border: none; font-weight: 700; cursor: pointer; transition: all .15s; font-size: 14px; }
                    .fr-btn-ghost { background: rgba(125, 96, 60, .12); color: #5d4a2a; }
                    .fr-btn-ghost:hover { background: rgba(125, 96, 60, .2); }
                    .fr-btn-primary { background: linear-gradient(135deg, #7ba05b, #2d5016); color: #fff; box-shadow: 0 4px 12px rgba(45, 80, 22, .3); }
                    .fr-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(45, 80, 22, .45); }
                    .fr-btn-finish { background: linear-gradient(135deg, #d18b3a, #8e5a14); color: #fff; box-shadow: 0 4px 12px rgba(142, 90, 20, .3); }
                    .fr-btn-finish:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(142, 90, 20, .45); }
                </style>

                <script>
                    (function () {
                        const root = document.querySelector('.fr-quiz'); if (!root) return;
                        const slides = root.querySelectorAll('.fr-slide');
                        const fill = document.getElementById('frFill');
                        const count = document.getElementById('frCount');
                        const total = slides.length; let idx = 0; let enterAt = Date.now();
                        const render = () => { fill.style.width = ((idx + 1) / total * 100) + '%'; count.textContent = `Q ${idx + 1} of ${total}`; };
                        const recordTime = () => { const s = slides[idx]; const qid = s.dataset.qid; const h = s.querySelector(`[data-time-for="${qid}"]`); if (h) h.value = (parseInt(h.value, 10) || 0) + Math.round((Date.now() - enterAt) / 1000); };
                        const show = (n) => { recordTime(); slides[idx].classList.remove('active'); idx = n; slides[idx].classList.add('active'); enterAt = Date.now(); render(); };
                        root.addEventListener('click', (e) => { const b = e.target.closest('[data-action]'); if (!b) return;
                            if (b.dataset.action === 'next' && idx < total - 1) show(idx + 1);
                            if (b.dataset.action === 'prev' && idx > 0) show(idx - 1);
                        });
                        document.getElementById('quizForm').addEventListener('submit', recordTime);
                        render();
                    })();
                </script>
            }

            @* ============================================================== *@
            @* THEME — Comic — pop-art comic book                             *@
            @* ============================================================== *@
            else if (theme == "Comic")
            {
                <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Permanent+Marker&family=Comic+Neue:wght@@400;700&display=swap" rel="stylesheet" />

                <div class="cm-quiz">
                    <div class="cm-stage">
                        <div class="cm-burst cm-burst-1">POW!</div>
                        <div class="cm-burst cm-burst-2">BAM!</div>
                        <div class="cm-burst cm-burst-3">ZAP!</div>

                        <div class="cm-card">
                            <div class="cm-cap">@subject</div>
                            <h2 class="cm-title">@Model.CurrentQuiz.Title</h2>

                            <div class="cm-progress">
                                @for (int i = 0; i < Model.Questions.Count; i++)
                                {
                                    <span class="cm-dot" data-dot="@i"></span>
                                }
                            </div>

                            <form method="post" id="quizForm">
                                <input type="hidden" name="SessionId" value="@Model.SessionId" />

                                @for (int i = 0; i < Model.Questions.Count; i++)
                                {
                                    var q = Model.Questions[i];
                                    <div class="cm-slide @(i == 0 ? "active" : "")" data-idx="@i" data-qid="@q.QuestionID">
                                        <div class="cm-bubble">
