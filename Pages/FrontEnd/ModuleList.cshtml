@page
@model APMoodle.Pages.BackEnd.ModuleListModel
@{
    ViewData["Title"] = "Module Management";
}

<head>
    <link rel="stylesheet" href="~/css/moduleList.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<form method="post" id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="module-page">
    <!-- Header -->
    <div class="module-header-section">
        <h1><i class="bi bi-journals"></i> Module Management</h1>
        <p class="module-subtitle">Manage all modules in the system</p>
    </div>

    <!-- Stats -->
    <div class="module-stats-grid">
        <div class="module-stat-card">
            <div class="stat-number" id="totalCount">@Model.TotalCount</div>
            <div class="stat-label">Total Modules</div>
        </div>
        <div class="module-stat-card">
            <div class="stat-number" id="filteredCount">@Model.TotalCount</div>
            <div class="stat-label">Filtered Results</div>
        </div>
        <div class="module-stat-card">
            <div class="stat-number" id="activeCount">@Model.ActiveCount</div>
            <div class="stat-label">Active Modules</div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="module-action-bar">
        <div class="search-filter-group">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="searchInput" placeholder="Search modules..." />
            </div>
            <select id="filterStatus" class="filter-select">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="removed">Removed</option>
            </select>
            <select id="filterLecturer" class="filter-select">
                <option value="all">All Lecturers</option>
                @if (Model.UniqueLecturers != null && Model.UniqueLecturers.Any())
                {
                    @foreach (var lecturer in Model.UniqueLecturers)
                    {
                        <option value="@lecturer">@lecturer</option>
                    }
                }
            </select>
        </div>
        <button class="create-btn" id="createModuleBtn">
            <span>+</span> Create Module
        </button>
    </div>

    <!-- Table -->
    <div class="module-table-container">
        <table class="module-table" id="moduleTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Lecturer</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Progress Status</th>
                    <th class="actions-header">Actions</th>
                </tr>
            </thead>
            <tbody id="moduleTableBody">
                @if (Model.Modules != null && Model.Modules.Any())
                {
                    @foreach (var item in Model.Modules)
                    {
                        var module = item.Module;
                        <tr data-id="@module.ModuleID" 
                            data-lecturer="@(module.Lecturer?.Name ?? "Unknown")"
                            data-status="@module.Status">
                            <td class="code-cell">@module.ModuleCode</td>
                            <td class="title-cell">@module.Name</td>
                            <td class="lecturer-cell">@(module.Lecturer?.Name ?? "Unknown")</td>
                            <td class="lecturer-cell">@module.StartDate.ToString("MMM dd, yyyy")</td>
                            <td class="lecturer-cell">@module.EndDate.ToString("MMM dd, yyyy")</td>
                            <td class="status-cell">
                                @{
                                    var status = item.DisplayStatus;
                                    var badgeClass = status == "In Progress" || status == "Active" 
                                        ? "badge-status-active" 
                                        : (status == "Removed" ? "badge-status-removed" : "badge-status-expired");
                                }
                                <span class="badge @badgeClass">@status</span>
                            </td>
                            <td class="action-cell">
                                <div class="action-buttons-wrapper">
                                    <button class="action-btn view-btn" data-id="@module.ModuleID" title="View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="action-btn edit-btn" data-id="@module.ModuleID" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="action-btn delete-btn" data-id="@module.ModuleID" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="7" class="empty-message">
                            No modules found. Click "Create Module" to add one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- View Details Modal -->
<div id="moduleModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-header-title">
                <i class="bi bi-book"></i>
                <h3 id="modalTitle">Module Details</h3>
            </div>
            <span class="modal-close">&times;</span>
        </div>
        <div class="modal-body">
            <div id="modalContent"></div>
        </div>
        <div class="modal-footer">
            <button id="modalViewBtn" class="btn-secondary">View</button>
            <button id="modalCloseBtn" class="btn-secondary">Close</button>
        </div>
    </div>
</div>

<script src="~/js/moduleList.js"></script>