@page
@model APMoodle.Pages.BackEnd.UserEditModel
@{
    ViewData["Title"] = "Edit User";
}

<head>
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/userEdit.css" />
</head>

<form method="post" id="editForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    
    <div class="edit-user-container">
        <div class="edit-user-header">
            <h1>Edit User</h1>
            <p>Update user information for <strong>@Model.UserName</strong></p>
        </div>

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="UserType" />
        <input type="hidden" asp-for="UserCode" />
        <input type="hidden" asp-for="CurrentProfilePic" />

        <!-- Validation Summary -->
        <div class="validation-summary" id="validationSummary">
            <h4><i class="bi bi-exclamation-circle"></i> Please fix the following errors:</h4>
            <ul id="validationList"></ul>
        </div>

        <!-- Avatar Upload Section -->
        <div class="avatar-upload" id="avatarUpload">
            <div class="preview-container">
                <img src="" alt="Profile" class="avatar-preview" id="avatarPreview" />
                <div class="avatar-placeholder" id="avatarPlaceholder" style="background-color: @Model.AvatarColor;">
                    @Model.Initials
                </div>
                <button type="button" class="remove-image-btn" id="removeImageBtn" title="Remove image">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="avatar-upload-info">
                <label>Profile Picture</label>
                <div class="file-input-wrapper">
                    <span class="file-input-label">
                        <i class="bi bi-upload"></i> Choose Image
                    </span>
                    <input type="file" id="ProfileImage" name="ProfileImage" accept="image/png,image/jpeg,image/jpg,image/gif,image/webp" />
                </div>
                <div class="file-name" id="fileName">
                    <i class="bi bi-info-circle"></i> No file selected
                </div>
                <div class="file-hint">
                    Supported formats: PNG, JPG, JPEG, GIF, WEBP (Max: 5MB)
                </div>
                <button type="button" class="clear-image-btn" id="clearImageBtn">
                    <i class="bi bi-trash"></i> Remove current image
                </button>
            </div>
        </div>

        <!-- User Info -->
        <div class="form-row">
            <div class="form-group" id="nameGroup">
                <label for="Name">Full Name <span class="required">*</span></label>
                <input type="text" id="Name" asp-for="Name" placeholder="Enter full name" />
                <div class="error-message" id="nameError">Please enter a valid name (at least 2 characters).</div>
                <div class="validation-success" id="nameSuccess"><i class="bi bi-check-circle"></i> Valid</div>
            </div>
            <div class="form-group" id="emailGroup">
                <label for="Email">Email <span class="required">*</span></label>
                <input type="email" id="Email" asp-for="Email" placeholder="Enter email address" />
                <div class="error-message" id="emailError">Please enter a valid email address.</div>
                <div class="validation-success" id="emailSuccess"><i class="bi bi-check-circle"></i> Valid</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group" id="phoneGroup">
                <label for="PhoneNumber">Phone Number <span class="required">*</span></label>
                <input type="tel" id="PhoneNumber" asp-for="PhoneNumber" placeholder="e.g., 0123456789" />
                <div class="error-message" id="phoneError">Please enter a valid phone number (10 digits, starting with 0).</div>
                <div class="validation-success" id="phoneSuccess"><i class="bi bi-check-circle"></i> Valid</div>
            </div>
            <div class="form-group" id="genderGroup">
                <label for="Gender">Gender <span class="required">*</span></label>
                <select id="Gender" asp-for="Gender">
                    <option value="">Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <div class="error-message" id="genderError">Please select a gender.</div>
                <div class="validation-success" id="genderSuccess"><i class="bi bi-check-circle"></i> Valid</div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group" id="dobGroup">
                <label for="DOB">Date of Birth <span class="required">*</span></label>
                <input type="date" id="DOB" asp-for="DOB" />
                <div class="error-message" id="dobError">Please select a valid date of birth (must be 5-120 years old).</div>
                <div class="validation-success" id="dobSuccess"><i class="bi bi-check-circle"></i> Valid</div>
            </div>
            <div class="form-group">
                <label for="Status">Status</label>
                <select id="Status" asp-for="Status">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
        </div>

        @if (Model.UserType == "Lecturer")
        {
            <div class="form-group" id="departmentGroup">
                <label for="Department">Department <span class="required">*</span></label>
                <input type="text" id="Department" asp-for="Department" placeholder="Enter department" />
                <div class="error-message" id="departmentError">Please enter a department.</div>
                <div class="validation-success" id="departmentSuccess"><i class="bi bi-check-circle"></i> Valid</div>
            </div>
        }

        <div class="form-actions">
            <button type="button" class="btn-cancel" id="cancelBtn">
                <i class="bi bi-x-circle"></i> Cancel
            </button>
            <button type="submit" class="btn-save" id="saveBtn">
                <i class="bi bi-save"></i> Save Changes
            </button>
        </div>
    </div>
</form>

<!-- Success Modal -->
@if (TempData["ShowSuccessModal"] != null && (bool)TempData["ShowSuccessModal"])
{
    <div id="successModal" class="modal-overlay-full show">
        <div class="modal-container">
            <div class="modal-icon success-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h3 class="modal-title">Success!</h3>
            <p class="modal-message">@TempData["SuccessMessage"]</p>
            <div class="modal-actions">
                <button class="modal-btn modal-success" id="successModalBtn">
                    <i class="bi bi-check-circle"></i> Continue
                </button>
            </div>
        </div>
    </div>
}

<!-- Error Modal -->
@if (TempData["ShowErrorModal"] != null && (bool)TempData["ShowErrorModal"])
{
    <div id="errorModal" class="modal-overlay-full show">
        <div class="modal-container">
            <div class="modal-icon error-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3 class="modal-title">Error!</h3>
            <p class="modal-message">@TempData["ErrorMessage"]</p>
            <div class="modal-actions">
                <button class="modal-btn modal-danger" id="errorModalBtn">
                    <i class="bi bi-check-circle"></i> OK
                </button>
            </div>
        </div>
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Get elements
        const fileInput = document.getElementById('ProfileImage');
        const fileName = document.getElementById('fileName');
        const preview = document.getElementById('avatarPreview');
        const placeholder = document.getElementById('avatarPlaceholder');
        const removeImageBtn = document.getElementById('removeImageBtn');
        const clearImageBtn = document.getElementById('clearImageBtn');
        const hiddenProfilePic = document.getElementById('CurrentProfilePic');
        const avatarUpload = document.getElementById('avatarUpload');
        const form = document.getElementById('editForm');
        const saveBtn = document.getElementById('saveBtn');

        // Form fields for validation
        const nameInput = document.getElementById('Name');
        const emailInput = document.getElementById('Email');
        const phoneInput = document.getElementById('PhoneNumber');
        const genderSelect = document.getElementById('Gender');
        const dobInput = document.getElementById('DOB');
        const departmentInput = document.getElementById('Department');

        // Check if there's an existing profile picture
        const existingImage = '@Model.ProfilePic';
        if (existingImage) {
            preview.src = existingImage;
            preview.classList.add('show');
            placeholder.classList.add('hide');
            removeImageBtn.classList.add('show');
            clearImageBtn.classList.add('show');
        }

        // ============ VALIDATION FUNCTIONS ============

        // Validate Name
        function validateName() {
            const group = document.getElementById('nameGroup');
            const error = document.getElementById('nameError');
            const success = document.getElementById('nameSuccess');
            const value = nameInput.value.trim();
            
            if (value.length < 2) {
                group.classList.add('has-error');
                error.classList.add('show');
                success.classList.remove('show');
                return false;
            } else {
                group.classList.remove('has-error');
                error.classList.remove('show');
                success.classList.add('show');
                return true;
            }
        }

        // Validate Email
        function validateEmail() {
            const group = document.getElementById('emailGroup');
            const error = document.getElementById('emailError');
            const success = document.getElementById('emailSuccess');
            const value = emailInput.value.trim();
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            
            if (!emailPattern.test(value)) {
                group.classList.add('has-error');
                error.classList.add('show');
                success.classList.remove('show');
                return false;
            } else {
                group.classList.remove('has-error');
                error.classList.remove('show');
                success.classList.add('show');
                return true;
            }
        }

        // Validate Phone Number (10 digits starting with 0)
        function validatePhone() {
            const group = document.getElementById('phoneGroup');
            const error = document.getElementById('phoneError');
            const success = document.getElementById('phoneSuccess');
            const value = phoneInput.value.trim();
            const phonePattern = /^0\d{9}$/;
            
            if (!phonePattern.test(value)) {
                group.classList.add('has-error');
                error.classList.add('show');
                success.classList.remove('show');
                return false;
            } else {
                group.classList.remove('has-error');
                error.classList.remove('show');
                success.classList.add('show');
                return true;
            }
        }

        // Validate Gender
        function validateGender() {
            const group = document.getElementById('genderGroup');
            const error = document.getElementById('genderError');
            const success = document.getElementById('genderSuccess');
            const value = genderSelect.value;
            
            if (!value) {
                group.classList.add('has-error');
                error.classList.add('show');
                success.classList.remove('show');
                return false;
            } else {
                group.classList.remove('has-error');
                error.classList.remove('show');
                success.classList.add('show');
                return true;
            }
        }

        // Validate Date of Birth
        function validateDOB() {
            const group = document.getElementById('dobGroup');
            const error = document.getElementById('dobError');
            const success = document.getElementById('dobSuccess');
            const value = dobInput.value;
            
            if (!value) {
                group.classList.add('has-error');
                error.classList.add('show');
                success.classList.remove('show');
                return false;
            }
            
            const dob = new Date(value);
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const monthDiff = today.getMonth() - dob.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                age--;
            }
            
            if (age < 5 || age > 120) {
                group.classList.add('has-error');
                error.textContent = 'Please select a valid date of birth (must be 5-120 years old).';
                error.classList.add('show');
                success.classList.remove('show');
                return false;
            } else {
                group.classList.remove('has-error');
                error.classList.remove('show');
                success.classList.add('show');
                return true;
            }
        }

        // Validate Department (for lecturers)
        function validateDepartment() {
            if (!departmentInput) return true;
            
            const group = document.getElementById('departmentGroup');
            const error = document.getElementById('departmentError');
            const success = document.getElementById('departmentSuccess');
            const value = departmentInput.value.trim();
            
            if (!value) {
                group.classList.add('has-error');
                error.classList.add('show');
                success.classList.remove('show');
                return false;
            } else {
                group.classList.remove('has-error');
                error.classList.remove('show');
                success.classList.add('show');
                return true;
            }
        }

        // ============ ATTACH VALIDATION EVENTS ============

        nameInput.addEventListener('input', validateName);
        nameInput.addEventListener('blur', validateName);

        emailInput.addEventListener('input', validateEmail);
        emailInput.addEventListener('blur', validateEmail);

        phoneInput.addEventListener('input', validatePhone);
        phoneInput.addEventListener('blur', validatePhone);

        genderSelect.addEventListener('change', validateGender);

        dobInput.addEventListener('change', validateDOB);
        dobInput.addEventListener('blur', validateDOB);

        if (departmentInput) {
            departmentInput.addEventListener('input', validateDepartment);
            departmentInput.addEventListener('blur', validateDepartment);
        }

        // ============ FORM VALIDATION ON SUBMIT ============

        form.addEventListener('submit', function(e) {
            // Run all validations
            const isNameValid = validateName();
            const isEmailValid = validateEmail();
            const isPhoneValid = validatePhone();
            const isGenderValid = validateGender();
            const isDOBValid = validateDOB();
            const isDepartmentValid = departmentInput ? validateDepartment() : true;

            // Collect errors
            const errors = [];
            if (!isNameValid) errors.push('Please enter a valid name (at least 2 characters).');
            if (!isEmailValid) errors.push('Please enter a valid email address.');
            if (!isPhoneValid) errors.push('Please enter a valid phone number (10 digits, starting with 0).');
            if (!isGenderValid) errors.push('Please select a gender.');
            if (!isDOBValid) errors.push('Please select a valid date of birth (must be 5-120 years old).');
            if (!isDepartmentValid) errors.push('Please enter a department.');

            if (errors.length > 0) {
                e.preventDefault();
                
                // Show validation summary
                const summary = document.getElementById('validationSummary');
                const list = document.getElementById('validationList');
                list.innerHTML = errors.map(err => `<li>${err}</li>`).join('');
                summary.classList.add('show');
                
                // Scroll to the first error
                const firstErrorField = document.querySelector('.form-group.has-error');
                if (firstErrorField) {
                    firstErrorField.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    const input = firstErrorField.querySelector('input, select');
                    if (input) input.focus();
                }
                
                return false;
            }
            
            // Clear validation summary on successful validation
            document.getElementById('validationSummary').classList.remove('show');
            return true;
        });

        // Clear validation summary when user starts typing
        document.querySelectorAll('input, select').forEach(function(element) {
            element.addEventListener('input', function() {
                document.getElementById('validationSummary').classList.remove('show');
            });
            element.addEventListener('change', function() {
                document.getElementById('validationSummary').classList.remove('show');
            });
        });

        // ============ SUCCESS/ERROR MODALS ============

        const successModalBtn = document.getElementById('successModalBtn');
        if (successModalBtn) {
            successModalBtn.addEventListener('click', function() {
                window.location.href = '/FrontEnd/UserList';
            });
        }

        const errorModalBtn = document.getElementById('errorModalBtn');
        if (errorModalBtn) {
            errorModalBtn.addEventListener('click', function() {
                document.getElementById('errorModal').classList.remove('show');
            });
        }

        document.querySelectorAll('.modal-overlay-full').forEach(function(modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    if (this.id === 'successModal') {
                        window.location.href = '/FrontEnd/UserList';
                    } else {
                        this.classList.remove('show');
                    }
                }
            });
        });

        // ============ CANCEL BUTTON ============

        const cancelBtn = document.getElementById('cancelBtn');
        if (cancelBtn) {
            cancelBtn.addEventListener('click', function(e) {
                e.preventDefault();
                showCancelConfirmModal();
            });
        }

        function showCancelConfirmModal() {
            let modal = document.getElementById('cancelConfirmModal');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'cancelConfirmModal';
                modal.className = 'modal-overlay-full';
                modal.style.display = 'none';
                modal.innerHTML = `
                    <div class="modal-container">
                        <div class="modal-icon" style="color: #f59e0b;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <h3 class="modal-title">Cancel Edit</h3>
                        <p class="modal-message">Are you sure you want to cancel? Any unsaved changes will be lost.</p>
                        <div class="modal-actions">
                            <button class="modal-btn modal-cancel" id="cancelStayBtn">Stay</button>
                            <button class="modal-btn modal-danger" id="cancelLeaveBtn">Leave</button>
                        </div>
                    </div>
                `;
                document.body.appendChild(modal);
            }

            modal.style.display = 'flex';
            modal.classList.add('show');

            document.getElementById('cancelStayBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
            };

            document.getElementById('cancelLeaveBtn').onclick = function() {
                modal.classList.remove('show');
                modal.style.display = 'none';
                window.location.href = '/FrontEnd/UserList';
            };

            modal.onclick = function(e) {
                if (e.target === this) {
                    this.classList.remove('show');
                    this.style.display = 'none';
                }
            };
        }

        // ============ AVATAR UPLOAD ============

        function showPreview(imageSrc) {
            preview.src = imageSrc;
            preview.classList.add('show');
            placeholder.classList.add('hide');
            removeImageBtn.classList.add('show');
            clearImageBtn.classList.add('show');
        }

        function hidePreview() {
            preview.src = '';
            preview.classList.remove('show');
            placeholder.classList.remove('hide');
            removeImageBtn.classList.remove('show');
            clearImageBtn.classList.remove('show');
            hiddenProfilePic.value = '';
        }

        fileInput.addEventListener('change', function(e) {
            const file = this.files[0];
            if (file) {
                const validTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/gif', 'image/webp'];
                const fileType = file.type.toLowerCase();
                if (!validTypes.includes(fileType)) {
                    alert('Please select a valid image file (PNG, JPG, JPEG, GIF, or WEBP).');
                    this.value = '';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    alert('Image size must be less than 5MB.');
                    this.value = '';
                    return;
                }

                const fileSize = (file.size / 1024).toFixed(1);
                fileName.innerHTML = `<i class="bi bi-check-circle" style="color: #22c55e;"></i> ${file.name} (${fileSize} KB)`;

                const reader = new FileReader();
                reader.onload = function(e) {
                    showPreview(e.target.result);
                };
                reader.readAsDataURL(file);
            } else {
                if (existingImage) {
                    showPreview(existingImage);
                } else {
                    hidePreview();
                }
                fileName.innerHTML = '<i class="bi bi-info-circle"></i> No file selected';
            }
        });

        removeImageBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            hidePreview();
            fileInput.value = '';
            fileName.innerHTML = '<i class="bi bi-info-circle"></i> No file selected';
            hiddenProfilePic.value = '';
        });

        clearImageBtn.addEventListener('click', function() {
            hidePreview();
            fileInput.value = '';
            fileName.innerHTML = '<i class="bi bi-info-circle"></i> No file selected';
            hiddenProfilePic.value = '';
        });

        avatarUpload.addEventListener('dragover', function(e) {
            e.preventDefault();
            this.classList.add('dragover');
        });

        avatarUpload.addEventListener('dragleave', function(e) {
            e.preventDefault();
            this.classList.remove('dragover');
        });

        avatarUpload.addEventListener('drop', function(e) {
            e.preventDefault();
            this.classList.remove('dragover');
            
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                fileInput.dispatchEvent(new Event('change'));
            }
        });
    });
</script>