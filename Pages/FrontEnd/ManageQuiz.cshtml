@page "{id:int}"
@model APMoodle.Pages.BackEnd.ManageQuizModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.CurrentQuiz?.Title ?? "Manage Quiz";
}

@*
    Front-end / styling: Moses
    Backend contract:
      Model.CurrentQuiz   — Quiz (Title, Subject, Theme, CreatedAt, MaterialID)
      Model.Questions     — ordered List<Question> with correct answer visible
      Model.MaterialId    — int, for back link
      Model.Message       — string, nullable error
    Actions:
      Edit       → link to /FrontEnd/EditQuiz/{quizId}
      Delete     → POST handler "Delete" on this page (named handler)
                   triggers IQuizService.DeleteQuizAsync, cascades to Questions/Sessions/Results
*@

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
        <p class="path">Lecturer Dashboard &gt; Manage Quiz</p>
    </div>

    <div class="PageComponent">
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert">@Model.Message</div>
        }

        @if (Model.CurrentQuiz != null)
        {
            <section class="quiz-meta">
                <p><strong>Subject:</strong> @Model.CurrentQuiz.Subject</p>
                <p><strong>Theme:</strong> @Model.CurrentQuiz.Theme</p>
                <p><strong>Created:</strong> @Model.CurrentQuiz.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                <p><strong>Questions:</strong> @Model.Questions.Count</p>
            </section>

            <section class="actions">
                <a href="/FrontEnd/EditQuiz/@Model.CurrentQuiz.QuizID">Edit Quiz</a>

                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.CurrentQuiz.QuizID"
                      onsubmit="return confirm('Delete this quiz? Student attempts and answers for it will also be removed. This cannot be undone.');"
                      style="display: inline;">
                    <button type="submit">Delete Quiz</button>
                </form>

                <a href="/FrontEnd/TeachingMaterialOverview/@Model.MaterialId">Back to Material</a>
            </section>

            <section class="questions">
                <h3>Questions</h3>
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <div class="question-card">
                        <h4>Q@(i + 1). @q.QuestionText</h4>
                        <p>A. @q.Option1</p>
                        <p>B. @q.Option2</p>
                        <p>C. @q.Option3</p>
                        <p>D. @q.Option4</p>
                        <p><strong>Correct answer: @q.CorrectAnswer</strong></p>
                    </div>
                }
            </section>
        }
    </div>
</div>
