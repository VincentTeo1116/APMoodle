@page "{id:int}"
@model APMoodle.Pages.BackEnd.ManageQuizModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage Quiz";

    var userRole = HttpContext.Session.GetString("UserRole") ?? "Guest";
    var isLecturer = userRole == "lecturer";
    var isAdmin = userRole == "admin";

    string ThemeName(string? t) => (t ?? "").Trim() switch
    {
        "Midterm"    => "Kahoot game show",
        "Forest"     => "Forest (calm green)",
        "Comic"      => "Comic (pop art)",
        "Watercolor" => "Watercolor (painterly)",
        "Default"    => "Default (clean glass)",
        _            => "Default (clean glass)"
    };
    string ThemeMini(string? t) => (t ?? "").Trim() switch
    {
        "Midterm"    => "kahoot",
        "Forest"     => "forest",
        "Comic"      => "comic",
        "Watercolor" => "water",
        _            => "studio"
    };
    var theme = Model.CurrentQuiz?.Theme ?? "";
    var mini = ThemeMini(theme);
}

<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>Manage Quiz</h1>
        <p class="path">@(char.ToUpper(userRole[0]) + userRole.Substring(1)) Dashboard &gt; @(Model.CurrentModule?.Name) &gt; @(Model.MaterialTitle ?? "Material") &gt; Manage Quiz</p>
    </div>

    <div class="PageComponent">
        <div class="mq-page">

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="mq-alert">@Model.Message</div>
            }

            @if (Model.CurrentQuiz != null)
            {
                <!-- ── Hero card ── -->
                <section class="mq-hero">
                    <div class="mq-hero-left">
                        <div class="mq-pill">@Model.CurrentQuiz.Subject</div>
                        <h2 class="mq-title">@Model.CurrentQuiz.Title</h2>

                        <div class="mq-meta">
                            <div class="mq-meta-item">
                                <span class="mq-meta-label">Theme</span>
                                <span class="mq-meta-val">@ThemeName(theme) <code>@(string.IsNullOrWhiteSpace(theme) ? "—" : theme)</code></span>
                            </div>
                            <div class="mq-meta-item">
                                <span class="mq-meta-label">Questions</span>
                                <span class="mq-meta-val">@Model.Questions.Count</span>
                            </div>
                            <div class="mq-meta-item">
                                <span class="mq-meta-label">Created</span>
                                <span class="mq-meta-val">@Model.CurrentQuiz.CreatedAt.ToString("dd MMM yyyy · HH:mm")</span>
                            </div>
                            <div class="mq-meta-item">
                                <span class="mq-meta-label">Quiz ID</span>
                                <span class="mq-meta-val">#@Model.CurrentQuiz.QuizID</span>
                            </div>
                            <div class="mq-meta-item">
                                <span class="mq-meta-label">Access</span>
                                <span class="mq-meta-val">
                                    @if (Model.CurrentQuiz.IsPublic)
                                    {
                                        <i class="bi bi-globe"> Public</i> 
                                    }
                                    else
                                    {
                                        <i class="bi bi-lock-fill"> Private</i> 
                                    }
                                </span>
                            </div>
                        </div>

                        <div class="mq-actions">
                            @if (isLecturer)
                            {
                                <a href="/FrontEnd/EditQuiz/@Model.CurrentQuiz.QuizID" class="mq-btn mq-btn-primary">
                                    <span class="mq-btn-icon"><i class="bi bi-pencil-square"></i></span> Edit Quiz
                                </a>
                                <a href="/FrontEnd/TeachingMaterialOverview/@Model.MaterialId" class="mq-btn mq-btn-ghost">
                                    <i class="bi bi-box-arrow-left"></i> Back to Material
                                </a>
                                <a asp-page="/FrontEnd/ViewQuizAttempts" asp-route-quizId="@Model.CurrentQuiz.QuizID" class="mq-btn mq-btn-info">
                                    <i class="bi bi-trophy"></i> View Students Attempts
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.CurrentQuiz.QuizID"
                                    onsubmit="return confirm('Delete this quiz?\n\nStudent attempts and answers for it will also be removed. This cannot be undone.');"
                                    class="mq-delete-form">
                                    <button type="button" class="mq-btn mq-btn-danger" onclick="showDeleteModal('quiz', @Model.CurrentQuiz.QuizID, '@Model.CurrentQuiz.Title')">
                                        <span class="mq-btn-icon"><i class="bi bi-trash3"></i></span> Delete Quiz
                                    </button>
                                </form>
                            }
                            else if (isAdmin)
                            {
                                <a href="/FrontEnd/TeachingMaterialOverview/@Model.MaterialId" class="mq-btn mq-btn-ghost">
                                    <i class="bi bi-box-arrow-left"></i> Back to Material
                                </a>
                                <a asp-page="/FrontEnd/ViewQuizAttempts" asp-route-quizId="@Model.CurrentQuiz.QuizID" class="mq-btn mq-btn-info">
                                    <i class="bi bi-trophy"></i> View Students Attempts
                                </a>
                            }
                        </div>
                    </div>

                    <div class="mq-hero-right">
                        <div class="mq-preview-label">Student preview</div>
                        @switch (mini)
                        {
                            case "studio":
                                <div class="mq-mini mq-mini-studio">
                                    <div class="mq-mini-studio-card">
                                        <span class="mq-mini-studio-dot"></span>
                                        <i class="mq-mini-studio-line"></i>
                                        <i class="mq-mini-studio-line short"></i>
                                        <i class="mq-mini-studio-pill"></i>
                                        <i class="mq-mini-studio-pill"></i>
                                    </div>
                                </div>
                                break;
                            case "forest":
                                <div class="mq-mini mq-mini-forest">
                                    <span class="mq-mini-leaf"></span>
                                    <div class="mq-mini-forest-card">
                                        <i class="mq-mini-forest-pill"></i>
                                        <i class="mq-mini-forest-row"></i>
                                        <i class="mq-mini-forest-row short"></i>
                                    </div>
                                </div>
                                break;
                            case "ocean":
                                <div class="mq-mini mq-mini-ocean">
                                    <svg viewBox="0 0 80 30" preserveAspectRatio="none" class="mq-mini-ocean-wave"><path d="M0,20 Q20,10 40,20 T80,20 L80,30 L0,30 Z" fill="#0077b6" opacity=".45"/></svg>
                                    <div class="mq-mini-ocean-card">
                                        <i class="mq-mini-ocean-row"></i>
                                        <i class="mq-mini-ocean-row short"></i>
                                    </div>
                                </div>
                                break;
                            case "sunset":
                                <div class="mq-mini mq-mini-sunset">
                                    <div class="mq-mini-sun"></div>
                                    <div class="mq-mini-sunset-card">
                                        <i class="mq-mini-sunset-row"></i>
                                        <i class="mq-mini-sunset-row short"></i>
                                    </div>
                                </div>
                                break;
                            case "corp":
                                <div class="mq-mini mq-mini-corp">
                                    <div class="mq-mini-corp-bar"></div>
                                    <div class="mq-mini-corp-rows"><i></i><i></i><i></i><i></i></div>
                                </div>
                                break;
                            case "office":
                                <div class="mq-mini mq-mini-office">
                                    <div class="mq-mini-office-card">
                                        <div class="mq-mini-office-band"></div>
                                        <i class="mq-mini-office-row"></i>
                                        <i class="mq-mini-office-row short"></i>
                                    </div>
                                </div>
                                break;
                            case "classic":
                                <div class="mq-mini mq-mini-classic">
                                    <div class="mq-mini-classic-card">
                                        <div class="mq-mini-classic-stripe"></div>
                                        <i class="mq-mini-classic-row"></i>
                                        <i class="mq-mini-classic-row short"></i>
                                    </div>
                                </div>
                                break;
                            case "comic":
                                <div class="mq-mini mq-mini-comic">
                                    <span class="mq-mini-comic-burst">POW!</span>
                                    <div class="mq-mini-comic-card">
                                        <i class="mq-mini-comic-bubble"></i>
                                        <div class="mq-mini-comic-grid">
                                            <span class="r"></span><span class="b"></span>
                                            <span class="y"></span><span class="g"></span>
                                        </div>
                                    </div>
                                </div>
                                break;
                            case "notebook":
                                <div class="mq-mini mq-mini-nb">
                                    <span class="mq-mini-nb-tape">📌</span>
                                    <div class="mq-mini-nb-lines"><i></i><i></i><i></i><i></i></div>
                                </div>
                                break;
                            case "galaxy":
                                <div class="mq-mini mq-mini-gx">
                                    <span class="mq-mini-gx-star s1"></span>
                                    <span class="mq-mini-gx-star s2"></span>
                                    <span class="mq-mini-gx-star s3"></span>
                                    <span class="mq-mini-gx-star s4"></span>
                                    <div class="mq-mini-gx-card">
                                        <i class="mq-mini-gx-row"></i>
                                        <i class="mq-mini-gx-row short"></i>
                                    </div>
                                </div>
                                break;
                            case "term":
                                <div class="mq-mini mq-mini-tm">
                                    <div class="mq-mini-tm-bar"><span></span><span></span><span></span></div>
                                    <div class="mq-mini-tm-body">
                                        <i class="mq-mini-tm-c">// q</i>
                                        <i class="mq-mini-tm-l">const x = "..";</i>
                                        <i class="mq-mini-tm-l short">[A] → "..";</i>
                                    </div>
                                </div>
                                break;
                            case "water":
                                <div class="mq-mini mq-mini-wc">
                                    <span class="mq-mini-wc-wash a"></span>
                                    <span class="mq-mini-wc-wash b"></span>
                                    <div class="mq-mini-wc-card">
                                        <i class="mq-mini-wc-row"></i>
                                        <i class="mq-mini-wc-row short"></i>
                                    </div>
                                </div>
                                break;
                            case "news":
                                <div class="mq-mini mq-mini-np">
                                    <div class="mq-mini-np-banner">TIMES</div>
                                    <div class="mq-mini-np-cols">
                                        <div><i></i><i class="short"></i><i></i></div>
                                        <div><i></i><i></i><i class="short"></i></div>
                                    </div>
                                </div>
                                break;
                            case "kahoot":
                                <div class="mq-mini mq-mini-kahoot">
                                    <div class="mq-mini-bar"></div>
                                    <div class="mq-mini-grid">
                                        <span class="t1"><b></b></span><span class="t2"><b></b></span>
                                        <span class="t3"><b></b></span><span class="t4"><b></b></span>
                                    </div>
                                </div>
                                break;
                            case "exam":
                                <div class="mq-mini mq-mini-exam">
                                    <div class="mq-mini-margin"></div>
                                    <div class="mq-mini-lines"><i></i><i></i><i></i><i></i><i></i></div>
                                </div>
                                break;
                            case "chat":
                                <div class="mq-mini mq-mini-chat">
                                    <div class="mq-mini-chathead"></div>
                                    <div class="mq-mini-bub mq-mini-bub-l"></div>
                                    <div class="mq-mini-bub mq-mini-bub-r"></div>
                                    <div class="mq-mini-bub mq-mini-bub-l short"></div>
                                </div>
                                break;
                            case "arcade":
                                <div class="mq-mini mq-mini-arcade">
                                    <div class="mq-mini-arc-title">ARCADE</div>
                                    <div class="mq-mini-arc-row"></div>
                                    <div class="mq-mini-arc-row short"></div>
                                    <div class="mq-mini-arc-row"></div>
                                </div>
                                break;
                        }
                    </div>
                </section>

                <!-- ── Questions list ── -->
                <section class="mq-card">
                    <header class="mq-card-head">
                        <div class="mq-card-icon"><i class="bi bi-patch-question"></i></div>
                        <div>
                            <h3>Questions <span class="mq-count">@Model.Questions.Count</span></h3>
                            <small>Correct answer is highlighted in green. Use <em>Edit Quiz</em> to change anything.</small>
                        </div>
                    </header>

                    @if (Model.Questions.Count == 0)
                    {
                        <div class="mq-empty">No questions yet — click <a href="/FrontEnd/EditQuiz/@Model.CurrentQuiz.QuizID">Edit Quiz</a> to add some.</div>
                    }
                    else
                    {
                        <ol class="mq-q-list">
                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                var q = Model.Questions[i];
                                <li class="mq-q" id="q-@(i + 1)">
                                    <div class="mq-q-head">
                                        <span class="mq-q-num">Q@(i + 1)</span>
                                        <span class="mq-q-correct">Correct: <b>@q.CorrectAnswer</b></span>
                                    </div>
                                    <div class="mq-q-text">@q.QuestionText</div>

                                    <div class="mq-q-options">
                                        @{
                                            var rows = new[]
                                            {
                                                ("A", q.Option1),
                                                ("B", q.Option2),
                                                ("C", q.Option3),
                                                ("D", q.Option4),
                                            };
                                        }
                                        @foreach (var (letter, text) in rows)
                                        {
                                            var isCorrect = string.Equals(q.CorrectAnswer?.Trim(), letter, StringComparison.OrdinalIgnoreCase);
                                            <div class="mq-q-opt @(isCorrect ? "ok" : "")">
                                                <span class="mq-q-opt-letter">@letter</span>
                                                <span class="mq-q-opt-text">@text</span>
                                                @if (isCorrect)
                                                {
                                                    <span class="mq-q-opt-tag"><i class="bi bi-check2-all"></i> correct</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </section>
            }
        </div>
    </div>
</div>

<form method="post" id="deleteQuizForm" asp-page-handler="Delete" asp-route-id="@Model.CurrentQuiz?.QuizID" style="display:none;">
    @Html.AntiForgeryToken()
</form>
<div id="deleteConfirmModal" class="modal-overlay-full" style="display: none;">
    <div class="modal-container">
        <div class="modal-icon warning-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h3 class="modal-title" id="deleteModalTitle">Confirm Delete</h3>
        <p class="modal-message" id="deleteModalMessage">Are you sure you want to delete this item?</p>
        <p id="deleteItemName" style="font-weight: 600; color: #ef4444; background: #fef2f2; padding: 10px; border-radius: 10px; margin: 16px 0;"></p>
        <div class="modal-warning">
            <i class="bi bi-shield-exclamation"></i>
            <span>This action cannot be undone.</span>
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-cancel" id="deleteCancelBtn">Cancel</button>
            <button class="modal-btn modal-danger" id="deleteConfirmBtn">Delete</button>
        </div>
    </div>
</div>

<script>
    (function() {
        let pendingAction = ''; 
        let pendingId = 0;
        let pendingName = '';

        const modal = document.getElementById('deleteConfirmModal');
        const modalTitle = document.getElementById('deleteModalTitle');
        const modalMessage = document.getElementById('deleteModalMessage');
        const itemName = document.getElementById('deleteItemName');
        const cancelBtn = document.getElementById('deleteCancelBtn');
        const confirmBtn = document.getElementById('deleteConfirmBtn');

        // Show modal with appropriate content
        window.showDeleteModal = function(action, id, name) {
            pendingAction = action;
            pendingId = id;
            pendingName = name;

            if (action === 'quiz') {
                modalTitle.textContent = 'Delete Quiz';
                modalMessage.textContent = 'Are you sure you want to delete this quiz? All student attempts and answers will also be removed.';
            } else if (action === 'question') {
                modalTitle.textContent = 'Remove Question';
                modalMessage.textContent = 'Are you sure you want to remove this question? Student answers for this question will also be deleted.';
            }
            itemName.textContent = `"${name}"`;
            modal.style.display = 'flex';
        };

        function closeModal() {
            modal.style.display = 'none';
            pendingAction = '';
            pendingId = 0;
            pendingName = '';
        }

        cancelBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeModal();
        });

        confirmBtn.addEventListener('click', function() {
            if (pendingAction === 'quiz') {
                document.getElementById('deleteQuizForm').submit();
            } else if (pendingAction === 'question') {
                document.getElementById('deleteQuestionIndex').value = pendingId;
                document.getElementById('deleteQuestionForm').submit();
            }
            closeModal();
        });
    })();
</script>

<style>
    .mq-page { max-width: 1100px; margin: 0 auto; padding: 8px 4px 60px; color: #1e293b; }
    .mq-alert { background: #fef3c7; border: 1px solid #fcd34d; color: #78350f; padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; font-size: 14px; }

    /* ── Hero ── */
    .mq-hero {
        display: grid; grid-template-columns: 1fr 200px; gap: 28px; align-items: center;
        background: linear-gradient(135deg, #ffffff 0%, #f0fdfa 100%);
        border: 1px solid #e2e8f0; border-radius: 16px;
        padding: 28px 32px; margin-bottom: 18px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, .04);
    }
    @@media (max-width: 720px) { .mq-hero { grid-template-columns: 1fr; } .mq-hero-right { justify-self: start; } }

    .mq-pill {
        display: inline-block; background: linear-gradient(135deg, #013D42, #037984);
        color: #fff; font-size: 11px; font-weight: 700;
        padding: 4px 12px; border-radius: 999px;
        letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 8px;
    }
    .mq-title { font-size: 30px; font-weight: 800; margin: 0 0 18px; color: #0f172a; line-height: 1.2; }

    .mq-meta {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px 24px; margin-bottom: 22px;
        padding: 14px 0; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;
    }
    .mq-meta-item { display: flex; flex-direction: column; gap: 2px; }
    .mq-meta-label { font-size: 11px; color: #94a3b8; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }
    .mq-meta-val { font-size: 14px; color: #0f172a; font-weight: 600; }
    .mq-meta-val code { background: #f1f5f9; color: #475569; padding: 1px 6px; border-radius: 4px; font-size: 11px; margin-left: 4px; font-weight: 600; }

    .mq-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .mq-delete-form { display: inline; margin: 0; padding: 0; }
    .mq-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 11px 22px; border-radius: 10px; border: none;
        font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none;
        transition: all .15s; font-family: inherit;
    }
    .mq-btn-icon { font-size: 15px; line-height: 1; }
    .mq-btn-primary {
        background: linear-gradient(135deg, #013D42, #037984); color: #fff;
        box-shadow: 0 4px 12px rgba(3, 121, 132, .3);
    }
    .mq-btn-primary:hover {
        transform: translateY(-1px); box-shadow: 0 6px 16px rgba(3, 121, 132, .4);
        background: linear-gradient(135deg, #012b2f, #025259); color: #fff;
    }
    .mq-btn-ghost { background: #f1f5f9; color: #475569; }
    .mq-btn-ghost:hover { background: #e2e8f0; color: #334155; }
    .mq-btn-info { background: #ecfaff; color: #1a4250; }
    .mq-btn-info:hover { background: #b7d6e4; color: #05161c; }
    .mq-btn-danger {
        background: #fef2f2; color: #b91c1c; border: 1.5px solid #fecaca;
    }
    .mq-btn-danger:hover { background: #dc2626; color: #fff; border-color: #dc2626; box-shadow: 0 4px 12px rgba(220, 38, 38, .3); }

    /* ── Theme preview thumbnail ── */
    .mq-hero-right { display: flex; flex-direction: column; gap: 6px; align-items: center; }
    .mq-preview-label { font-size: 11px; color: #94a3b8; font-weight: 600; letter-spacing: .5px; text-transform: uppercase; }

    .mq-mini {
        width: 180px; height: 122px; border-radius: 10px;
        overflow: hidden; position: relative; flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(15, 23, 42, .15), inset 0 0 0 1px rgba(0,0,0,.06);
    }

    /* Studio (default) mini */
    .mq-mini-studio { background: linear-gradient(135deg, #e0e7ff 0%, #f5d0fe 50%, #fce7f3 100%); display: flex; align-items: center; justify-content: center; }
    .mq-mini-studio .mq-mini-studio-card { width: 88%; background: rgba(255,255,255,.85); backdrop-filter: blur(4px); border-radius: 8px; padding: 10px 12px; box-shadow: 0 2px 8px rgba(99, 102, 241, .2); display: flex; flex-direction: column; gap: 5px; }
    .mq-mini-studio .mq-mini-studio-dot { width: 18px; height: 5px; background: linear-gradient(90deg, #6366f1, #a855f7); border-radius: 3px; }
    .mq-mini-studio .mq-mini-studio-line { background: #6366f1; height: 5px; border-radius: 2px; opacity: .85; }
    .mq-mini-studio .mq-mini-studio-line.short { width: 60%; opacity: .55; }
    .mq-mini-studio .mq-mini-studio-pill { height: 10px; border-radius: 5px; background: linear-gradient(90deg, rgba(99, 102, 241, .15), rgba(168, 85, 247, .15)); border: 1px solid rgba(99, 102, 241, .25); margin-top: 1px; }

    /* Forest mini */
    .mq-mini-forest { background: linear-gradient(135deg, #d8e8c4 0%, #f0ebd8 60%, #e9d6b6 100%); position: relative; padding: 10px; display: flex; align-items: center; justify-content: center; }
    .mq-mini-forest .mq-mini-leaf { position: absolute; top: 8px; left: 8px; width: 30px; height: 30px; background: #7ba05b; clip-path: polygon(50% 5%, 95% 50%, 50% 95%, 5% 50%); opacity: .6; transform: rotate(-20deg); }
    .mq-mini-forest .mq-mini-forest-card { background: #fdfbf3; border-radius: 7px; padding: 8px 10px; width: 80%; display: flex; flex-direction: column; gap: 4px; box-shadow: 0 2px 8px rgba(45, 80, 22, .25); }
    .mq-mini-forest .mq-mini-forest-pill { height: 7px; width: 30%; background: #2d5016; border-radius: 4px; }
    .mq-mini-forest .mq-mini-forest-row { height: 8px; background: rgba(45, 80, 22, .25); border-radius: 4px; }
    .mq-mini-forest .mq-mini-forest-row.short { width: 60%; }

    /* Ocean mini */
    .mq-mini-ocean { background: linear-gradient(180deg, #caf0f8 0%, #90e0ef 60%, #00b4d8 100%); position: relative; padding: 8px; display: flex; align-items: center; justify-content: center; }
    .mq-mini-ocean .mq-mini-ocean-wave { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 42px; }
    .mq-mini-ocean .mq-mini-ocean-card { background: #fff; border-radius: 7px; padding: 9px 12px; width: 80%; display: flex; flex-direction: column; gap: 5px; box-shadow: 0 2px 10px rgba(0, 71, 130, .25); position: relative; z-index: 1; }
