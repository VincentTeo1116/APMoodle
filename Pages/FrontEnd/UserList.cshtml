@page
@model APMoodle.Pages.BackEnd.UserListModel

@{
    ViewData["Title"] = "User Management";
}

<head>
    <link rel="stylesheet" href="~/css/user.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="~/js/user.js"></script>
</head>

<form method="post" id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="user-page">
    <!-- Header Section -->
    <div class="user-header-section">
        <h1><i class="bi bi-people"></i> User Management</h1>
        <p class="user-subtitle">Manage all users across the platform</p>
    </div>

    <!-- Stats Cards -->
    <div class="user-stats-grid">
        <div class="user-stat-card">
            <div class="stat-number" id="totalCount">@Model.TotalCount</div>
            <div class="stat-label">Total Users</div>
        </div>
        <div class="user-stat-card">
            <div class="stat-number" id="studentCount">@Model.StudentCount</div>
            <div class="stat-label">Students</div>
        </div>
        <div class="user-stat-card">
            <div class="stat-number" id="lecturerCount">@Model.LecturerCount</div>
            <div class="stat-label">Lecturers</div>
        </div>
        <div class="user-stat-card">
            <div class="stat-number" id="adminCount">@Model.AdminCount</div>
            <div class="stat-label">Admins</div>
        </div>
        <div class="user-stat-card">
            <div class="stat-number" id="filteredCount">@Model.TotalCount</div>
            <div class="stat-label">Filtered Results</div>
        </div>
    </div>

    <!-- Action Bar -->
    <div class="user-action-bar">
        <div class="search-filter-group">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="searchInput" placeholder="Search by name or email..." />
            </div>
            <select id="filterUserType" class="filter-select">
                <option value="all">All Users</option>
                <option value="student">Students</option>
                <option value="lecturer">Lecturers</option>
                <option value="admin">Admins</option>
            </select>
            <select id="filterStatus" class="filter-select">
                <option value="all">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
                <option value="Pending">Pending</option>
            </select>
        </div>
        <button class="create-btn" id="createUserBtn">
            <span>+</span> Add New User
        </button>
    </div>

    <!-- User Table -->
    <div class="user-table-container">
        <table class="user-table" id="userTable">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Registered Date</th>
                    <th class="actions-header">Actions</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                @if (Model.Users != null && Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr data-id="@user.Id" 
                            data-user-type="@user.Role"
                            data-status="@user.Status">
                            <td class="user-cell">
                                <div class="user-info">
                                    <div class="user-avatar">
                                        @if (!string.IsNullOrEmpty(user.ProfilePic))
                                        {
                                            <img src="@user.ProfilePic" 
                                                alt="@user.Name" 
                                                data-color="@user.AvatarColor" 
                                                data-initials="@user.Initials" 
                                                onerror="handleImageError(this)" />
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder" style="background-color: @user.AvatarColor;">
                                                @user.Initials
                                            </div>
                                        }
                                    </div>
                                    <div class="user-details">
                                        <span class="user-name">@user.Name</span>
                                        <span class="user-code">@user.UserCode</span>
                                    </div>
                                </div>
                            </td>
                            <td class="email-cell">@user.Email</td>
                            <td class="role-cell">
                                <span class="role-badge role-@user.Role.ToLower()">
                                    <i class="bi @user.RoleIcon"></i>
                                    @user.Role
                                </span>
                            </td>
                            <td class="status-cell">
                                <span class="status-badge status-@user.Status.ToLower()">
                                    <span class="status-dot"></span>
                                    @user.Status
                                </span>
                            </td>

                            <td class="date-cell">
                                @if (user.RegisteredDate.HasValue)
                                {
                                    @user.RegisteredDate.Value.ToString("MMM dd, yyyy")
                                }
                                else
                                {
                                    <span style="color: #a8a29e; font-style: italic;">System</span>
                                }
                            </td>
                     <td class="action-cell">
    <div class="action-buttons-wrapper">
        <button class="action-btn view-btn" data-id="@user.Id" data-type="@user.Role" title="View">
            <i class="bi bi-eye"></i>
        </button>
        <button class="action-btn edit-btn" data-id="@user.Id" data-type="@user.Role" title="Edit">
            <i class="bi bi-pencil-square"></i>
        </button>
        <button class="action-btn toggle-status-btn" 
                data-id="@user.Id" 
                data-type="@user.Role" 
                data-status="@user.Status"
                title="@(user.Status == "Active" ? "Deactivate" : user.Status == "Pending" ? "Activate / Reject" : "Reactivate")">
            @if (user.Status == "Active")
            {
                <i class="bi bi-person-x"></i>
            }
            else if (user.Status == "Pending")
            {
                <i class="bi bi-question-circle"></i>
            }
            else
            {
                <i class="bi bi-person-check"></i>
            }
        </button>
    </div>
</td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="6" class="empty-message">
                            No users found. Click "Add New User" to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- View User Modal -->
<div id="userModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-header-title">
                <i class="bi bi-person-badge"></i>
                <h3 id="modalTitle">User Details</h3>
            </div>
            <span class="modal-close">&times;</span>
        </div>
        <div class="modal-body">
            <div id="modalContent"></div>
        </div>
        <div class="modal-footer">
            <button id="modalCloseBtn" class="btn-secondary">Close</button>
        </div>
    </div>
</div>

<!-- Success Popup -->
<div id="successPopupModal" class="success-modal" style="display:none;">
    <div class="success-modal-content">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h3>Deleted Successfully</h3>
        <p>The user has been removed from the system.</p>
        <button id="successCloseBtn" class="success-btn">OK</button>
    </div>
</div>

