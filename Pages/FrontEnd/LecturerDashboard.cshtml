@page
@using System.Text.Json
@model APMoodle.Pages.BackEnd.LecturerDashboardModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Lecturer Dashboard";

    var topQ = Model.TopQuizzes;
    var barLabels = topQ.Select(q => q.Title).ToList();
    var barValues = topQ.Select(q => (int)System.Math.Round(q.AverageScore)).ToList();
    var totalAttempts = topQ.Sum(q => q.AttemptCount);
    var overallAvg = totalAttempts > 0
        ? (int)System.Math.Round(topQ.Sum(q => q.AverageScore * q.AttemptCount) / totalAttempts)
        : 0;

    var modLabels = Model.Modules.Select(m => m.Name).ToList();
    var modStudents = Model.Modules.Select(m => m.StudentCount).ToList();
    var hasStudents = modStudents.Sum() > 0;
    var hasQuizData = barValues.Any();
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Dashboard - APMoodle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
</head>

<div class="dashboard-container">

    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-title">
            <h1>Lecturer Dashboard</h1>
            <p>Welcome back, @Model.LecturerName@(string.IsNullOrEmpty(Model.LecturerCode) ? "" : $" ({Model.LecturerCode})") — here's your teaching at a glance.</p>
        </div>
        <div class="header-date">
            <i class="far fa-calendar-alt"></i>
            <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </div>
    </div>

    <!-- Stats Cards (3 across) -->
    <div class="stats-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="stat-card">
            <div class="stat-icon module-icon"><i class="fas fa-book"></i></div>
            <div class="stat-details">
                <h3>Enrolled Modules</h3>
                <div class="stat-value js-count">@Model.EnrolledModuleCount</div>
                <span class="stat-label">Modules You Teach</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon student-icon"><i class="fas fa-users"></i></div>
            <div class="stat-details">
                <h3>Students Joined</h3>
                <div class="stat-value js-count">@Model.StudentsJoinedCount</div>
                <span class="stat-label">Across Your Modules</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon enrollment-icon"><i class="fas fa-clipboard-question"></i></div>
            <div class="stat-details">
                <h3>Quizzes Created</h3>
                <div class="stat-value js-count">@Model.QuizzesCreatedCount</div>
                <span class="stat-label">In Your Materials</span>
            </div>
        </div>
    </div>

    <!-- Announcements (horizontal slider) -->
    <div class="announcements-card">
        <div class="card-header">
            <h3><i class="fas fa-bullhorn"></i> Announcements</h3>
            @if (Model.Announcements.Any())
            {
                <div class="announcement-nav">
                    <span class="card-subtitle" id="annCounter">1 / @Model.Announcements.Count</span>
                    @if (Model.Announcements.Count > 1)
                    {
                        <button type="button" class="ann-arrow" id="annPrev" aria-label="Previous announcement"><i class="fas fa-chevron-left"></i></button>
                        <button type="button" class="ann-arrow" id="annNext" aria-label="Next announcement"><i class="fas fa-chevron-right"></i></button>
                    }
                </div>
            }
        </div>
        <div class="card-body">
            @if (Model.Announcements.Any())
            {
                <div class="announcement-slider">
                    <div class="announcement-track" id="annTrack">
                        @foreach (var a in Model.Announcements)
                        {
                            <div class="announcement-slide">
                                <div class="announcement-item">
                                    <div class="announcement-item-icon"><i class="fas fa-bullhorn"></i></div>
                                    <div class="announcement-item-body">
                                        <div class="announcement-item-title">@a.Title</div>
                                        <div class="announcement-item-message">@a.Message</div>
                                        <div class="announcement-item-meta">
                                            <span><i class="fas fa-user-pen"></i> @(a.Creator?.Name ?? "Admin")</span>
                                            <span><i class="far fa-clock"></i> @a.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model.Announcements.Count > 1)
                {
                    <div class="announcement-dots" id="annDots">
                        @for (int i = 0; i < Model.Announcements.Count; i++)
                        {
                            <button type="button" class="ann-dot @(i == 0 ? "active" : "")" data-index="@i" aria-label="Go to announcement @(i + 1)"></button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="no-data-message"><i class="fas fa-bullhorn"></i><p>No announcements right now — check back later.</p></div>
            }
        </div>
    </div>

    <!-- Insights: quiz averages (wide) + overall gauge -->
    <div class="charts-row" style="grid-template-columns: 1.9fr 1fr;">
        <div class="chart-card">
            <div class="card-header">
                <h3><i class="fas fa-ranking-star"></i> Quiz Average Scores</h3>
                <span class="card-subtitle">Top quizzes by student average</span>
            </div>
            <div class="card-body">
                @if (hasQuizData)
                {
                    <div id="apexBars" style="height: 300px;"></div>
                }
                else
                {
                    <div class="no-data-message"><i class="fas fa-ranking-star"></i><p>No quiz attempts yet — scores appear once students take your quizzes</p></div>
                }
            </div>
        </div>

        <div class="chart-card">
            <div class="card-header">
                <h3><i class="fas fa-gauge-high"></i> Overall Average</h3>
                <span class="card-subtitle">Weighted across attempts</span>
            </div>
            <div class="card-body">
                @if (hasQuizData)
                {
                    <div id="apexGauge" style="height: 250px;"></div>
                    <div class="gauge-foot">
                        <span class="gauge-chip"><i class="fas fa-list-check"></i> @totalAttempts attempt@(totalAttempts == 1 ? "" : "s")</span>
                        <span class="gauge-chip"><i class="fas fa-clipboard-question"></i> @Model.QuizzesCreatedCount quizzes</span>
                    </div>
                }
                else
                {
                    <div class="no-data-message"><i class="fas fa-gauge-high"></i><p>No scores yet</p></div>
                }
            </div>
        </div>
    </div>

    <!-- Students per module + Your Modules list -->
    <div class="charts-row">
        <div class="chart-card">
            <div class="card-header">
                <h3><i class="fas fa-users-line"></i> Students per Module</h3>
                <span class="card-subtitle">Where your students are enrolled</span>
            </div>
            <div class="card-body">
                @if (hasStudents)
                {
                    <div id="apexModules" style="height: 300px;"></div>
                }
                else
                {
                    <div class="no-data-message"><i class="fas fa-users-line"></i><p>No students have joined your modules yet</p></div>
                }
            </div>
        </div>

        <div class="top-students-card">
            <div class="card-header">
                <h3><i class="fas fa-layer-group"></i> Your Modules</h3>
                @if (Model.Modules.Any())
                {
                    <a href="/FrontEnd/ModuleOverview" class="view-all-link">View All <i class="fas fa-arrow-right"></i></a>
                }
            </div>
            <div class="card-body">
                @if (Model.Modules.Any())
                {
                    <div class="students-list">
                        @{ int mi = 0; }
                        @foreach (var m in Model.Modules.Take(6))
                        {
                            var avatarColor = "c" + ((mi % 5) + 1);
                            mi++;
                            <a class="student-item" href="/FrontEnd/TeachingMaterial/@m.ModuleID" style="text-decoration:none;">
                                <div class="student-avatar"><div class="avatar-placeholder @avatarColor"><i class="fas fa-book-open" style="font-size:1rem;"></i></div></div>
                                <div class="student-info">
                                    <div class="student-name">@m.Name</div>
                                    <div class="student-code">
                                        @m.ModuleCode
                                        &nbsp;·&nbsp; <i class="fas fa-user-graduate"></i> @m.StudentCount student@(m.StudentCount == 1 ? "" : "s")
                                        &nbsp;·&nbsp; <i class="fas fa-clipboard-question"></i> @m.QuizCount quiz@(m.QuizCount == 1 ? "" : "zes")
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right module-go"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data-message"><i class="fas fa-layer-group"></i><p>You haven't created any modules yet</p></div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .gauge-foot { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; margin-top: 0.25rem; }
    .gauge-chip {
        display: inline-flex; align-items: center; gap: 0.4rem;
        font-size: 0.78rem; font-weight: 600; color: #6b5d4f;
        background: #f5ecd9; border: 1px solid #e8ddc9;
        padding: 0.35rem 0.7rem; border-radius: 999px;
    }
    .gauge-chip i { color: #b8935a; }
    .apexcharts-tooltip.apexcharts-theme-light { border: none !important; box-shadow: 0 8px 24px rgba(61,48,39,0.22) !important; border-radius: 10px !important; }
</style>

<script>
    window.dashL = {
        barLabels: @Html.Raw(JsonSerializer.Serialize(barLabels)),
        barValues: @Html.Raw(JsonSerializer.Serialize(barValues)),
        overallAvg: @overallAvg,
        modLabels: @Html.Raw(JsonSerializer.Serialize(modLabels)),
        modStudents: @Html.Raw(JsonSerializer.Serialize(modStudents))
    };

    (function () {
        var GOLD = '#b8935a', GOLD_LT = '#e3c987', ink = '#6b5d4f', grid = '#ece3d2';

        // ---- Horizontal bars: quiz averages (magnitude, single gold hue) ----
        var barsEl = document.getElementById('apexBars');
        if (barsEl && window.ApexCharts && window.dashL.barValues.length) {
            new ApexCharts(barsEl, {
                chart: { type: 'bar', height: 300, fontFamily: 'Inter, sans-serif', toolbar: { show: false }, animations: { speed: 900 } },
                series: [{ name: 'Avg score', data: window.dashL.barValues }],
                colors: [GOLD],
                plotOptions: { bar: { horizontal: true, borderRadius: 4, borderRadiusApplication: 'end', barHeight: '55%' } },
                fill: { type: 'gradient', gradient: { type: 'horizontal', gradientToColors: [GOLD_LT], shadeIntensity: 1, stops: [0, 100] } },
                dataLabels: { enabled: true, formatter: function (v) { return v + '%'; }, style: { colors: ['#fff'], fontWeight: 700, fontSize: '12px' }, offsetX: -2 },
                xaxis: { categories: window.dashL.barLabels, max: 100, labels: { style: { colors: ink }, formatter: function (v) { return Math.round(v) + '%'; } }, axisBorder: { show: false }, axisTicks: { show: false } },
                yaxis: { labels: { style: { colors: ink, fontSize: '12px' }, maxWidth: 160 } },
                grid: { borderColor: grid, yaxis: { lines: { show: false } } },
                tooltip: { y: { formatter: function (v) { return v + '%'; } } }
            }).render();
        }

        // ---- RadialBar: overall average ----
        var gaugeEl = document.getElementById('apexGauge');
        if (gaugeEl && window.ApexCharts) {
            new ApexCharts(gaugeEl, {
                chart: { type: 'radialBar', height: 250, fontFamily: 'Inter, sans-serif', animations: { speed: 1000 } },
                series: [window.dashL.overallAvg],
                colors: [GOLD],
                plotOptions: {
                    radialBar: {
                        startAngle: -135, endAngle: 135,
                        hollow: { size: '62%' },
                        track: { background: '#f0e6d0', strokeWidth: '100%', margin: 6 },
                        dataLabels: {
                            name: { show: true, offsetY: 22, color: '#7a6a55', fontSize: '13px', fontWeight: 600 },
                            value: { show: true, offsetY: -12, color: '#3d3027', fontSize: '40px', fontWeight: 800, formatter: function (v) { return Math.round(v) + '%'; } }
                        }
                    }
                },
                fill: { type: 'gradient', gradient: { shade: 'light', type: 'horizontal', gradientToColors: [GOLD_LT], stops: [0, 100] } },
                stroke: { lineCap: 'round' },
                labels: ['Class average']
            }).render();
        }

        // ---- Doughnut: students per module (categorical identity) ----
        var modEl = document.getElementById('apexModules');
        if (modEl && window.ApexCharts && window.dashL.modStudents.some(function (n) { return n > 0; })) {
            new ApexCharts(modEl, {
                chart: { type: 'donut', height: 300, fontFamily: 'Inter, sans-serif', animations: { speed: 900 } },
                series: window.dashL.modStudents,
                labels: window.dashL.modLabels,
                colors: ['#2a78d6', '#1baf7a', '#eda100', '#008300', '#4a3aa7', '#e34948'],
                stroke: { width: 2, colors: ['#fff'] },
                dataLabels: { enabled: true, style: { fontSize: '12px', fontWeight: 700 } },
                plotOptions: { pie: { donut: { size: '62%', labels: { show: true, total: { show: true, label: 'Students', color: '#7a6a55', formatter: function (w) { return w.globals.seriesTotals.reduce(function (a, b) { return a + b; }, 0); } } } } } },
                legend: { position: 'bottom', fontSize: '12px', labels: { colors: '#6b5d4f' }, markers: { width: 10, height: 10, radius: 3 } },
                tooltip: { y: { formatter: function (v) { return v + ' student' + (v === 1 ? '' : 's'); } } }
            }).render();
        }
    })();

    // ---- Count-up on stat values ----
    (function () {
        var els = document.querySelectorAll('.stat-value.js-count');
        els.forEach(function (el) {
            var raw = el.textContent.trim();
            var m = raw.match(/(\d+)/);
            if (!m) return;
            var target = parseInt(m[1], 10);
            var prefix = raw.slice(0, m.index), suffix = raw.slice(m.index + m[1].length);
            var start = null, dur = 900;
            function step(ts) {
                if (!start) start = ts;
                var p = Math.min((ts - start) / dur, 1);
                el.textContent = prefix + Math.floor((1 - Math.pow(1 - p, 3)) * target) + suffix;
                if (p < 1) requestAnimationFrame(step); else el.textContent = raw;
            }
            requestAnimationFrame(step);
        });
    })();

    // ---- Announcements horizontal slider ----
    (function () {
        var track = document.getElementById('annTrack');
        if (!track) return;
        var total = track.querySelectorAll('.announcement-slide').length;
        if (total < 2) return;
        var counter = document.getElementById('annCounter');
        var prev = document.getElementById('annPrev');
        var next = document.getElementById('annNext');
        var dots = Array.prototype.slice.call(document.querySelectorAll('#annDots .ann-dot'));
        var index = 0;
        function render() {
            track.style.transform = 'translateX(' + (-index * 100) + '%)';
            if (counter) counter.textContent = (index + 1) + ' / ' + total;
            dots.forEach(function (d, i) { d.classList.toggle('active', i === index); });
        }
        function go(i) { index = (i + total) % total; render(); }
        if (prev) prev.addEventListener('click', function () { go(index - 1); });
        if (next) next.addEventListener('click', function () { go(index + 1); });
        dots.forEach(function (d) { d.addEventListener('click', function () { go(parseInt(d.dataset.index, 10) || 0); }); });
        render();
    })();
</script>
