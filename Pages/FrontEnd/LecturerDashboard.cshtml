@page
@model APMoodle.Pages.BackEnd.LecturerDashboardModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Lecturer Dashboard";

    // Map an average score to one of the dashboard score-band gradients
    // (same thresholds the admin score circles use, computed here so this
    // page doesn't need the shared dashboard.js).
    string ScoreGradient(double score)
    {
        if (score >= 80) return "linear-gradient(135deg, #10b981, #059669)";
        if (score >= 60) return "linear-gradient(135deg, #f59e0b, #d97706)";
        if (score >= 40) return "linear-gradient(135deg, #f97316, #ea580c)";
        return "linear-gradient(135deg, #ef4444, #dc2626)";
    }
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lecturer Dashboard | APMoodle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/dashboard.css">
</head>

<div class="dashboard-container">

    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-title">
            <h1>Lecturer Dashboard</h1>
            <p>
                Welcome back, @Model.LecturerName@(string.IsNullOrEmpty(Model.LecturerCode) ? "" : $" ({Model.LecturerCode})")
                — here's your teaching at a glance.
            </p>
        </div>
        <div class="header-date">
            <i class="far fa-calendar-alt"></i>
            <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </div>
    </div>

    <!-- Stats Cards (3 across) -->
    <div class="stats-grid" style="grid-template-columns: repeat(3, 1fr);">
        <div class="stat-card">
            <div class="stat-icon module-icon">
                <i class="fas fa-book"></i>
            </div>
            <div class="stat-details">
                <h3>Enrolled Modules</h3>
                <div class="stat-value">@Model.EnrolledModuleCount</div>
                <span class="stat-label">Modules You Teach</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon student-icon">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-details">
                <h3>Students Joined</h3>
                <div class="stat-value">@Model.StudentsJoinedCount</div>
                <span class="stat-label">Across Your Modules</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon enrollment-icon">
                <i class="fas fa-clipboard-question"></i>
            </div>
            <div class="stat-details">
                <h3>Quizzes Created</h3>
                <div class="stat-value">@Model.QuizzesCreatedCount</div>
                <span class="stat-label">In Your Materials</span>
            </div>
        </div>
    </div>

    <!-- Announcements (horizontal slider, under the stats cards) -->
    <div class="announcements-card">
        <div class="card-header">
            <h3><i class="fas fa-bullhorn"></i> Announcements</h3>
            @if (Model.Announcements.Any())
            {
                <div class="announcement-nav">
                    <span class="card-subtitle" id="annCounter">1 / @Model.Announcements.Count</span>
                    @if (Model.Announcements.Count > 1)
                    {
                        <button type="button" class="ann-arrow" id="annPrev" aria-label="Previous announcement">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button type="button" class="ann-arrow" id="annNext" aria-label="Next announcement">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    }
                </div>
            }
        </div>
        <div class="card-body">
            @if (Model.Announcements.Any())
            {
                <div class="announcement-slider">
                    <div class="announcement-track" id="annTrack">
                        @foreach (var a in Model.Announcements)
                        {
                            <div class="announcement-slide">
                                <div class="announcement-item">
                                    <div class="announcement-item-icon">
                                        <i class="fas fa-bullhorn"></i>
                                    </div>
                                    <div class="announcement-item-body">
                                        <div class="announcement-item-title">@a.Title</div>
                                        <div class="announcement-item-message">@a.Message</div>
                                        <div class="announcement-item-meta">
                                            <span><i class="fas fa-user-pen"></i> @(a.Creator?.Name ?? "Admin")</span>
                                            <span><i class="far fa-clock"></i> @a.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model.Announcements.Count > 1)
                {
                    <div class="announcement-dots" id="annDots">
                        @for (int i = 0; i < Model.Announcements.Count; i++)
                        {
                            <button type="button" class="ann-dot @(i == 0 ? "active" : "")" data-index="@i"
                                    aria-label="Go to announcement @(i + 1)"></button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="no-data-message">
                    <i class="fas fa-bullhorn"></i>
                    <p>No announcements right now — check back later.</p>
                </div>
            }
        </div>
    </div>

    <!-- Two panels side by side: Your Modules + Quiz Average Score (Top 5) -->
    <div class="charts-row">

        <!-- Your Modules -->
        <div class="top-students-card">
            <div class="card-header">
                <h3><i class="fas fa-layer-group"></i> Your Modules</h3>
                @if (Model.Modules.Any())
                {
                    <a href="/FrontEnd/ModuleOverview" class="view-all-link">View All <i class="fas fa-arrow-right"></i></a>
                }
            </div>
            <div class="card-body">
                @if (Model.Modules.Any())
                {
                    <div class="students-list">
                        @{ int moduleColorIndex = 0; }
                        @foreach (var m in Model.Modules.Take(6))
                        {
                            var avatarColor = "c" + ((moduleColorIndex % 5) + 1);
                            moduleColorIndex++;
                            <a class="student-item" href="/FrontEnd/TeachingMaterial/@m.ModuleID" style="text-decoration:none;">
                                <div class="student-avatar">
                                    <div class="avatar-placeholder @avatarColor">
                                        <i class="fas fa-book-open" style="font-size:1rem;"></i>
                                    </div>
                                </div>
                                <div class="student-info">
                                    <div class="student-name">@m.Name</div>
                                    <div class="student-code">
                                        @m.ModuleCode
                                        &nbsp;·&nbsp; <i class="fas fa-user-graduate"></i> @m.StudentCount student@(m.StudentCount == 1 ? "" : "s")
                                        &nbsp;·&nbsp; <i class="fas fa-clipboard-question"></i> @m.QuizCount quiz@(m.QuizCount == 1 ? "" : "zes")
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right module-go"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data-message">
                        <i class="fas fa-layer-group"></i>
                        <p>You haven't created any modules yet</p>
                    </div>
                }
            </div>
        </div>

        <!-- Quiz Average Score — Top 5 -->
        <div class="top-students-card">
            <div class="card-header">
                <h3><i class="fas fa-trophy"></i> Quiz Average Score</h3>
                <span class="card-subtitle">Top 5 by average score</span>
            </div>
            <div class="card-body">
                @if (Model.TopQuizzes.Any())
                {
                    <div class="students-list">
                        @for (int i = 0; i < Model.TopQuizzes.Count; i++)
                        {
                            var q = Model.TopQuizzes[i];
                            var avg = (int)Math.Round(q.AverageScore);
                            <div class="student-item">
                                <div class="student-rank rank-@(i + 1)">@(i + 1)</div>
                                <div class="student-info">
                                    <div class="student-name">@q.Title</div>
                                    <div class="student-code">
                                        @(string.IsNullOrEmpty(q.ModuleName) ? q.Subject : q.ModuleName)
                                        &nbsp;·&nbsp; @q.AttemptCount attempt@(q.AttemptCount == 1 ? "" : "s")
                                    </div>
                                </div>
                                <div class="student-score">
                                    <div class="score-circle" style="background: @ScoreGradient(q.AverageScore);">
                                        <span>@avg%</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data-message">
                        <i class="fas fa-trophy"></i>
                        <p>No quiz attempts yet — scores will appear once students take your quizzes</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    // ── Announcements horizontal slider ──────────────────────
    (function () {
        var track = document.getElementById('annTrack');
        if (!track) return;
        var total = track.querySelectorAll('.announcement-slide').length;
        if (total < 2) return; // single announcement → nothing to slide

        var counter = document.getElementById('annCounter');
        var prev = document.getElementById('annPrev');
        var next = document.getElementById('annNext');
        var dots = Array.prototype.slice.call(document.querySelectorAll('#annDots .ann-dot'));
        var index = 0;

        function render() {
            track.style.transform = 'translateX(' + (-index * 100) + '%)';
            if (counter) counter.textContent = (index + 1) + ' / ' + total;
            dots.forEach(function (d, i) { d.classList.toggle('active', i === index); });
        }

        function go(i) {
            index = (i + total) % total; // wrap around so an arrow always moves
            render();
        }

        if (prev) prev.addEventListener('click', function () { go(index - 1); });
        if (next) next.addEventListener('click', function () { go(index + 1); });
        dots.forEach(function (d) {
            d.addEventListener('click', function () { go(parseInt(d.dataset.index, 10) || 0); });
        });

        render();
    })();
</script>
