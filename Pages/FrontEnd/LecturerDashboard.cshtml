@page
@model APMoodle.Pages.BackEnd.LecturerDashboardModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Lecturer Dashboard";
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard | APMoodle</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<div class="dashboard-container">

    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-title">
            <h1>Student Dashboard</h1>
            <p>Welcome back, @Model.LecturerName@(string.IsNullOrEmpty(Model.LecturerCode) ? "" : $" · {Model.LecturerCode}") — here's your learning at a glance.</p>
        </div>
        <div class="header-date">
            <i class="far fa-calendar-alt"></i>
            <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon module-icon">
                <i class="fas fa-book"></i>
            </div>
            <div class="stat-details">
                <h3>Enrolled Modules</h3>
                <div class="stat-value">@Model.EnrolledModuleCount</div>
                <span class="stat-label">Active Courses</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon enrollment-icon">
                <i class="fas fa-circle-check"></i>
            </div>
            <div class="stat-details">
                <h3>Quizzes Completed</h3>
                <div class="stat-value">@Model.CompletedQuizCount</div>
                <span class="stat-label">Total Attempts</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon student-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="stat-details">
                <h3>Average Score</h3>
                <div class="stat-value">@(Model.CompletedQuizCount > 0 ? $"{Model.AverageScore}%" : "—")</div>
                <span class="stat-label">Across All Quizzes</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon lecturer-icon">
                <i class="fas fa-trophy"></i>
            </div>
            <div class="stat-details">
                <h3>Best Score</h3>
                <div class="stat-value">@(Model.CompletedQuizCount > 0 ? $"{Model.BestScore}%" : "—")</div>
                <span class="stat-label">Personal Best</span>
            </div>
        </div>
    </div>

    <!-- Announcements (horizontal slider, under the stats cards) -->
    <div class="announcements-card">
        <div class="card-header">
            <h3><i class="fas fa-bullhorn"></i> Announcements</h3>
            @if (Model.Announcements.Any())
            {
                <div class="announcement-nav">
                    <span class="card-subtitle" id="annCounter">1 / @Model.Announcements.Count</span>
                    @if (Model.Announcements.Count > 1)
                    {
                        <button type="button" class="ann-arrow" id="annPrev" aria-label="Previous announcement">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <button type="button" class="ann-arrow" id="annNext" aria-label="Next announcement">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    }
                </div>
            }
        </div>
        <div class="card-body">
            @if (Model.Announcements.Any())
            {
                <div class="announcement-slider">
                    <div class="announcement-track" id="annTrack">
                        @foreach (var a in Model.Announcements)
                        {
                            <div class="announcement-slide">
                                <div class="announcement-item">
                                    <div class="announcement-item-icon">
                                        <i class="fas fa-bullhorn"></i>
                                    </div>
                                    <div class="announcement-item-body">
                                        <div class="announcement-item-title">@a.Title</div>
                                        <div class="announcement-item-message">@a.Message</div>
                                        <div class="announcement-item-meta">
                                            <span><i class="fas fa-user-pen"></i> @(a.Creator?.Name ?? "Admin")</span>
                                            <span><i class="far fa-clock"></i> @a.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                @if (Model.Announcements.Count > 1)
                {
                    <div class="announcement-dots" id="annDots">
                        @for (int i = 0; i < Model.Announcements.Count; i++)
                        {
                            <button type="button" class="ann-dot @(i == 0 ? "active" : "")" data-index="@i"
                                    aria-label="Go to announcement @(i + 1)"></button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="no-data-message">
                    <i class="fas fa-bullhorn"></i>
                    <p>No announcements right now — check back later.</p>
                </div>
            }
        </div>
    </div>

    <!-- Quiz Score Trend + Recent Quiz Attempts (same row) -->
    <div class="charts-row">

        <!-- Quiz Score Trend -->
        <div class="chart-card">
            <div class="card-header">
                <h3><i class="fas fa-chart-line"></i> Quiz Score Trend</h3>
                <span class="card-subtitle">Your recent quiz results</span>
            </div>
            <div class="card-body">
                @if (scoreValues.Any())
                {
                    <div style="position: relative; height: 300px;">
                        <canvas id="scoreChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="no-data-message">
                        <i class="fas fa-chart-line"></i>
                        <p>No quiz results yet — take a quiz to see your progress here</p>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Quiz Attempts -->
        <div class="activities-card">
            <div class="card-header">
                <h3><i class="fas fa-clock-rotate-left"></i> Recent Quiz Attempts</h3>
                @if (Model.RecentAttempts.Any())
                {
                    <a href="/FrontEnd/QuizHistory" class="view-all-link">Full History <i class="fas fa-arrow-right"></i></a>
                }
            </div>
            <div class="card-body">
                @if (Model.RecentAttempts.Any())
                {
                    <div class="activities-list">
                        @foreach (var s in Model.RecentAttempts)
                        {
                            var sc = s.TotalScore ?? -1;
                            var scoreBand = sc < 0 ? "score-none"
                                : sc >= 80 ? "score-good"
                                : sc >= 60 ? "score-ok"
                                : sc >= 40 ? "score-low"
                                : "score-bad";
                            <a class="activity-item" href="/FrontEnd/QuizResult/@s.SessionID" style="text-decoration:none;">
                                <div class="activity-icon @scoreBand">
                                    <i class="fas fa-pen-to-square"></i>
                                </div>
                                <div class="activity-details">
                                    <div class="activity-description">
                                        <strong>@(s.TotalScore.HasValue ? $"{s.TotalScore}%" : "—")</strong>
                                        on @(s.Quiz?.Title ?? "Quiz")
                                    </div>
                                    <div class="activity-time">
                                        <i class="far fa-clock"></i>
                                        @s.Timestamp.ToString("MMM dd, yyyy • hh:mm tt")
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right module-go"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data-message">
                        <i class="fas fa-clock-rotate-left"></i>
                        <p>No quiz attempts yet</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Your Modules (below Quiz Score) + Quick Actions -->
    <div class="bottom-row">

        <!-- Your Modules -->
        <div class="top-students-card">
            <div class="card-header">
                <h3><i class="fas fa-layer-group"></i> Your Modules</h3>
                @if (Model.EnrolledModules.Any())
                {
                    <a href="/FrontEnd/ModuleOverview" class="view-all-link">View All <i class="fas fa-arrow-right"></i></a>
                }
            </div>
            <div class="card-body">
                @if (Model.EnrolledModules.Any())
                {
                    <div class="students-list">
                        @{ int moduleColorIndex = 0; }
                        @foreach (var m in Model.EnrolledModules.Take(5))
                        {
                            var avatarColor = "c" + ((moduleColorIndex % 5) + 1);
                            moduleColorIndex++;
                            <a class="student-item" href="/FrontEnd/TeachingMaterial/@m.ModuleID" style="text-decoration:none;">
                                <div class="student-avatar">
                                    <div class="avatar-placeholder @avatarColor">
                                        <i class="fas fa-book-open" style="font-size:1rem;"></i>
                                    </div>
                                </div>
                                <div class="student-info">
                                    <div class="student-name">@m.Name</div>
                                    <div class="student-code">@m.ModuleCode &nbsp;·&nbsp; 👨‍🏫 @(m.Lecturer?.Name ?? "Staff")</div>
                                </div>
                                <i class="fas fa-chevron-right module-go"></i>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="no-data-message">
                        <i class="fas fa-book"></i>
                        <p>You haven't joined any modules yet</p>
                        <a href="/FrontEnd/JoinModule" class="dash-link-btn">
                            <i class="fas fa-plus"></i> Join a Module
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="trend-card">
            <div class="card-header">
                <h3><i class="fas fa-bolt"></i> Quick Actions</h3>
            </div>
            <div class="card-body">
                <div class="quick-actions">
                    <a class="quick-action qa1" href="/FrontEnd/ModuleOverview">
                        <i class="fas fa-book"></i>
                        <span>Browse My Modules</span>
                        <i class="fas fa-arrow-right qa-arrow"></i>
                    </a>
                    <a class="quick-action qa2" href="/FrontEnd/JoinModule">
                        <i class="fas fa-plus"></i>
                        <span>Join a Module</span>
                        <i class="fas fa-arrow-right qa-arrow"></i>
                    </a>
                    <a class="quick-action qa3" href="/FrontEnd/QuizHistory">
                        <i class="fas fa-clock-rotate-left"></i>
                        <span>Quiz History</span>
                        <i class="fas fa-arrow-right qa-arrow"></i>
                    </a>
                    <a class="quick-action qa4" href="/FrontEnd/Chat">
                        <i class="fas fa-comments"></i>
                        <span>Open Chat</span>
                        <i class="fas fa-arrow-right qa-arrow"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.scoreTrend = {
        labels: @Html.Raw(JsonSerializer.Serialize(scoreLabels)),
        values: @Html.Raw(JsonSerializer.Serialize(scoreValues)),
        details: @Html.Raw(JsonSerializer.Serialize(scoreDetails))
    };

    (function () {
        var canvas = document.getElementById('scoreChart');
        if (!canvas || !window.scoreTrend || !window.scoreTrend.values.length) return;

        new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: {
                labels: window.scoreTrend.labels,
                datasets: [{
                    label: 'Score',
                    data: window.scoreTrend.values,
                    borderColor: '#4f46e5',
                    backgroundColor: 'rgba(79, 70, 229, 0.1)',
                    borderWidth: 3,
                    pointBackgroundColor: '#4f46e5',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 8,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1f2937',
                        titleColor: '#ffffff',
                        bodyColor: '#e5e7eb',
                        padding: 12,
                        cornerRadius: 8,
                        displayColors: false,
                        callbacks: {
                            // Title = the day; if more than one quiz, note the count + average
                            title: function (items) {
                                var i = items[0].dataIndex;
                                var day = window.scoreTrend.labels[i];
                                var list = (window.scoreTrend.details && window.scoreTrend.details[i]) || [];
                                if (list.length > 1) {
                                    return day + '  ·  ' + list.length + ' quizzes (avg ' + items[0].raw + '%)';
                                }
                                return day;
                            },
                            // Body = one line per quiz taken that day
                            label: function (context) {
                                var list = (window.scoreTrend.details && window.scoreTrend.details[context.dataIndex]) || [];
                                if (list.length === 0) {
                                    return 'Score: ' + context.raw + '%';
                                }
                                if (list.length === 1) {
                                    return list[0].title + ': ' + list[0].score + '%';
                                }
                                return list.map(function (q) {
                                    return '• ' + q.title + ': ' + q.score + '%';
                                });
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        grid: { color: '#e5e7eb' },
                        ticks: { callback: function (v) { return v + '%'; } }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    })();

    // ── Announcements horizontal slider ──────────────────────
    (function () {
        var track = document.getElementById('annTrack');
        if (!track) return;
        var total = track.querySelectorAll('.announcement-slide').length;
        if (total < 2) return; // single announcement → nothing to slide

        var counter = document.getElementById('annCounter');
        var prev = document.getElementById('annPrev');
        var next = document.getElementById('annNext');
        var dots = Array.prototype.slice.call(document.querySelectorAll('#annDots .ann-dot'));
        var index = 0;

        function render() {
            track.style.transform = 'translateX(' + (-index * 100) + '%)';
            if (counter) counter.textContent = (index + 1) + ' / ' + total;
            dots.forEach(function (d, i) { d.classList.toggle('active', i === index); });
        }

        function go(i) {
            index = (i + total) % total; // wrap around so an arrow always moves
            render();
        }

        if (prev) prev.addEventListener('click', function () { go(index - 1); });
        if (next) next.addEventListener('click', function () { go(index + 1); });
        dots.forEach(function (d) {
            d.addEventListener('click', function () { go(parseInt(d.dataset.index, 10) || 0); });
        });

        render();
    })();
</script>