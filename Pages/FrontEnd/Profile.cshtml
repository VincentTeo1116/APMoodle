@page
@using Microsoft.AspNetCore.Http
@model APMoodle.Pages.BackEnd.ProfileModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Profile";
}
@{
    var userId = HttpContext.Session.GetString("UserID");
    var userRole = HttpContext.Session.GetString("UserRole") ?? "Guest";
    var isLoggedIn = !string.IsNullOrEmpty(userId) && userRole != "Guest";

    string GetAvatarColor(string role) => role switch
    {
        "student" => "#3b82f6",
        "lecturer" => "#f59e0b",
        "admin" => "#ef4444",
        _ => "#64748b"
    };

    string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Trim().Split(' ');
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    var avatarColor = GetAvatarColor(userRole);
    var initials = GetInitials(Model.Name);
    var profilePicUrl = !string.IsNullOrEmpty(Model.ProfilePic) 
        ? Model.ProfilePic + "?v=" + DateTime.Now.Ticks
        : null;
}

<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/profile.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
</head>

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
        <p class="path">@(char.ToUpper(userRole[0]) + userRole.Substring(1)) Dashboard > @ViewData["Title"]</p>
    </div>

    <form method="post" enctype="multipart/form-data" id="profileForm">
        @Html.AntiForgeryToken()

        <div class="profile-dashboard">
            <!-- Left Section: Profile Picture -->
            <div class="profile-picture">
                <div class="picture" id="profilePictureContainer">
                    @if (!string.IsNullOrEmpty(profilePicUrl))
                    {
                        <img src="@profilePicUrl"
                             alt="Profile Picture"
                             class="profile-img"
                             id="profileImg"
                             data-color="@avatarColor"
                             data-initials="@initials"
                             onerror="handleImageError(this)" />
                    }
                    else
                    {
                        <div class="avatar-placeholder" style="background-color: @avatarColor; width: 200px; height: 200px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40px; font-weight: 700; color: white; border: 3px solid #e2e8f0;">
                            @initials
                        </div>
                    }
                </div>
                <div class="upload-actions">
                    <label for="profilePic" class="upload-btn">Change Profile</label>
                    <input type="file" id="profilePic" name="profilePic" accept="image/*" style="display: none;" />
                    <button type="button" class="remove-btn" id="removePhotoBtn">Remove Photo</button>
                    <p class="upload-hint">Click "Change Profile" to upload a new photo</p>
                </div>
            </div>

            <!-- Right Section: Personal Info -->
            <div class="personal-info">
                @if (userRole == "student")
                {
                    <div class="info-group">
                        <label class="info-label">Student Code</label>
                        <input type="text" value="@Model.UserCode" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Name</label>
                        <input type="text" value="@Model.Name" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Email</label>
                        <input type="email" value="@Model.Email" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Phone Number <span class="required">*</span></label>
                        <div class="form-group" id="phoneGroup">
                            <input type="tel" name="PhoneNumber" id="PhoneNumber" value="@Model.PhoneNumber" required />
                            <div class="error-message" id="phoneError">Please enter a valid phone number (10-11 digits, starting with 0).</div>
                            <div class="validation-success" id="phoneSuccess"><i class="bi bi-check-circle"></i> Valid</div>
                        </div>
                    </div>
                    <div class="info-group">
                        <label class="info-label">Date of Birth</label>
                        <input type="date" value="@Model.DOB?.ToString("yyyy-MM-dd")" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Gender</label>
                        <input type="text" value="@Model.Gender" readonly class="readonly-input" />
                    </div>
                }
                else if (userRole == "lecturer")
                {
                    <div class="info-group">
                        <label class="info-label">Lecturer Code</label>
                        <input type="text" value="@Model.UserCode" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Name</label>
                        <input type="text" value="@Model.Name" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Email</label>
                        <input type="email" value="@Model.Email" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Phone Number <span class="required">*</span></label>
                        <div class="form-group" id="phoneGroup">
                            <input type="tel" name="PhoneNumber" id="PhoneNumber" value="@Model.PhoneNumber" required />
                            <div class="error-message" id="phoneError">Please enter a valid phone number (10-11 digits, starting with 0).</div>
                            <div class="validation-success" id="phoneSuccess"><i class="bi bi-check-circle"></i> Valid</div>
                        </div>
                    </div>
                    <div class="info-group">
                        <label class="info-label">Date of Birth</label>
                        <input type="date" value="@Model.DOB?.ToString("yyyy-MM-dd")" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Department</label>
                        <input type="text" value="@Model.Department" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Gender</label>
                        <input type="text" value="@Model.Gender" readonly class="readonly-input" />
                    </div>
                }
                else if (userRole == "admin")
                {
                    <div class="info-group">
                        <label class="info-label">Admin Code</label>
                        <input type="text" value="@Model.UserCode" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Name</label>
                        <input type="text" value="@Model.Name" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Email</label>
                        <input type="email" value="@Model.Email" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Phone Number <span class="required">*</span></label>
                        <div class="form-group" id="phoneGroup">
                            <input type="tel" name="PhoneNumber" id="PhoneNumber" value="@Model.PhoneNumber" required />
                            <div class="error-message" id="phoneError">Please enter a valid phone number (10-11 digits, starting with 0).</div>
                            <div class="validation-success" id="phoneSuccess"><i class="bi bi-check-circle"></i> Valid</div>
                        </div>
                    </div>
                    <div class="info-group">
                        <label class="info-label">Date of Birth</label>
                        <input type="date" value="@Model.DOB?.ToString("yyyy-MM-dd")" readonly class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Gender</label>
                        <input type="text" value="@Model.Gender" readonly class="readonly-input" />
                    </div>
                }
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-update">Update Profile</button>
        </div>

        <input type="hidden" name="RemovePhoto" id="removePhotoInput" value="false" />
    </form>
</div>

<div id="cropModal" class="cropper-modal">
    <div class="cropper-modal-content">
        <div class="cropper-modal-header">
            <h3>Crop Profile Picture</h3>
            <button class="cropper-modal-close" id="cropModalClose">&times;</button>
        </div>
        <div class="cropper-modal-body">
            <div style="max-height:400px; overflow:hidden;">
                <img id="cropImage" src="" alt="Crop Image" />
            </div>
        </div>
        <div class="cropper-modal-footer">
            <button class="btn-secondary" id="cropCancelBtn">Cancel</button>
            <button class="btn-primary" id="cropSaveBtn">Crop & Upload</button>
        </div>
    </div>
</div>

@if (TempData["ShowSuccessModal"] != null && (bool)TempData["ShowSuccessModal"])
{
    <div id="successModal" class="modal-overlay-full" style="display: flex !important; align-items: center; justify-content: center;" onclick="if(event.target===this)this.style.display='none'">
        <div class="modal-container">
            <div class="modal-icon success-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h3 class="modal-title">Profile Updated</h3>
            <p class="modal-message">@(TempData["SuccessMessage"]?.ToString() ?? "Your profile has been updated successfully.")</p>
            <div class="modal-actions">
                <button class="modal-btn modal-success" onclick="document.getElementById('successModal').style.display='none'">
                    <i class="bi bi-check-circle"></i> OK
                </button>
            </div>
        </div>
    </div>
}

<div id="deleteConfirmModal" class="modal-overlay-full" style="display: none;">
    <div class="modal-container">
        <div class="modal-icon warning-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h3 class="modal-title">Remove Profile Picture?</h3>
        <p class="modal-message">You are about to remove your profile picture. This action can be undone later by uploading a new one.</p>
        <div class="modal-warning">
            <i class="bi bi-shield-exclamation"></i>
            <span>Your current picture will be permanently deleted.</span>
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-cancel" id="deleteCancelBtn">
                <i class="bi bi-x-circle"></i> Cancel
            </button>
            <button class="modal-btn modal-danger" id="deleteConfirmBtn">
                <i class="bi bi-trash"></i> Remove
            </button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<script>
    // Phone number validation
    const phoneInput = document.getElementById('PhoneNumber');
    const phoneGroup = document.getElementById('phoneGroup');
    const phoneError = document.getElementById('phoneError');
    const phoneSuccess = document.getElementById('phoneSuccess');

    function validatePhone() {
        const value = phoneInput.value.trim();
        const pattern = /^0\d{9,10}$/;
        if (!pattern.test(value)) {
            phoneGroup.classList.add('has-error');
            phoneError.classList.add('show');
            phoneSuccess.classList.remove('show');
            return false;
        } else {
            phoneGroup.classList.remove('has-error');
            phoneError.classList.remove('show');
            phoneSuccess.classList.add('show');
            return true;
        }
    }

    phoneInput.addEventListener('input', validatePhone);
    phoneInput.addEventListener('blur', validatePhone);

    // Validate on form submit
    const profileForm = document.getElementById('profileForm');
    profileForm.addEventListener('submit', function(e) {
        if (!validatePhone()) {
            e.preventDefault();
            phoneInput.focus();
            phoneInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }
        return true;
    });

    function handleImageError(img) {
        img.onerror = null;
        const color = img.dataset.color || '#64748b';
        const initials = img.dataset.initials || '?';
        const parent = img.parentElement;
        if (!parent || !parent.nodeType) return;

        const placeholder = document.createElement('div');
        placeholder.className = 'avatar-placeholder';
        placeholder.style.backgroundColor = color;
        placeholder.style.width = '200px';
        placeholder.style.height = '200px';
        placeholder.style.borderRadius = '50%';
        placeholder.style.display = 'flex';
        placeholder.style.alignItems = 'center';
        placeholder.style.justifyContent = 'center';
        placeholder.style.fontSize = '40px';
        placeholder.style.fontWeight = '700';
        placeholder.style.color = 'white';
        placeholder.style.border = '3px solid #e2e8f0';
        placeholder.textContent = initials;

        parent.replaceChild(placeholder, img);
    }
    window.handleImageError = handleImageError;

    let cropper = null;
    const cropModal = document.getElementById('cropModal');
    const cropImage = document.getElementById('cropImage');
    const fileInput = document.getElementById('profilePic');
    const removePhotoBtn = document.getElementById('removePhotoBtn');
    const removePhotoInput = document.getElementById('removePhotoInput');
    const form = document.getElementById('profileForm');

    fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(event) {
            cropImage.src = event.target.result;
            cropModal.classList.add('show');
            if (cropImage.complete) {
                initCropper();
            } else {
                cropImage.onload = initCropper;
            }
        };
        reader.readAsDataURL(file);
        fileInput.value = '';
    });

    function initCropper() {
        if (cropper) cropper.destroy();
        cropper = new Cropper(cropImage, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            movable: true,
            zoomable: true,
            rotatable: false,
            scalable: false,
        });
    }

    function closeCropModal() {
        cropModal.classList.remove('show');
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
    }

    document.getElementById('cropCancelBtn').addEventListener('click', closeCropModal);
    document.getElementById('cropModalClose').addEventListener('click', closeCropModal);
    cropModal.addEventListener('click', function(e) {
        if (e.target === cropModal) closeCropModal();
    });

    document.getElementById('cropSaveBtn').addEventListener('click', function() {
        if (!cropper) return;
        cropper.getCroppedCanvas().toBlob(function(blob) {
            const file = new File([blob], 'profile_cropped.jpg', { type: 'image/jpeg' });
            const formData = new FormData(form);
            formData.set('profilePic', file, 'profile_cropped.jpg');

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const headers = {};
            if (token) headers['RequestVerificationToken'] = token;

            fetch(window.location.href, {
                method: 'POST',
                headers: headers,
                body: formData
            })
            .then(response => response.text())
            .then(html => {
                window.location.reload();
            })
            .catch(error => {
                alert('Error uploading cropped image.');
            });
        }, 'image/jpeg', 0.9);
        closeCropModal();
    });

    const deleteConfirmModal = document.getElementById('deleteConfirmModal');
    const deleteCancelBtn = document.getElementById('deleteCancelBtn');
    const deleteConfirmBtn = document.getElementById('deleteConfirmBtn');

    removePhotoBtn.addEventListener('click', function() {
        deleteConfirmModal.style.display = 'flex';
    });

    deleteCancelBtn.addEventListener('click', function() {
        deleteConfirmModal.style.display = 'none';
    });

    deleteConfirmModal.addEventListener('click', function(e) {
        if (e.target === deleteConfirmModal) {
            deleteConfirmModal.style.display = 'none';
        }
    });

    deleteConfirmBtn.addEventListener('click', function() {
        deleteConfirmModal.style.display = 'none';
        removePhotoInput.value = 'true';
        form.submit();
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const successModal = document.getElementById('successModal');
            if (successModal && successModal.style.display !== 'none') {
                successModal.style.display = 'none';
            }
            if (deleteConfirmModal.style.display === 'flex') {
                deleteConfirmModal.style.display = 'none';
            }
            if (cropModal.style.display === 'flex') {
                closeCropModal();
            }
        }
    });
</script>