@page
@using Microsoft.AspNetCore.Http
@model APMoodle.Pages.BackEnd.ProfileModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Profile";
}
@{
    var userId = HttpContext.Session.GetString("UserID");
    var userRole = HttpContext.Session.GetString("UserRole") ?? "Guest";
    var isLoggedIn = !string.IsNullOrEmpty(userId) && userRole != "Guest";
}

<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/profile.css" />
</head>

<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
        <p class="path">@(char.ToUpper(userRole[0]) + userRole.Substring(1)) Dashboard > @ViewData["Title"]</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert @(Model.IsSuccess ? "alert-success" : "alert-error")">
            @Model.Message
        </div>
    }

    <form method="post" enctype="multipart/form-data">
        <div class="profile-dashboard">
            <!-- Left Section: Profile Picture -->
            <div class="profile-picture">
                <div class="picture">
                    @if (!string.IsNullOrEmpty(Model.ProfilePic))
                    {
                        <img src="@Model.ProfilePic" alt="Profile Picture" class="profile-img" />
                    }
                    else
                    {
                        <div class="default-avatar">
                            @(string.IsNullOrEmpty(Model.Name) ? "👤" : Model.Name.Substring(0, 1).ToUpper())
                        </div>
                    }
                </div>
                <div class="upload-picture">
                    <label for="profilePic" class="upload-btn">Change Profile</label>
                    <input type="file" id="profilePic" name="profilePic" accept="image/*" style="display: none;" />
                    <p class="upload-hint">Click to upload (JPG, PNG)</p>
                </div>
            </div>

            <!-- Right Section: Personal Info -->
            <div class="personal-info">
                @if (userRole == "student")
                {
                    <div class="info-group">
                        <label class="info-label">Student Code</label>
                        <input type="text" value="@Model.UserCode" readonly disabled class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Name</label>
                        <input type="text" name="Name" value="@Model.Name" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Email</label>
                        <input type="email" value="@Model.Email" readonly disabled class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Phone Number</label>
                        <input type="tel" name="PhoneNumber" value="@Model.PhoneNumber" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Date of Birth</label>
                        <input type="date" name="DOB" value="@Model.DOB?.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Gender</label>
                        <select name="Gender" required>
                            <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
                        </select>
                    </div>
                }
                else if (userRole == "lecturer")
                {
                    <div class="info-group">
                        <label class="info-label">Lecturer Code</label>
                        <input type="text" value="@Model.UserCode" readonly disabled class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Name</label>
                        <input type="text" name="Name" value="@Model.Name" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Email</label>
                        <input type="email" value="@Model.Email" readonly disabled class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Phone Number</label>
                        <input type="tel" name="PhoneNumber" value="@Model.PhoneNumber" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Date of Birth</label>
                        <input type="date" name="DOB" value="@Model.DOB?.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Department</label>
                        <input type="text" name="Department" value="@Model.Department" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Gender</label>
                        <select name="Gender" required>
                            <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
                        </select>
                    </div>
                }
                else if (userRole == "admin")
                {
                    <div class="info-group">
                        <label class="info-label">Admin Code</label>
                        <input type="text" value="@Model.UserCode" readonly disabled class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Name</label>
                        <input type="text" name="Name" value="@Model.Name" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Email</label>
                        <input type="email" value="@Model.Email" readonly disabled class="readonly-input" />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Phone Number</label>
                        <input type="tel" name="PhoneNumber" value="@Model.PhoneNumber" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Date of Birth</label>
                        <input type="date" name="DOB" value="@Model.DOB?.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="info-group">
                        <label class="info-label">Gender</label>
                        <select name="Gender" required>
                            <option value="Male" selected="@(Model.Gender == "Male")">Male</option>
                            <option value="Female" selected="@(Model.Gender == "Female")">Female</option>
                            <option value="Other" selected="@(Model.Gender == "Other")">Other</option>
                        </select>
                    </div>
                }
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-update">Update Profile</button>
        </div>
    </form>
</div>

<script>
    document.querySelector('.upload-picture').addEventListener('click', function() {
        document.getElementById('profilePic').click();
    });

    document.getElementById('profilePic').addEventListener('change', function(e) {
        if (e.target.files && e.target.files[0]) {
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = document.querySelector('.profile-img');
                const defaultAvatar = document.querySelector('.default-avatar');
                if (img) {
                    img.src = event.target.result;
                } else {
                    const pictureDiv = document.querySelector('.picture');
                    pictureDiv.innerHTML = `<img src="${event.target.result}" alt="Profile Picture" class="profile-img" />`;
                }
            };
            reader.readAsDataURL(e.target.files[0]);
        }
    });
</script>