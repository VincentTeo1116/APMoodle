@page
@model APMoodle.Pages.BackEnd.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/loader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Inline validation styles (matching UserCreate) */
        .form-group {
            margin-bottom: 18px;
        }
        .form-group label {
            display: block;
            font-weight: 500;
            color: #44403c;
            margin-bottom: 4px;
            font-size: 13px;
        }
        .form-group label .required {
            color: #ef4444;
            margin-left: 4px;
        }
        .form-group input,
        .form-group select {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #ece7df;
            border-radius: 10px;
            font-size: 14px;
            background: #faf7f0;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #b8935a;
            box-shadow: 0 0 0 3px rgba(201, 162, 75, 0.1);
            background: white;
        }
        .form-group .error-message {
            font-size: 12px;
            color: #ef4444;
            margin-top: 4px;
            display: none;
        }
        .form-group .error-message.show {
            display: block;
        }
        .form-group.has-error input,
        .form-group.has-error select {
            border-color: #ef4444;
            background: #fef2f2;
        }
        .form-group.has-error input:focus,
        .form-group.has-error select:focus {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }
        .form-group.has-error .error-message {
            display: block;
        }
        .form-group .validation-success {
            color: #22c55e;
            font-size: 12px;
            margin-top: 4px;
            display: none;
        }
        .form-group .validation-success.show {
            display: block;
        }
        .validation-summary {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            display: none;
        }
        .validation-summary.show {
            display: block;
        }
        .validation-summary ul {
            margin: 0;
            padding-left: 20px;
            color: #991b1b;
            font-size: 13px;
        }
        .validation-summary h4 {
            color: #991b1b;
            font-size: 14px;
            font-weight: 600;
            margin: 0 0 4px 0;
        }
        .alert-pending {
            background: #fef3c7;
            border: 1px solid #fcd34d;
            color: #92400e;
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .alert-pending i { font-size: 20px; margin-right: 8px; }
    </style>
</head>
<body>

<!-- ───────────── PAGE LOADER ───────────── -->
<div id="apm-loader" class="apm-loader apm-loader--rings">
    <div class="apm-loader-stage">
        <svg class="apm-loader-logo" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <g class="tassel-group">
                <path class="draw tassel-line" d="M150 60 L150 95" />
                <circle class="fill-tassel-bead" cx="150" cy="100" r="6" fill="#f5ebdc" />
            </g>
            <path class="draw" d="M100 50 L170 80 L100 110 L30 80 Z" />
            <path class="fill-cap" d="M100 50 L170 80 L100 110 L30 80 Z" fill="#f5ebdc" />
            <path class="draw s2" d="M40 90 L40 120 Q70 140 100 130 Q130 140 160 120 L160 90" />
            <path class="draw s3" d="M30 135 Q65 155 100 145 Q135 155 170 135 L170 165 Q135 180 100 170 Q65 180 30 165 Z" />
            <path class="fill-book-left"  d="M30 140 Q65 158 100 148 L100 170 Q65 180 30 165 Z" fill="#f5ebdc" opacity="0.9"/>
            <path class="fill-book-right" d="M170 140 Q135 158 100 148 L100 170 Q135 180 170 165 Z" fill="#f5ebdc" opacity="0.75"/>
        </svg>
        <div class="apm-loader-rings">
            <div class="ring r1"></div>
            <div class="ring r2"></div>
            <div class="ring r3"></div>
        </div>
        <div class="apm-loader-wordmark">APMoodle</div>
        <div class="apm-loader-subtext">Loading Experience</div>
        <div class="apm-loader-bar"><span></span></div>
    </div>
</div>

<div class="login-wrapper">

    <!-- LEFT SIDE (logo) -->
    <div class="login-left">
        <div class="logo-particles" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
        </div>
        <div class="logo-stage">
            <div class="logo-orbit" aria-hidden="true"></div>
            <div class="logo-orbit-inner" aria-hidden="true"></div>
            <div class="logo-sparkles" aria-hidden="true">
                <span></span><span></span><span></span>
                <span></span><span></span><span></span>
            </div>
            <svg class="logo-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="APMoodle logo">

                <!-- ───── CAP ─────
                     Band drawn first (back), then diamond on top so all 4 corners of the
                     square stay visible and the band peeks out from below the diamond. -->

                <!-- Cap underside band (back layer) -->
                <path class="draw s2" d="M48 92 L48 116 Q75 128 100 126 Q125 128 152 116 L152 92" />
                <path class="fill-cap-band" d="M48 92 L48 116 Q75 128 100 126 Q125 128 152 116 L152 92 Q125 102 100 102 Q75 102 48 92 Z"
                      fill="#c9b48a" opacity="0.9" />

                <!-- Mortarboard (top diamond) — drawn AFTER the band so it sits in front -->
                <path class="draw" d="M100 38 L175 72 L100 106 L25 72 Z" />
                <path class="fill-cap" d="M100 38 L175 72 L100 106 L25 72 Z" fill="#f5ebdc" />

                <!-- Cap top button (where the tassel attaches) -->
                <circle class="cap-button" cx="100" cy="42" r="5" fill="#f5ebdc" stroke="#3d3027" stroke-width="0.6" />

                <!-- ───── TASSEL (cord drapes from button over right edge, ball hangs with fringe) ───── -->
                <g class="tassel-group">
                    <!-- Cord drapes from cap-button over the right corner, hangs OUT to the right of the book -->
                    <path class="draw tassel-line" d="M 100 42 Q 150 50 175 72 Q 196 96 184 118" />
                    <!-- Hanging ball — clearly to the right of the book -->
                    <circle class="fill-tassel-bead" cx="184" cy="128" r="10" fill="#f5ebdc" />
                    <!-- Glossy highlight on ball (3D feel) -->
                    <circle class="tassel-bead-shine" cx="180" cy="124" r="3" fill="#ffffff" opacity="0.8" />
                    <!-- Fringe strings hanging beneath the ball -->
                    <g class="tassel-fringe">
                        <line x1="184" y1="138" x2="177" y2="154" stroke="#f5ebdc" stroke-width="1.4" stroke-linecap="round" />
                        <line x1="184" y1="138" x2="184" y2="156" stroke="#f5ebdc" stroke-width="1.4" stroke-linecap="round" />
                        <line x1="184" y1="138" x2="191" y2="154" stroke="#f5ebdc" stroke-width="1.4" stroke-linecap="round" />
                    </g>
                </g>

                <!-- ───── OPEN BOOK (V-shape with two pages, spine, text lines) ───── -->
                <!-- Page left -->
                <path class="draw s3" d="M28 148 L100 132 L100 174 L28 168 Z" />
                <path class="fill-book-left" d="M28 148 L100 132 L100 174 L28 168 Z" fill="#f5ebdc" />

                <!-- Page right -->
                <path class="draw s3" d="M172 148 L100 132 L100 174 L172 168 Z" />
                <path class="fill-book-right" d="M172 148 L100 132 L100 174 L172 168 Z" fill="#f5ebdc" opacity="0.92" />

                <!-- Center spine line -->
                <line class="book-spine" x1="100" y1="132" x2="100" y2="174" stroke="#8b7355" stroke-width="1.4" stroke-linecap="round" />

                <!-- Soft text-line suggestion (left page, follows page slope) -->
                <g class="book-text-lines">
                    <line x1="40" y1="155" x2="90" y2="146" stroke="#8b7355" stroke-width="1.1" stroke-linecap="round" />
                    <line x1="40" y1="161" x2="90" y2="153" stroke="#8b7355" stroke-width="1.1" stroke-linecap="round" />
                    <line x1="40" y1="167" x2="90" y2="160" stroke="#8b7355" stroke-width="1.1" stroke-linecap="round" />
                </g>

                <!-- Soft text-line suggestion (right page) -->
                <g class="book-text-lines">
                    <line x1="110" y1="146" x2="160" y2="155" stroke="#8b7355" stroke-width="1.1" stroke-linecap="round" />
                    <line x1="110" y1="153" x2="160" y2="161" stroke="#8b7355" stroke-width="1.1" stroke-linecap="round" />
                    <line x1="110" y1="160" x2="160" y2="167" stroke="#8b7355" stroke-width="1.1" stroke-linecap="round" />
                </g>
            </svg>

            <div class="logo-wordmark">
                APMoodle
                <span class="tag">LEARN  ·  TEACH  ·  GROW</span>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE (form) -->
    <div class="login-right">

        <!-- Toggle -->
        <div class="toggle-box">
            <button type="button" id="loginTab">Login</button>
            <button type="button" class="active" id="registerTab">Register</button>
        </div>

        <h2>CREATE ACCOUNT</h2>

        <!-- Server messages -->
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            if (Model.IsSuccess)
            {
                <div class="alert-success">
                    ✅ @Model.Message
                </div>
            }
            else if (Model.ShowPendingMessage)
            {
                <div class="alert-pending">
                    <i class="fas fa-clock"></i>
                    <strong>Pending Approval</strong>
                    <p style="margin: 6px 0 0;">Your registration is pending admin approval. You will receive an email when your account is activated.</p>
                </div>
            }
            else
            {
                <div class="alert-error">
                    ❌ @Model.Message
                </div>
            }
        }

        <!-- Validation Summary -->
        <div class="validation-summary" id="validationSummary">
            <h4><i class="fas fa-exclamation-circle"></i> Please fix the following errors:</h4>
            <ul id="validationList"></ul>
        </div>

        <form method="post" id="registerForm">
            <!-- Full Name -->
            <div class="form-group" id="nameGroup">
                <label>FULL NAME <span class="required">*</span></label>
                <input type="text" name="FullName" id="FullName" placeholder="Enter Full Name" />
                <div class="error-message" id="nameError">Please enter a valid name (at least 2 characters).</div>
                <div class="validation-success" id="nameSuccess"><i class="fas fa-check-circle"></i> Valid</div>
            </div>

            <!-- Date of Birth (flatpickr) -->
            <div class="form-group" id="dobGroup">
                <label>DATE OF BIRTH <span class="required">*</span></label>
                <input type="text" id="dob" name="Dob" placeholder="Select Date of Birth" />
                <div class="error-message" id="dobError">Please select a valid date of birth (must be 15-80 years old).</div>
                <div class="validation-success" id="dobSuccess"><i class="fas fa-check-circle"></i> Valid</div>
            </div>

            <!-- Contact Number -->
            <div class="form-group" id="contactGroup">
                <label>CONTACT NUMBER <span class="required">*</span></label>
                <input type="text" name="Contact" id="Contact" placeholder="Enter Contact Number" />
                <div class="error-message" id="contactError">Please enter a valid phone number (10-11 digits, starting with 0).</div>
                <div class="validation-success" id="contactSuccess"><i class="fas fa-check-circle"></i> Valid</div>
            </div>

            <!-- Email -->
            <div class="form-group" id="emailGroup">
                <label>EMAIL <span class="required">*</span></label>
                <input type="email" name="Email" id="Email" placeholder="Enter Email" />
                <div class="error-message" id="emailError">Please enter a valid email address.</div>
                <div class="validation-success" id="emailSuccess"><i class="fas fa-check-circle"></i> Valid</div>
            </div>

            <!-- Gender -->
            <div class="form-group" id="genderGroup">
                <label>GENDER <span class="required">*</span></label>
                <select name="Gender" id="Gender">
                    <option value="">-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
                <div class="error-message" id="genderError">Please select a gender.</div>
                <div class="validation-success" id="genderSuccess"><i class="fas fa-check-circle"></i> Valid</div>
            </div>

            <button type="submit" class="btn-login" id="registerBtn">REGISTER</button>
        </form>

        <div class="register-text">
            Already Have Account ?
            <a href="/FrontEnd/Login">SIGN IN</a>
        </div>

    </div>

</div>

<script src="~/js/loader.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="~/js/register.js" asp-append-version="true"></script>

</body>
</html>