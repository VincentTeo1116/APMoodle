    }
    .cq-mini-studio .cq-mini-studio-line { background: #6366f1; height: 4px; border-radius: 2px; opacity: .85; }
    .cq-mini-studio .cq-mini-studio-line.short { width: 60%; opacity: .55; }
    .cq-mini-studio .cq-mini-studio-pill {
        height: 8px; border-radius: 4px;
        background: linear-gradient(90deg, rgba(99, 102, 241, .15), rgba(168, 85, 247, .15));
        border: 1px solid rgba(99, 102, 241, .25);
        margin-top: 1px;
    }

    /* Forest mini */
    .cq-mini-forest { background: linear-gradient(135deg, #d8e8c4 0%, #f0ebd8 60%, #e9d6b6 100%); position: relative; padding: 8px; display: flex; align-items: center; justify-content: center; }
    .cq-mini-forest .cq-mini-leaf { position: absolute; top: 6px; left: 6px; width: 22px; height: 22px; background: #7ba05b; clip-path: polygon(50% 5%, 95% 50%, 50% 95%, 5% 50%); opacity: .6; transform: rotate(-20deg); }
    .cq-mini-forest .cq-mini-forest-card { background: #fdfbf3; border-radius: 5px; padding: 6px 8px; width: 80%; display: flex; flex-direction: column; gap: 3px; box-shadow: 0 2px 6px rgba(45, 80, 22, .2); }
    .cq-mini-forest .cq-mini-forest-pill { height: 5px; width: 30%; background: #2d5016; border-radius: 3px; }
    .cq-mini-forest .cq-mini-forest-row { height: 6px; background: rgba(45, 80, 22, .25); border-radius: 3px; }
    .cq-mini-forest .cq-mini-forest-row.short { width: 60%; }

    /* Ocean mini */
    .cq-mini-ocean { background: linear-gradient(180deg, #caf0f8 0%, #90e0ef 60%, #00b4d8 100%); position: relative; padding: 6px; display: flex; align-items: center; justify-content: center; }
    .cq-mini-ocean .cq-mini-ocean-wave { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 30px; }
    .cq-mini-ocean .cq-mini-ocean-card { background: #fff; border-radius: 5px; padding: 7px 9px; width: 80%; display: flex; flex-direction: column; gap: 4px; box-shadow: 0 2px 8px rgba(0, 71, 130, .2); position: relative; z-index: 1; }
    .cq-mini-ocean .cq-mini-ocean-row { height: 6px; background: #00b4d8; border-radius: 3px; opacity: .8; }
    .cq-mini-ocean .cq-mini-ocean-row.short { width: 55%; opacity: .5; }

    /* Sunset mini */
    .cq-mini-sunset { background: linear-gradient(180deg, #ffe5b4 0%, #ffb88c 40%, #ff8e9e 75%, #c084fc 100%); position: relative; padding: 6px; display: flex; align-items: center; justify-content: center; }
    .cq-mini-sunset .cq-mini-sun { position: absolute; width: 50px; height: 50px; background: radial-gradient(circle, #fff9c4, #ffb74d 60%, transparent 75%); border-radius: 50%; top: 18px; left: 50%; transform: translateX(-50%); filter: blur(3px); }
    .cq-mini-sunset .cq-mini-sunset-card { background: rgba(255,255,255,.78); backdrop-filter: blur(4px); border-radius: 6px; padding: 7px 9px; width: 80%; display: flex; flex-direction: column; gap: 4px; position: relative; z-index: 1; }
    .cq-mini-sunset .cq-mini-sunset-row { height: 6px; background: linear-gradient(90deg, #fb923c, #ec4899); border-radius: 3px; }
    .cq-mini-sunset .cq-mini-sunset-row.short { width: 55%; opacity: .55; }

    /* Corporate mini */
    .cq-mini-corp { background: #f5f7fa; padding: 0; display: flex; flex-direction: column; }
    .cq-mini-corp .cq-mini-corp-bar { height: 6px; background: linear-gradient(90deg, #1e3a8a, #2563eb); }
    .cq-mini-corp .cq-mini-corp-rows { flex: 1; padding: 10px 12px; display: flex; flex-direction: column; gap: 5px; }
    .cq-mini-corp .cq-mini-corp-rows i { height: 5px; background: #cbd5e1; border-radius: 1px; }
    .cq-mini-corp .cq-mini-corp-rows i:first-child { background: #1e3a8a; width: 70%; height: 6px; }

    /* Office mini */
    .cq-mini-office { background: #faf9f8; padding: 8px; display: flex; align-items: center; justify-content: center; }
    .cq-mini-office .cq-mini-office-card { width: 90%; background: #fff; border-radius: 3px; padding: 0 0 6px; box-shadow: 0 2px 4px rgba(0,0,0,.08); overflow: hidden; }
    .cq-mini-office .cq-mini-office-band { height: 5px; background: #0078d4; }
    .cq-mini-office .cq-mini-office-row { height: 5px; background: #c8c6c4; margin: 5px 8px 0; border-radius: 1px; }
    .cq-mini-office .cq-mini-office-row.short { width: 55%; opacity: .65; }

    /* Classic (Google Forms) mini */
    .cq-mini-classic { background: #f0ebf8; padding: 8px; display: flex; align-items: center; justify-content: center; }
    .cq-mini-classic .cq-mini-classic-card { width: 90%; background: #fff; border-radius: 5px; box-shadow: 0 1px 3px rgba(60, 64, 67, .2); overflow: hidden; }
    .cq-mini-classic .cq-mini-classic-stripe { height: 8px; background: #673ab7; }
    .cq-mini-classic .cq-mini-classic-row { height: 5px; background: #5f6368; opacity: .35; margin: 5px 10px 0; border-radius: 1px; }
    .cq-mini-classic .cq-mini-classic-row.short { width: 55%; opacity: .55; background: #673ab7; }

    /* Comic mini */
    .cq-mini-comic { background: #fff7c2; background-image: radial-gradient(circle, rgba(0,0,0,.15) 1px, transparent 1.5px); background-size: 7px 7px; position: relative; padding: 6px; display: flex; align-items: center; justify-content: center; }
    .cq-mini-comic .cq-mini-comic-burst { position: absolute; top: 4px; right: 4px; font-family: 'Bangers', sans-serif; background: #f43f5e; color: #fff; padding: 2px 6px; font-size: 9px; transform: rotate(8deg); border: 1px solid #000; text-shadow: 1px 1px 0 #000; }
    .cq-mini-comic .cq-mini-comic-card { background: #fff; border: 2px solid #000; border-radius: 4px; padding: 5px; width: 80%; box-shadow: 3px 3px 0 #000; }
    .cq-mini-comic .cq-mini-comic-bubble { display: block; height: 8px; background: #000; opacity: .2; border-radius: 3px; margin-bottom: 4px; }
    .cq-mini-comic .cq-mini-comic-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; }
    .cq-mini-comic .cq-mini-comic-grid > span { height: 14px; border: 1.5px solid #000; border-radius: 2px; }
    .cq-mini-comic .r { background: #f43f5e; } .cq-mini-comic .b { background: #3b82f6; }
    .cq-mini-comic .y { background: #facc15; } .cq-mini-comic .g { background: #22c55e; }

    /* Notebook mini */
    .cq-mini-nb { background: #fdfcf6; background-image: linear-gradient(rgba(180, 30, 30, .35) 0 0), repeating-linear-gradient(transparent 0, transparent 9px, #c0d6f0 10px); background-size: 2px 100%, 100% 100%; background-position: 22px 0, 0 8px; background-repeat: no-repeat, repeat; padding: 8px 8px 8px 28px; position: relative; }
    .cq-mini-nb .cq-mini-nb-tape { position: absolute; top: 4px; right: 6px; font-size: 14px; transform: rotate(8deg); }
    .cq-mini-nb .cq-mini-nb-lines { display: flex; flex-direction: column; gap: 5px; padding-top: 4px; }
    .cq-mini-nb .cq-mini-nb-lines i { display: block; height: 4px; background: #475569; opacity: .55; border-radius: 1px; }
    .cq-mini-nb .cq-mini-nb-lines i:first-child { background: #ec4899; width: 50%; }
    .cq-mini-nb .cq-mini-nb-lines i:nth-child(2) { width: 75%; }
    .cq-mini-nb .cq-mini-nb-lines i:nth-child(3) { width: 65%; }
    .cq-mini-nb .cq-mini-nb-lines i:nth-child(4) { width: 70%; }

    /* Galaxy mini */
    .cq-mini-gx { background: radial-gradient(ellipse at top right, #4c1d95 0%, transparent 60%), radial-gradient(ellipse at bottom left, #831843 0%, transparent 60%), linear-gradient(180deg, #0c0a3e, #1e1b4b); position: relative; padding: 8px; display: flex; align-items: center; justify-content: center; }
    .cq-mini-gx .cq-mini-gx-star { position: absolute; width: 2px; height: 2px; background: #fff; border-radius: 50%; box-shadow: 0 0 3px #fff; }
    .cq-mini-gx .s1 { top: 12px; left: 18px; } .cq-mini-gx .s2 { top: 22px; right: 22px; background: #fde68a; box-shadow: 0 0 4px #fde68a; }
    .cq-mini-gx .s3 { bottom: 12px; left: 30px; } .cq-mini-gx .s4 { bottom: 20px; right: 14px; }
    .cq-mini-gx .cq-mini-gx-card { background: rgba(15, 12, 60, .65); backdrop-filter: blur(4px); border: 1px solid rgba(168, 85, 247, .4); border-radius: 5px; padding: 6px 8px; width: 80%; display: flex; flex-direction: column; gap: 4px; position: relative; z-index: 1; box-shadow: 0 0 10px rgba(168, 85, 247, .35); }
    .cq-mini-gx .cq-mini-gx-row { height: 5px; background: linear-gradient(90deg, #a855f7, #ec4899); border-radius: 2px; opacity: .85; }
    .cq-mini-gx .cq-mini-gx-row.short { width: 55%; opacity: .55; }

    /* Terminal mini */
    .cq-mini-tm { background: #1e1e2e; display: flex; flex-direction: column; padding: 0; }
    .cq-mini-tm .cq-mini-tm-bar { display: flex; gap: 3px; padding: 4px 6px; background: #2a2a3a; }
    .cq-mini-tm .cq-mini-tm-bar span { width: 5px; height: 5px; border-radius: 50%; }
    .cq-mini-tm .cq-mini-tm-bar span:nth-child(1) { background: #ed8796; }
    .cq-mini-tm .cq-mini-tm-bar span:nth-child(2) { background: #eed49f; }
    .cq-mini-tm .cq-mini-tm-bar span:nth-child(3) { background: #a6da95; }
    .cq-mini-tm .cq-mini-tm-body { flex: 1; padding: 6px 8px; font-family: 'JetBrains Mono', monospace; font-size: 8px; line-height: 1.6; }
    .cq-mini-tm .cq-mini-tm-c { color: #6c7086; font-style: italic; display: block; }
    .cq-mini-tm .cq-mini-tm-l { color: #a6da95; display: block; }
    .cq-mini-tm .cq-mini-tm-l.short { color: #f9e2af; }

    /* Watercolor mini */
    .cq-mini-wc { background: #fdfaf3; position: relative; padding: 6px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .cq-mini-wc .cq-mini-wc-wash { position: absolute; border-radius: 50%; filter: blur(14px); }
    .cq-mini-wc .cq-mini-wc-wash.a { width: 80px; height: 80px; background: #fda4af; opacity: .55; top: -20px; left: -16px; }
    .cq-mini-wc .cq-mini-wc-wash.b { width: 60px; height: 60px; background: #fcd34d; opacity: .5; bottom: -10px; right: -10px; }
    .cq-mini-wc .cq-mini-wc-card { background: rgba(255, 252, 245, .85); border-radius: 3px; padding: 6px 8px; width: 75%; display: flex; flex-direction: column; gap: 4px; position: relative; z-index: 1; box-shadow: 0 2px 6px rgba(120, 53, 15, .14); }
    .cq-mini-wc .cq-mini-wc-row { height: 5px; background: #b91c1c; opacity: .55; border-radius: 1px; }
    .cq-mini-wc .cq-mini-wc-row.short { width: 55%; opacity: .3; background: #92400e; }

    /* Newspaper mini */
    .cq-mini-np { background: #faf3df; padding: 5px 6px; display: flex; flex-direction: column; gap: 4px; }
    .cq-mini-np .cq-mini-np-banner { font-family: 'Playfair Display', serif; font-weight: 900; font-size: 11px; text-align: center; color: #1a1612; border-bottom: 1.5px double #1a1612; padding-bottom: 2px; letter-spacing: 1px; }
    .cq-mini-np .cq-mini-np-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; flex: 1; }
    .cq-mini-np .cq-mini-np-cols > div { display: flex; flex-direction: column; gap: 2px; padding-right: 4px; border-right: 1px solid #c4b59a; }
    .cq-mini-np .cq-mini-np-cols > div:last-child { border: none; }
    .cq-mini-np .cq-mini-np-cols i { display: block; height: 3px; background: #1a1612; opacity: .55; border-radius: 1px; }
    .cq-mini-np .cq-mini-np-cols i.short { width: 60%; opacity: .3; }

    /* Kahoot mini */
    .cq-mini-kahoot { background: linear-gradient(135deg, #46178f, #864cd1); padding: 10px 8px; }
    .cq-mini-kahoot .cq-mini-bar { background: rgba(255,255,255,.85); border-radius: 3px; height: 8px; margin-bottom: 6px; }
    .cq-mini-kahoot .cq-mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    .cq-mini-kahoot .cq-mini-grid > span {
        height: 22px; border-radius: 4px; display: flex; align-items: center; justify-content: center;
    }
    .cq-mini-kahoot .cq-mini-grid > span b { display: inline-block; width: 8px; height: 8px; background: #fff; }
    .cq-mini-kahoot .t1 { background: #e21b3c; } .cq-mini-kahoot .t1 b { clip-path: polygon(50% 0, 0 100%, 100% 100%); }
    .cq-mini-kahoot .t2 { background: #1368ce; } .cq-mini-kahoot .t2 b { clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); }
    .cq-mini-kahoot .t3 { background: #d89e00; } .cq-mini-kahoot .t3 b { border-radius: 50%; }
    .cq-mini-kahoot .t4 { background: #26890c; } .cq-mini-kahoot .t4 b { border-radius: 2px; }

    /* Exam mini */
    .cq-mini-exam {
        background:
            repeating-linear-gradient(transparent, transparent 9px, rgba(180, 140, 90, .35) 10px),
            #fdf8ec;
    }
    .cq-mini-exam .cq-mini-margin { position: absolute; left: 18px; top: 0; bottom: 0; width: 1.5px; background: rgba(180, 30, 30, .55); }
    .cq-mini-exam .cq-mini-lines { padding: 8px 8px 0 24px; display: flex; flex-direction: column; gap: 5px; }
    .cq-mini-exam .cq-mini-lines i { display: block; height: 4px; background: #2b2018; border-radius: 1px; opacity: .55; }
    .cq-mini-exam .cq-mini-lines i:nth-child(1) { width: 80%; background: #b81e1e; opacity: .85; }
    .cq-mini-exam .cq-mini-lines i:nth-child(2) { width: 65%; }
    .cq-mini-exam .cq-mini-lines i:nth-child(3) { width: 70%; }
    .cq-mini-exam .cq-mini-lines i:nth-child(4) { width: 60%; }
    .cq-mini-exam .cq-mini-lines i:nth-child(5) { width: 75%; }

    /* Chat mini */
    .cq-mini-chat { background: #ece5dd; padding: 8px; display: flex; flex-direction: column; gap: 4px; }
    .cq-mini-chat .cq-mini-chathead {
        background: linear-gradient(135deg, #25d366, #128c7e);
        height: 14px; border-radius: 7px 7px 2px 2px; margin: -8px -8px 4px;
    }
    .cq-mini-chat .cq-mini-bub { height: 10px; border-radius: 6px; box-shadow: 0 1px 1px rgba(0,0,0,.1); }
    .cq-mini-chat .cq-mini-bub-l { background: #fff; width: 60%; align-self: flex-start; border-bottom-left-radius: 2px; }
    .cq-mini-chat .cq-mini-bub-r { background: #dcf8c6; width: 40%; align-self: flex-end; border-bottom-right-radius: 2px; }
    .cq-mini-chat .cq-mini-bub.short { width: 45%; }

    /* Arcade mini */
    .cq-mini-arcade {
        background: radial-gradient(ellipse at center, #0d041a 0%, #050208 100%);
        border: 1px solid #ff00ea; padding: 8px 6px;
        display: flex; flex-direction: column; gap: 5px;
    }
    .cq-mini-arcade .cq-mini-arc-title {
        font-family: 'Press Start 2P', monospace; font-size: 7px;
        color: #00ffe1; text-shadow: 0 0 4px #00ffe1; text-align: center;
        letter-spacing: 1px;
    }
    .cq-mini-arcade .cq-mini-arc-row { background: rgba(0,255,225,.25); border: 1px solid #00ffe1; height: 8px; border-radius: 1px; }
    .cq-mini-arcade .cq-mini-arc-row.short { width: 60%; border-color: #ff5af2; background: rgba(255, 90, 242, .25); }

    /* ── Question cards ── */
    .cq-count {
        display: inline-block; background: #f1f5f9; color: #44403c;
        padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 600;
        margin-left: 6px;
    }
    .cq-questions { display: flex; flex-direction: column; gap: 14px; }
    .cq-question {
        border: 1px solid #ece7df; border-radius: 12px; padding: 18px;
        background: #fafbfc; transition: border-color .15s, background .15s;
        scroll-margin-top: 80px;
    }
    .cq-question:focus-within { border-color: #b8935a; background: #fff; }
    .cq-question[data-complete="1"] { border-color: #86efac; background: #f0fdf4; }

    .cq-q-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .cq-q-head-left { display: flex; align-items: center; gap: 8px; }
    .cq-q-num {
        background: linear-gradient(135deg, #c9a24b, #8b7355); color: #fff;
        padding: 4px 12px; border-radius: 999px; font-size: 13px; font-weight: 700;
    }
    .cq-q-state {
        font-size: 11px; color: #b45309; background: #fef3c7;
        padding: 3px 10px; border-radius: 999px; font-weight: 600;
    }
    .cq-q-state.ok { color: #15803d; background: #dcfce7; }
    .cq-q-remove {
        background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;
        width: 30px; height: 30px; border-radius: 8px; cursor: pointer;
        font-weight: 700; transition: all .15s;
    }
    .cq-q-remove:hover { background: #dc2626; color: #fff; border-color: #dc2626; }

    .cq-q-text-field { margin-bottom: 14px; }

    /* Options as rows with inline correct toggle */
    .cq-options-grid { display: flex; flex-direction: column; gap: 8px; }
    .cq-opt-row {
        display: grid; grid-template-columns: 32px 1fr auto; gap: 10px; align-items: center;
        background: #fff; border: 1.5px solid #ece7df; border-radius: 8px;
        padding: 8px 12px; transition: all .15s;
    }
    .cq-opt-row:focus-within { border-color: #b8935a; }
    .cq-opt-letter {
        width: 28px; height: 28px; border-radius: 6px;
        background: #f1f5f9; color: #44403c;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 13px; flex-shrink: 0;
    }
    .cq-opt-row > input[type="text"], .cq-opt-row > input:not([type="radio"]) {
        border: none; outline: none; font-size: 14px; background: transparent; padding: 4px 0;
        min-width: 0;
    }

    .cq-correct-toggle { cursor: pointer; user-select: none; flex-shrink: 0; }
    .cq-correct-toggle input { display: none; }
    .cq-correct-toggle > span {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 6px 12px; border-radius: 999px;
        border: 1.5px solid #ece7df; background: #fff;
        font-size: 12px; font-weight: 600; color: #78716c;
        transition: all .15s;
    }
    .cq-correct-toggle .cq-correct-mark { font-weight: 800; }
    .cq-correct-toggle:hover > span { border-color: #86efac; color: #16a34a; }
    .cq-correct-toggle input:checked + span {
        background: #16a34a; color: #fff; border-color: #16a34a;
        box-shadow: 0 2px 6px rgba(22, 163, 74, .3);
    }
    /* Highlight the row containing the chosen correct answer */
    .cq-opt-row:has(.cq-correct-toggle input:checked) {
        background: linear-gradient(90deg, #dcfce7 0%, transparent 100%);
        border-color: #86efac;
    }
    .cq-opt-row:has(.cq-correct-toggle input:checked) .cq-opt-letter {
        background: #16a34a; color: #fff;
    }

    .cq-opt-errs { display: flex; flex-direction: column; gap: 2px; margin-top: 6px; }

    .cq-add-q {
        margin-top: 14px; width: 100%;
        padding: 14px; border: 2px dashed #cbd5e1; border-radius: 10px;
        background: transparent; color: #78716c; font-weight: 600;
        cursor: pointer; transition: all .15s; font-size: 14px;
    }
    .cq-add-q:hover { border-color: #b8935a; color: #b8935a; background: #f4ecdd; }
    .cq-add-q span { font-size: 18px; margin-right: 4px; }

    /* ── Right rail ── */
    .cq-rail { position: sticky; top: 80px; }
    .cq-rail-card {
        background: #fff; border: 1px solid #ece7df; border-radius: 14px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, .04); overflow: hidden;
    }
    .cq-rail-head {
        display: flex; justify-content: space-between; align-items: center;
        padding: 14px 16px; background: #f8fafc;
        border-bottom: 1px solid #ece7df;
        font-weight: 700; font-size: 14px; color: #1c1917;
    }
    .cq-rail-count {
        background: #6b5d4f; color: #fff;
        padding: 2px 10px; border-radius: 999px;
        font-size: 12px; font-weight: 700;
    }
