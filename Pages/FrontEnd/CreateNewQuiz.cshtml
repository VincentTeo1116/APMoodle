@page
@model APMoodle.Pages.BackEnd.CreateNewQuizModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create New Quiz";

    bool IsComplete(APMoodle.Pages.BackEnd.CreateNewQuizModel.QuestionInput q) =>
        !string.IsNullOrWhiteSpace(q.QuestionText)
        && !string.IsNullOrWhiteSpace(q.Option1)
        && !string.IsNullOrWhiteSpace(q.Option2)
        && !string.IsNullOrWhiteSpace(q.Option3)
        && !string.IsNullOrWhiteSpace(q.Option4)
        && !string.IsNullOrWhiteSpace(q.CorrectAnswer);
}

@*
    Front-end / styling: Moses
    Backend contract (UNCHANGED — do not touch page model):
      asp-for bindings: MaterialId (hidden), Title, Subject, Theme,
        Questions[i].QuestionID, .QuestionText, .Option1..4, .CorrectAnswer
      Handlers: AddQuestion, RemoveQuestion?index=N, Save
    Theme posts one of: "Midterm" | "Mid-term" | "Edited" | "lab".
*@
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<div id="horizontalNavbar">
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
        <p class="path">Lecturer Dashboard &gt; @(Model.CurrentMaterial?.Title) &gt; @ViewData["Title"]</p>
    </div>

    <div class="PageComponent">
        <div class="cq-page">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="cq-alert">@Model.Message</div>
            }

            <form method="post" class="cq-form" id="cqForm">
                <input type="hidden" asp-for="MaterialId" />

                <div class="cq-layout">
                    <div class="cq-main">

                        <!-- ── Quiz Info ── -->
                        <section class="cq-card">
                            <header class="cq-card-head">
                                <div class="cq-card-icon">📝</div>
                                <div>
                                    <h2>Quiz Info</h2>
                                    <small>Attaching to: <strong>@(Model.CurrentMaterial?.Title ?? "—")</strong></small>
                                </div>
                            </header>

                            <div class="cq-meta-grid">
                                <div class="cq-field">
                                    <label asp-for="Title">Quiz Title</label>
                                    <input asp-for="Title" maxlength="200" placeholder="e.g. Evaporative Cooling Quiz" />
                                    <span asp-validation-for="Title" class="cq-err"></span>
                                </div>
                                <div class="cq-field">
                                    <label asp-for="Subject">Subject</label>
                                    <input asp-for="Subject" maxlength="50" placeholder="e.g. Thermodynamics" />
                                    <span asp-validation-for="Subject" class="cq-err"></span>
                                </div>
                                <div class="cq-field" style="grid-column: 1 / -1;">
                                    <div class="toggle-wrapper">
                                        <label class="toggle-switch">
                                            <input type="checkbox" asp-for="IsPublic" />
                                            <span class="toggle-slider"></span>
                                        </label>
                                        <span class="toggle-label">
                                            <i class="bi bi-globe"></i> Make this quiz public
                                        </span>
                                        <small style="display: block; color: #cc8282; margin-top: 4px; font-size: 10px">
                                            *If checked, guests can take this quiz without logging in.
                                        </small>
                                    </div>
                                    <span asp-validation-for="IsPublic" class="cq-err"></span>
                                </div>
                            </div>
                        </section>

                        <!-- ── Theme chooser ── -->
                        <section class="cq-card">
                            <header class="cq-card-head">
                                <div class="cq-card-icon">🎨</div>
                                <div>
                                    <h2>Quiz Theme</h2>
                                    <small>The look students will see. Hover a card for details.</small>
                                </div>
                            </header>

                            <div class="cq-themes">
                                @{
                                    var themes = new[]
                                    {
                                        ("Default",   "Default (recommended)", "Clean glass card on a soft gradient — modern, friendly, distraction-free.",  "studio"),
                                        ("Forest",    "Forest 🌿",             "Sage-green & cream tones, leaf accents — calming and easy on the eyes.",    "forest"),
                                        ("Comic",     "Comic 💥",              "Pop-art comic book — subtle dots, speech bubble, pastel answer tiles.",     "comic"),
                                        ("Watercolor","Watercolor 🎨",         "Soft watercolor washes, serif title, brush underline — gentle and elegant.", "water"),
                                        ("Midterm",   "Kahoot game show",      "Bold colored answer tiles, big timer, score counter — game-show vibes.",    "kahoot"),
                                    };
                                    var currentTheme = string.IsNullOrEmpty(Model.Theme) ? "Default" : Model.Theme;
                                }
                                @foreach (var (val, name, desc, mini) in themes)
                                {
                                    <label class="cq-theme">
                                        <input type="radio" asp-for="Theme" value="@val" checked="@(currentTheme == val)" />
                                        <div class="cq-theme-card">
                                            @switch (mini)
                                            {
                                                case "studio":
                                                    <div class="cq-mini cq-mini-studio">
                                                        <div class="cq-mini-studio-card">
                                                            <span class="cq-mini-studio-dot"></span>
                                                            <i class="cq-mini-studio-line"></i>
                                                            <i class="cq-mini-studio-line short"></i>
                                                            <i class="cq-mini-studio-pill"></i>
                                                            <i class="cq-mini-studio-pill"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "forest":
                                                    <div class="cq-mini cq-mini-forest">
                                                        <span class="cq-mini-leaf"></span>
                                                        <div class="cq-mini-forest-card">
                                                            <i class="cq-mini-forest-pill"></i>
                                                            <i class="cq-mini-forest-row"></i>
                                                            <i class="cq-mini-forest-row short"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "ocean":
                                                    <div class="cq-mini cq-mini-ocean">
                                                        <svg viewBox="0 0 80 30" preserveAspectRatio="none" class="cq-mini-ocean-wave"><path d="M0,20 Q20,10 40,20 T80,20 L80,30 L0,30 Z" fill="#0077b6" opacity=".45"/></svg>
                                                        <div class="cq-mini-ocean-card">
                                                            <i class="cq-mini-ocean-row"></i>
                                                            <i class="cq-mini-ocean-row short"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "sunset":
                                                    <div class="cq-mini cq-mini-sunset">
                                                        <div class="cq-mini-sun"></div>
                                                        <div class="cq-mini-sunset-card">
                                                            <i class="cq-mini-sunset-row"></i>
                                                            <i class="cq-mini-sunset-row short"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "corp":
                                                    <div class="cq-mini cq-mini-corp">
                                                        <div class="cq-mini-corp-bar"></div>
                                                        <div class="cq-mini-corp-rows">
                                                            <i></i><i></i><i></i><i></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "office":
                                                    <div class="cq-mini cq-mini-office">
                                                        <div class="cq-mini-office-card">
                                                            <div class="cq-mini-office-band"></div>
                                                            <i class="cq-mini-office-row"></i>
                                                            <i class="cq-mini-office-row short"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "classic":
                                                    <div class="cq-mini cq-mini-classic">
                                                        <div class="cq-mini-classic-card">
                                                            <div class="cq-mini-classic-stripe"></div>
                                                            <i class="cq-mini-classic-row"></i>
                                                            <i class="cq-mini-classic-row short"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "comic":
                                                    <div class="cq-mini cq-mini-comic">
                                                        <span class="cq-mini-comic-burst">POW!</span>
                                                        <div class="cq-mini-comic-card">
                                                            <i class="cq-mini-comic-bubble"></i>
                                                            <div class="cq-mini-comic-grid">
                                                                <span class="r"></span><span class="b"></span>
                                                                <span class="y"></span><span class="g"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "notebook":
                                                    <div class="cq-mini cq-mini-nb">
                                                        <span class="cq-mini-nb-tape">📌</span>
                                                        <div class="cq-mini-nb-lines"><i></i><i></i><i></i><i></i></div>
                                                    </div>
                                                    break;
                                                case "galaxy":
                                                    <div class="cq-mini cq-mini-gx">
                                                        <span class="cq-mini-gx-star s1"></span>
                                                        <span class="cq-mini-gx-star s2"></span>
                                                        <span class="cq-mini-gx-star s3"></span>
                                                        <span class="cq-mini-gx-star s4"></span>
                                                        <div class="cq-mini-gx-card">
                                                            <i class="cq-mini-gx-row"></i>
                                                            <i class="cq-mini-gx-row short"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "term":
                                                    <div class="cq-mini cq-mini-tm">
                                                        <div class="cq-mini-tm-bar"><span></span><span></span><span></span></div>
                                                        <div class="cq-mini-tm-body">
                                                            <i class="cq-mini-tm-c">// q</i>
                                                            <i class="cq-mini-tm-l">const x = "..";</i>
                                                            <i class="cq-mini-tm-l short">[A] → "..";</i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "water":
                                                    <div class="cq-mini cq-mini-wc">
                                                        <span class="cq-mini-wc-wash a"></span>
                                                        <span class="cq-mini-wc-wash b"></span>
                                                        <div class="cq-mini-wc-card">
                                                            <i class="cq-mini-wc-row"></i>
                                                            <i class="cq-mini-wc-row short"></i>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "news":
                                                    <div class="cq-mini cq-mini-np">
                                                        <div class="cq-mini-np-banner">TIMES</div>
                                                        <div class="cq-mini-np-cols">
                                                            <div><i></i><i class="short"></i><i></i></div>
                                                            <div><i></i><i></i><i class="short"></i></div>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "kahoot":
                                                    <div class="cq-mini cq-mini-kahoot">
                                                        <div class="cq-mini-bar"></div>
                                                        <div class="cq-mini-grid">
                                                            <span class="t1"><b></b></span><span class="t2"><b></b></span>
                                                            <span class="t3"><b></b></span><span class="t4"><b></b></span>
                                                        </div>
                                                    </div>
                                                    break;
                                                case "exam":
                                                    <div class="cq-mini cq-mini-exam">
                                                        <div class="cq-mini-margin"></div>
                                                        <div class="cq-mini-lines"><i></i><i></i><i></i><i></i><i></i></div>
                                                    </div>
                                                    break;
                                                case "chat":
                                                    <div class="cq-mini cq-mini-chat">
                                                        <div class="cq-mini-chathead"></div>
                                                        <div class="cq-mini-bub cq-mini-bub-l"></div>
                                                        <div class="cq-mini-bub cq-mini-bub-r"></div>
                                                        <div class="cq-mini-bub cq-mini-bub-l short"></div>
                                                    </div>
                                                    break;
                                                case "arcade":
                                                    <div class="cq-mini cq-mini-arcade">
                                                        <div class="cq-mini-arc-title">ARCADE</div>
                                                        <div class="cq-mini-arc-row"></div>
                                                        <div class="cq-mini-arc-row short"></div>
                                                        <div class="cq-mini-arc-row"></div>
                                                    </div>
                                                    break;
                                            }
                                            <div class="cq-theme-body">
                                                <div class="cq-theme-name">@name</div>
                                                <div class="cq-theme-desc">@desc</div>
                                                <div class="cq-theme-tag"><code>@val</code></div>
                                            </div>
                                            <div class="cq-theme-check">✓</div>
                                        </div>
                                    </label>
                                }
                            </div>
                            <span asp-validation-for="Theme" class="cq-err"></span>
                        </section>

                        <!-- ── Questions ── -->
                        <section class="cq-card">
                            <header class="cq-card-head">
                                <div class="cq-card-icon"><i class="bi bi-patch-question"></i></div>
                                <div>
                                    <h2>Questions <span class="cq-count" id="cqCountBadge">@Model.Questions.Count</span></h2>
                                    <small>Tip: click the radio inside an option to mark it as the correct answer.</small>
                                </div>
                            </header>

                            <div class="cq-questions" id="cqQuestions">
                                @for (int i = 0; i < Model.Questions.Count; i++)
                                {
                                    var qDone = IsComplete(Model.Questions[i]);
                                    <article class="cq-question" id="cq-q-@i" data-idx="@i" data-complete="@(qDone ? "1" : "0")">
                                        <div class="cq-q-head">
                                            <div class="cq-q-head-left">
                                                <span class="cq-q-num">Q@(i + 1)</span>
                                                <span class="cq-q-state @(qDone ? "ok" : "")">@(qDone ? "✓ ready" : "needs answer")</span>
                                            </div>
                                            @if (Model.Questions.Count > 1)
                                            {
                                                <button type="submit"
                                                        asp-page-handler="RemoveQuestion"
                                                        asp-route-index="@i"
                                                        formnovalidate
                                                        class="cq-q-remove"
                                                        title="Remove this question"
                                                        onclick="return confirm('Remove Question @(i + 1)?');">
                                                    <i class="bi bi-x-square"></i>
                                                </button>
                                            }
                                        </div>

                                        <input type="hidden" asp-for="Questions[i].QuestionID" />

                                        <div class="cq-field cq-q-text-field">
                                            <label asp-for="Questions[i].QuestionText">Question text</label>
                                            <textarea asp-for="Questions[i].QuestionText"
                                                      maxlength="500" rows="2"
                                                      placeholder="Type the question..."
                                                      data-watch="text"></textarea>
                                            <span asp-validation-for="Questions[i].QuestionText" class="cq-err"></span>
                                        </div>

                                        <div class="cq-options-grid">
                                            @{
                                                var letters = new[] { ("A", "Option1"), ("B", "Option2"), ("C", "Option3"), ("D", "Option4") };
                                            }
                                            @for (int k = 0; k < letters.Length; k++)
                                            {
                                                var letter = letters[k].Item1;
                                                var propName = letters[k].Item2;
                                                <div class="cq-opt-row">
                                                    <span class="cq-opt-letter">@letter</span>

                                                    @if (propName == "Option1")
                                                    {
                                                        <input asp-for="Questions[i].Option1" maxlength="200" placeholder="Option @letter" data-watch="opt" />
                                                    }
                                                    else if (propName == "Option2")
                                                    {
                                                        <input asp-for="Questions[i].Option2" maxlength="200" placeholder="Option @letter" data-watch="opt" />
                                                    }
                                                    else if (propName == "Option3")
                                                    {
                                                        <input asp-for="Questions[i].Option3" maxlength="200" placeholder="Option @letter" data-watch="opt" />
                                                    }
                                                    else
                                                    {
                                                        <input asp-for="Questions[i].Option4" maxlength="200" placeholder="Option @letter" data-watch="opt" />
                                                    }

                                                    <label class="cq-correct-toggle" title="Mark as correct answer">
                                                        <input type="radio"
                                                               asp-for="Questions[i].CorrectAnswer"
                                                               value="@letter"
                                                               data-watch="correct" />
                                                        <span><span class="cq-correct-mark"><i class="bi bi-check2-all"></i></span> correct</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                        <div class="cq-opt-errs">
                                            <span asp-validation-for="Questions[i].Option1" class="cq-err"></span>
                                            <span asp-validation-for="Questions[i].Option2" class="cq-err"></span>
                                            <span asp-validation-for="Questions[i].Option3" class="cq-err"></span>
                                            <span asp-validation-for="Questions[i].Option4" class="cq-err"></span>
                                            <span asp-validation-for="Questions[i].CorrectAnswer" class="cq-err"></span>
                                        </div>
                                    </article>
                                }
                            </div>

                            <button type="submit" asp-page-handler="AddQuestion" formnovalidate class="cq-add-q">
                                <span>+</span> Add another question
                            </button>
                        </section>
                    </div>

                    <!-- ── Sticky right rail: question navigator ── -->
                    <aside class="cq-rail">
                        <div class="cq-rail-card">
                            <div class="cq-rail-head">
                                <span>Questions</span>
                                <span class="cq-rail-count"><span id="cqDoneCount">0</span>/@Model.Questions.Count</span>
                            </div>
                            <div class="cq-rail-list" id="cqRailList">
                                @for (int i = 0; i < Model.Questions.Count; i++)
                                {
                                    var qDone = IsComplete(Model.Questions[i]);
                                    <a href="#cq-q-@i" class="cq-rail-item" data-jump-idx="@i">
                                        <span class="cq-rail-dot @(qDone ? "ok" : "")"></span>
                                        <span>Question @(i + 1)</span>
                                    </a>
                                }
                            </div>
                        </div>
                    </aside>
                </div>

                <!-- ── Sticky actions ── -->
                <div class="cq-actions">
                    <a href="/FrontEnd/TeachingMaterialOverview/@Model.MaterialId" class="cq-btn cq-btn-ghost">Cancel</a>
                    <button type="submit" asp-page-handler="Save" class="cq-btn cq-btn-primary">Save Quiz</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('cqForm');
            if (!form) return;

            // Live-update completion dots in the right rail
            const recomputeAll = () => {
                const qs = form.querySelectorAll('.cq-question');
                let done = 0;
                qs.forEach((q, k) => {
                    const text   = q.querySelector('textarea[data-watch="text"]').value.trim();
                    const opts   = [...q.querySelectorAll('input[data-watch="opt"]')].map(i => i.value.trim());
                    const correct = q.querySelector('input[data-watch="correct"]:checked');
                    const ok = text && opts.every(Boolean) && correct;
                    const railDot = document.querySelector(`.cq-rail-item[data-jump-idx="${k}"] .cq-rail-dot`);
                    const state = q.querySelector('.cq-q-state');
                    if (ok) {
                        q.dataset.complete = '1';
                        railDot?.classList.add('ok');
                        state?.classList.add('ok');
                        if (state) state.textContent = '✓ ready';
                        done++;
                    } else {
                        q.dataset.complete = '0';
                        railDot?.classList.remove('ok');
                        state?.classList.remove('ok');
                        if (state) state.textContent = 'needs answer';
                    }
                });
                const counter = document.getElementById('cqDoneCount');
                if (counter) counter.textContent = done;
            };

            form.addEventListener('input', recomputeAll);
            form.addEventListener('change', recomputeAll);
            recomputeAll();
        })();
    </script>
}

<style>
    .cq-page { max-width: 1180px; margin: 0 auto; padding: 8px 4px 60px; color: #1c1917; }

    .cq-alert {
        background: #fef3c7; border: 1px solid #fcd34d; color: #78350f;
        padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; font-size: 14px;
    }

    .cq-form { display: flex; flex-direction: column; gap: 18px; }
    .cq-layout { display: grid; grid-template-columns: 1fr 280px; gap: 20px; align-items: start; }
    @@media (max-width: 980px) { .cq-layout { grid-template-columns: 1fr; } .cq-rail { order: -1; } }
    .cq-main { display: flex; flex-direction: column; gap: 18px; min-width: 0; }

    .cq-card {
        background: #fff; border: 1px solid #ece7df; border-radius: 14px;
        padding: 24px; padding-bottom: 5px; box-shadow: 0 1px 3px rgba(15, 23, 42, .04);
    }
    .cq-card-head { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
    .cq-card-icon {
        width: 42px; height: 42px; border-radius: 10px;
        background: linear-gradient(135deg, #c9a24b, #8b7355);
        color: #fff; display: flex; align-items: center; justify-content: center;
        font-size: 20px; flex-shrink: 0;
    }
    .cq-card-head h2 { margin: 0; font-size: 18px; font-weight: 700; color: #1c1917; }
    .cq-card-head small { color: #78716c; font-size: 13px; }

    .cq-meta-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; }
    @@media (max-width: 700px) { .cq-meta-grid { grid-template-columns: 1fr; } }

    .cq-field { display: flex; flex-direction: column; gap: 6px; }
    .cq-field label { font-size: 13px; font-weight: 600; color: #44403c; }
    .cq-field input, .cq-field textarea {
        padding: 10px 14px; border: 1px solid #ece7df; border-radius: 8px;
        font-size: 14px; color: #1c1917; background: #fff;
        transition: border-color .15s, box-shadow .15s; font-family: inherit;
    }
    .cq-field input:focus, .cq-field textarea:focus {
        outline: none; border-color: #b8935a; box-shadow: 0 0 0 3px rgba(201, 162, 75, .35);
    }
    .cq-field textarea { resize: vertical; min-height: 60px; }
    .cq-err { color: #dc2626; font-size: 12px; min-height: 14px; }
    .cq-hint { color: #78716c; font-size: 11px; }

    /* ── Theme chooser cards ── */
    .cq-themes { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    @@media (max-width: 700px) { .cq-themes { grid-template-columns: 1fr; } }

    .cq-theme { display: block; cursor: pointer; }
    .cq-theme input { display: none; }
    .cq-theme-card {
        display: grid; grid-template-columns: 130px 1fr auto; gap: 14px; align-items: center;
        padding: 14px; border: 2px solid #ece7df; border-radius: 12px;
        background: #fff; transition: all .15s; position: relative;
    }
    .cq-theme:hover .cq-theme-card { border-color: #cbd5e1; transform: translateY(-1px); }
    .cq-theme input:checked + .cq-theme-card {
        border-color: #b8935a; background: #f4ecdd;
        box-shadow: 0 4px 14px rgba(184, 147, 90, .15);
    }
    .cq-theme-name { font-size: 15px; font-weight: 700; color: #1c1917; margin-bottom: 2px; }
    .cq-theme-desc { font-size: 12px; color: #78716c; line-height: 1.4; margin-bottom: 6px; }
    .cq-theme-tag { font-size: 11px; color: #78716c; }
    .cq-theme-tag code { background: #f1f5f9; padding: 1px 6px; border-radius: 4px; font-size: 11px; color: #44403c; }
    .cq-theme-check {
        width: 26px; height: 26px; border-radius: 50%;
        border: 2px solid #ece7df; background: #fff;
        display: flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 13px; color: transparent; transition: all .15s;
    }
    .cq-theme input:checked + .cq-theme-card .cq-theme-check {
        background: #b8935a; border-color: #b8935a; color: #fff;
    }

    /* ── Mini realistic previews (130×88) ── */
    .cq-mini {
        width: 130px; height: 88px; border-radius: 8px;
        overflow: hidden; position: relative; flex-shrink: 0;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);
    }

    /* Default (Studio) mini */
    .cq-mini-studio {
        background: linear-gradient(135deg, #e0e7ff 0%, #f5d0fe 50%, #fce7f3 100%);
