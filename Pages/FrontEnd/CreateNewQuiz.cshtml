    }
    .cq-mini-studio .cq-mini-studio-card {
        width: 88%; background: rgba(255,255,255,.85); backdrop-filter: blur(4px);
        border-radius: 8px; padding: 8px 10px;
        box-shadow: 0 2px 8px rgba(99, 102, 241, .2);
