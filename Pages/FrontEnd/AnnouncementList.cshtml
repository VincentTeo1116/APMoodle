@page
@model APMoodle.Pages.BackEnd.AnnouncementListModel

@{
    ViewData["Title"] = "Announcements";
}

<head>
    <link rel="stylesheet" href="~/css/announcement.css">
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<form method="post" id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

<div class="announcement-page">
    <!-- Header Section - Title only -->
    <div class="announcement-header-section">
        <h1>Announcement List</h1>
        <p class="announcement-subtitle">Manage and publish announcements to your users</p>
    </div>

    <!-- Stats Cards -->
    <div class="announcement-stats-grid">
        <div class="announcement-stat-card">
            <div class="stat-number" id="totalCount">@Model.TotalCount</div>
            <div class="stat-label">Total Announcements</div>
        </div>
        <div class="announcement-stat-card">
            <div class="stat-number" id="filteredCount">@Model.TotalCount</div>
            <div class="stat-label">Filtered Results</div>
        </div>
        <div class="announcement-stat-card">
            <div class="stat-number" id="latestCount">@Model.Announcements.Take(3).Count()</div>
            <div class="stat-label">Recent (Last 3)</div>
        </div>
    </div>

    <!-- Action Bar - No box, centered search/filter -->
    <div class="announcement-action-bar">
        <div class="search-filter-group">
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="searchInput" placeholder="Search announcements..." />
            </div>
            <select id="filterDateRange" class="filter-select">
                <option value="all">All Time</option>
                <option value="today">Today</option>
                <option value="week">Last 7 Days</option>
                <option value="month">Last 30 Days</option>
                <option value="year">Last Year</option>
            </select>
            <select id="filterCreatedBy" class="filter-select">
                <option value="all">All Creators</option>
                @if (Model.UniqueCreators != null && Model.UniqueCreators.Any())
                {
                    @foreach (var creator in Model.UniqueCreators)
                    {
                        <option value="@creator">@creator</option>
                    }
                }
            </select>
        </div>
        <button class="create-btn" id="createAnnouncementBtn">
            <span>+</span> Create Announcement
        </button>
    </div>

    <!-- Announcement Table -->
    <div class="announcement-table-container">
        <table class="announcement-table" id="announcementTable">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Message</th>
                    <th>Created By</th>
                    <th>Created Time</th>
                    <th class="actions-header">Actions</th>
                </tr>
            </thead>
            <tbody id="announcementTableBody">
                @if (Model.Announcements != null && Model.Announcements.Any())
                {
                    @foreach (var announcement in Model.Announcements)
                    {
                        <tr data-id="@announcement.AnnouncementID" 
                            data-created-by="@(announcement.Creator?.Name ?? "Unknown")"
                            data-created-date="@announcement.CreatedAt.ToString("yyyy-MM-dd")">
                            <td class="title-cell">@announcement.Title</td>
                            <td class="message-cell">@announcement.Message</td>
                            <td class="created-by-cell">@(announcement.Creator?.Name ?? "Unknown")</td>
                            <td class="created-time-cell">@announcement.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td class="action-cell">
                                <div class="action-buttons-wrapper">
                                    <button class="action-btn view-btn" data-id="@announcement.AnnouncementID" title="View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="action-btn edit-btn" data-id="@announcement.AnnouncementID" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="action-btn delete-btn" data-id="@announcement.AnnouncementID" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="5" class="empty-message">
                            No announcements found. Click "Create Announcement" to add one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal for View Details -->
<div id="announcementModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-header-title">
                <i class="bi bi-bell"></i>
                <h3 id="modalTitle">Announcement Details</h3>
            </div>
            <span class="modal-close">&times;</span>
        </div>
        <div class="modal-body">
            <div id="modalContent"></div>
        </div>
        <div class="modal-footer">
            <button id="modalCloseBtn" class="btn-secondary">Close</button>
        </div>
    </div>
</div>

<div id="successPopupModal" class="success-modal" style="display:none;">
    <div class="success-modal-content">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h3>Deleted Successfully</h3>
        <p>The announcement has been removed.</p>
        <button id="successCloseBtn" class="success-btn">OK</button>
    </div>
</div>

<script src="~/js/announcement.js"></script>