@page
@using Microsoft.AspNetCore.Http
@model APMoodle.Pages.BackEnd.ModuleOverviewModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Module Overview";
}

@{
    var userId = HttpContext.Session.GetString("UserID");
    var userRole = HttpContext.Session.GetString("UserRole") ?? "Guest";
    var userName = HttpContext.Session.GetString("UserName") ?? "User";
    var isLoggedIn = !string.IsNullOrEmpty(userId) && userRole != "Guest";
}
<head>
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/css/module.css" />
</head>
<div>
    <div class="PageTitle">
        <h1>@ViewData["Title"]</h1>
        <p class="path">@(char.ToUpper(userRole[0]) + userRole.Substring(1)) Dashboard > @ViewData["Title"]</p>
    </div>

    @if (userRole == "lecturer")
    {
        <div class="filter-search-bar">
            <div class="filter-bar">
                <select id="filterModule">
                    <option value="all">All Modules</option>
                    <option value="active">Active Modules</option>
                    <option value="completed">Completed Modules</option>
                </select>
            </div>
            <div class="search-bar">
                <input type="text" id="searchModule" placeholder="Search modules..." />
            </div>
        </div>
    }

    <div class="PageComponent">
        @if (Model.Modules != null && Model.Modules.Any())
        {
            foreach (var module in Model.Modules)
            {
                <div class="module-card">
                    <div class="module-cover">
                        <span>📚</span>
                    </div>
                    <div class="module-content">
                        <div class="module-code">@module.ModuleCode</div>
                        <h3 class="module-title">@module.Name</h3>
                        <p class="module-description">@(module.Description ?? "No description available")</p>
                    </div>
                    <div class="module-footer">
                        <span class="module-lecturer">👨‍🏫 @(module.Lecturer?.Name ?? "Staff")</span>
                        <a href="/FrontEnd/TeachingMaterial/@module.ModuleID" class="btn-view">View Module</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <span>📭</span>
                <h3>No Modules Found</h3>
                @if (userRole == "lecturer")
                {
                    <p>You haven't invited to any modules yet. Please contact the admin to get help.</p>
                }
                else if (userRole == "student")
                {
                    <p>You haven't enrolled in any modules yet.</p>
                    <a href="/FrontEnd/AvailableModules" class="btn-create">Browse Available Modules</a>
                }
                else
                {
                    <p>There are currently no modules available.</p>
                }
            </div>
        }
    </div>
</div>