@{
    var adminLayout = "Admin Portal";
    var lecturerLayout = "Lecturer Portal";
    var studentLayout = "Student Portal";

    var userId = Context.Session.GetString("UserID");
    var userRole = Context.Session.GetString("UserRole") ?? "Guest";
    var userName = Context.Session.GetString("UserName") ?? "User";
    
    var isLoggedIn = !string.IsNullOrEmpty(userId) && userRole != "Guest";
    
    Console.WriteLine($"DEBUG - UserID: {userId}, Role: {userRole}, isLoggedIn: {isLoggedIn}");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="custom-navbar navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">APMoodle</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" title="Main navigation">
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Shows Portal Name based on role -->
                        <li class="nav-item" style="position: absolute; left: 50%; transform: translateX(-50%);">
                            <a class="nav-link text-dark fw-bold" href="/">
                                @if (userRole == "admin")
                                {
                                    @adminLayout
                                }
                                else if (userRole == "lecturer")
                                {
                                    @lecturerLayout
                                }
                                else if (userRole == "student")
                                {
                                    @studentLayout
                                }
                                else
                                {
                                    @:Guest Portal
                                }
                            </a>
                        </li>

                        <!-- Only show Logout button -->
                        @if (isLoggedIn)
                        {
                            <li class="nav-login">
                                <a class="nav-link-login" href="/Logout" title="Click here to logout" style="background: linear-gradient(-135deg, #dc3545, #95111e);">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-login">
                                <a class="nav-link-login" href="/Login" title="Click here to login or register">Login/Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
        
        <!-- Sidebar Menu (only for logged in users) -->
        @if (isLoggedIn)
        {
            <nav>
                <div class="expandable-vertical-menu" id="expandableMenu" title="Click to expand menu">
                    <div class="btn-expand-menu" id="menuToggle">
                        <div class="expandable-menu-bar"></div>
                        <div class="expandable-menu-bar"></div>
                        <div class="expandable-menu-bar"></div>
                    </div>
                    <div class="menu-panel">
                        <div class="menu-header">
                            <h3>APMoodle</h3>
                        </div>
                        <div class="menu-links" style="margin-top: 70px;">
                            <a href="/Student/Dashboard" class="menu-item">Dashboard</a>
                            <a href="/TestDB" class="menu-item">Test Database</a>
                            <a href="/ModuleOverview" class="menu-item">Module</a>
                            <a href="/Settings" class="menu-item">Settings</a>
                        </div>
                        <div class="menu-footer">
                            <span>APMoodle v1.0</span>
                        </div>
                    </div>
                </div>
                <div class="menu-overlay" id="menuOverlay"></div>
            </nav>
        }
    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - APMoodle - <a href="/Privacy">Privacy</a>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>