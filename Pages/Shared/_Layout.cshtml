@{
    var adminLayout = "Admin Portal";
    var lecturerLayout = "Lecturer Portal";
    var studentLayout = "Student Portal";

    var userId = Context.Session.GetString("UserID");
    var userRole = Context.Session.GetString("UserRole") ?? "Guest";
    var userName = Context.Session.GetString("UserName") ?? "User";

    var isLoggedIn = !string.IsNullOrEmpty(userId) && userRole != "Guest";

    Console.WriteLine($"Current login status - UserID: {userId}, Role: {userRole}, isLoggedIn: {isLoggedIn}");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav
            class="custom-navbar navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/FrontEnd/Index" title="Back to main page">APMoodle</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Shows Portal Name based on role -->
                        <li class="nav-item" style="position: absolute; left: 50%; transform: translateX(-50%);">
                            <a class="nav-link text-dark fw-bold">
                                @if (userRole == "admin")
                                {
                                    @adminLayout
                                }
                                else if (userRole == "lecturer")
                                {
                                    @lecturerLayout
                                }
                                else if (userRole == "student")
                                {
                                    @studentLayout
                                }
                                else
                                {
                                    @:Guest Portal
                                }
                            </a>
                        </li>
                        <div style="display: flex; align-items: center; gap: 10px; margin-left: auto;">
                            <!-- Only show Logout button -->
                            @if (isLoggedIn)
                            {
                                <li class="nav-profile-item">
                                    <a class="nav-profile" href="/FrontEnd/Profile" title="Click here to view your profile">
                                        <img src="~/img/profileIcon.png" alt="Profile" class="profile-icon" />
                                    </a>
                                </li>
                                <li class="nav-login">
                                    <a class="nav-link-login" href="/FrontEnd/Logout" title="Click here to logout"
                                       style="background: linear-gradient(-135deg, #dc3545, #95111e);">Logout</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-login">
                                    <a class="nav-link-login" href="/FrontEnd/Login"
                                       title="Click here to login or register">Login/Register</a>
                                </li>
                            }
                        </div>
                    </ul>
                </div>
            </div>
        </nav>

        @if (isLoggedIn)
        {

            <div class="expandable-vertical-menu" id="expandableMenu">
                <div class="menu-panel">
                    <!-- Menu Links -->
                    <div class="menu-links">
                        @if (userRole == "lecturer")
                        {
                            <a href="/FrontEnd/LecturerDashboard" class="menu-item">
                                <span class="menu-icon">📊</span>
                                <span>View Dashboard</span>
                            </a>
                            <a href="/FrontEnd/ModuleOverview" class="menu-item">
                                <span class="menu-icon">📚</span>
                                <span>View Module List</span>
                            </a>
                            <a href="/FrontEnd/Chat" class="menu-item">
                                <span class="menu-icon">💬</span>
                                <span>View Chat</span>
                            </a>
                            @* <a href="/FrontEnd/AnnouncementList" class="menu-item">
                                <span class="menu-icon">📚</span>
                                <span>Announcements</span>
                            </a> *@
                            <a href="/FrontEnd/Settings" class="menu-item">
                                <span class="menu-icon">⚙️</span>
                                <span>Settings</span>
                            </a>
                        }
                        else if (userRole == "student")
                        {
                            <a href="/FrontEnd/StudentDashboard" class="menu-item">
                                <span class="menu-icon">📊</span>
                                <span>View Dashboard</span>
                            </a>
                            <a href="/FrontEnd/ModuleOverview" class="menu-item">
                                <span class="menu-icon">📚</span>
                                <span>View Module</span>
                            </a>
                            <a href="/FrontEnd/Chat" class="menu-item">
                                <span class="menu-icon">💬</span>
                                <span>Chat</span>
                            </a>
                            @* <a href="/FrontEnd/AnnouncementList" class="menu-item">
                                <span class="menu-icon">📚</span>
                                <span>Announcements</span>
                            </a> *@
                            <a href="/FrontEnd/Settings" class="menu-item">
                                <span class="menu-icon">⚙️</span>
                                <span>Settings</span>
                            </a>
                        }
                        else if (userRole == "admin")
                        {
                            <a href="/FrontEnd/AdminDashboard" class="menu-item">
                                <span class="menu-icon">📊</span>
                                <span>Home</span>
                            </a>
                            <a href="/FrontEnd/AnnouncementList" class="menu-item">
                                <span class="menu-icon">📚</span>
                                <span>Announcements</span>
                            </a>
                            <a href="/FrontEnd/ModuleOverview" class="menu-item">
                                <span class="menu-icon">📚</span>
                                <span>View Module List</span>
                            </a>
                            <a href="/FrontEnd/TestDB" class="menu-item">
                                <span class="menu-icon">🗄️</span>
                                <span>View Database</span>
                            </a>
                            <a href="/FrontEnd/Settings" class="menu-item">
                                <span class="menu-icon">⚙️</span>
                                <span>Settings</span>
                            </a>
                        }
                    </div>

                    <!-- Expand/Collapse Button at BOTTOM -->
                    <div class="btn-expand-menu" id="menuToggle">
                        <span class="expand-icon" id="expandIcon">❯</span>
                        <span class="expand-text">Expand</span>
                    </div>

                    <!-- Footer -->
                    <div class="menu-footer">
                        <span>v1.0</span>
                    </div>
                </div>
            </div>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - APMoodle - <a href="/FrontEnd/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>