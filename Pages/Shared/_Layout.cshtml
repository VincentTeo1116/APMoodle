@{
    var adminLayout = "Admin Portal";
    var lecturerLayout = "Lecturer Portal";
    var studentLayout = "Student Portal";

    var userId = Context.Session.GetString("UserID");
    var userRole = Context.Session.GetString("UserRole") ?? "Guest";
    var userName = Context.Session.GetString("UserName") ?? "User";

    var isLoggedIn = !string.IsNullOrEmpty(userId) && userRole != "Guest";

    Console.WriteLine($"Current login status - UserID: {userId}, Role: {userRole}, isLoggedIn: {isLoggedIn}");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>

<body>
    <header>
        <nav class="custom-navbar navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 @(userRole == "Guest" ? "guest-navbar" : "")">
            <div class="container-fluid">
                @if (userRole == "admin")
                {
                    <a class="brand" href="/FrontEnd/AdminDashboard" title="Back to main page"><span class="brand-mark"><i class="fas fa-graduation-cap"></i></span> APMoodle</a>
                }
                else if (userRole == "lecturer")
                {
                    <a class="brand" href="/FrontEnd/LecturerDashboard" title="Back to main page"><span class="brand-mark"><i class="fas fa-graduation-cap"></i></span> APMoodle</a>
                }
                else if (userRole == "student")
                {
                    <a class="brand" href="/FrontEnd/StudentDashboard" title="Back to main page"><span class="brand-mark"><i class="fas fa-graduation-cap"></i></span> APMoodle</a>
                }
                else
                {
                    <a class="brand" href="/" title="Back to main page"><span class="brand-mark"><i class="fas fa-graduation-cap"></i></span> APMoodle</a>
                }
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Shows Portal Name based on role -->
                        <li class="nav-item" style="position: absolute; left: 50%; transform: translateX(-50%);">
                            <a class="nav-link text-dark fw-bold" style="margin-top: 6px">
                                @if (userRole == "admin")
                                {
                                    @adminLayout
                                }
                                else if (userRole == "lecturer")
                                {
                                    @lecturerLayout
                                }
                                else if (userRole == "student")
                                {
                                    @studentLayout
                                }
                                else
                                {
                                    @:Guest Portal
                                }
                            </a>
                        </li>
                        <div style="display: flex; align-items: center; gap: 10px; margin-left: auto;">
                            @if (isLoggedIn)
                            {
                                <li class="nav-profile-item">
                                    <a class="nav-profile" href="/FrontEnd/Profile" title="Click here to view your profile">
                                        <img src="~/img/profileIcon.png" alt="Profile" class="profile-icon" />
                                    </a>
                                </li>
                                <li class="nav-login">
                                    <a class="nav-link-login" href="/FrontEnd/Logout" title="Click here to logout">Logout</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-login">
                                    <a class="nav-link-login" href="/FrontEnd/Login"
                                       title="Click here to login or register">Login/Register</a>
                                </li>
                            }
                        </div>
                    </ul>
                </div>
            </div>
        </nav>

        @if (isLoggedIn)
        {

            <div class="expandable-vertical-menu" id="expandableMenu">
                <div class="menu-panel">
                    <!-- Menu Links -->
                    <div class="menu-links">
                        @if (userRole == "lecturer")
                        {
                            <a href="/FrontEnd/LecturerDashboard" class="menu-item">
                                <span class="menu-icon" title="View Lecturer Dashboard"><i class="bi bi-speedometer"></i></span>
                                <span>View Dashboard</span>
                            </a>
                            <a href="/FrontEnd/ModuleOverview" class="menu-item">
                                <span class="menu-icon" title="View Module List"><i class="bi bi-book-half"></i></span>
                                <span>View Module List</span>
                            </a>
                            <a href="/FrontEnd/Chat" class="menu-item">
                                <span class="menu-icon" title="Open Chat"><i class="bi bi-chat-left-dots-fill"></i></span>
                                <span>View Chat</span>
                            </a>
                            <a href="/FrontEnd/ViewAnnouncements" class="menu-item">
                                <span class="menu-icon" title="View Announcements"><i class="bi bi-megaphone-fill"></i></span>
                                <span>Announcements</span>
                            </a>
                        }
                        else if (userRole == "student")
                        {
                            <a href="/FrontEnd/StudentDashboard" class="menu-item">
                                <span class="menu-icon" title="View Student Dashboard"><i class="bi bi-speedometer"></i></span>
                                <span>View Dashboard</span>
                            </a>
                            <a href="/FrontEnd/ModuleOverview" class="menu-item">
                                <span class="menu-icon" title="View Module Enrolled"><i class="bi bi-book-half"></i></span>
                                <span>View Module</span>
                            </a>
                            <a href="/FrontEnd/Chat" class="menu-item">
                                <span class="menu-icon" title="Open Chat"><i class="bi bi-chat-left-dots-fill"></i></span>
                                <span>Chat</span>
                            </a>
                            <a href="/FrontEnd/ViewAnnouncements" class="menu-item">
                                <span class="menu-icon" title="View Announcements"><i class="bi bi-megaphone-fill"></i></span>
                                <span>Announcements</span>
                            </a>
                        }
                        else if (userRole == "admin")
                        {
                            <a href="/FrontEnd/AdminDashboard" class="menu-item">
                                <span class="menu-icon" title="View Admin Dashboard"><i class="bi bi-speedometer"></i></span>
                                <span>Home</span>
                            </a>
                            <a href="/FrontEnd/AnnouncementList" class="menu-item">
                                <span class="menu-icon" title="Manage Announcements"><i class="bi bi-megaphone-fill"></i></span>
                                <span>Manage Announcements</span>
                            </a>
                            <a href="/FrontEnd/UserList" class="menu-item">
                                <span class="menu-icon" title="Manage Users"><i class="bi bi-person-bounding-box"></i></span>
                                <span>Manage Users</span>
                            </a>
                            <a href="/FrontEnd/ModuleList" class="menu-item">
                                <span class="menu-icon" title="Manage Modules"><i class="bi bi-book-half"></i></span>
                                <span>Manage Modules</span>
                            </a>
                            <a href="/FrontEnd/TestDB" class="menu-item">
                                <span class="menu-icon" title="View Database"><i class="bi bi-database-check"></i></span>
                                <span>View Database</span>
                            </a>
                        }
                    </div>

                    <!-- Expand/Collapse Button at BOTTOM -->
                    <div class="btn-expand-menu" id="menuToggle">
                        <span class="expand-icon" id="expandIcon">❯</span>
                        <span class="expand-text">Expand</span>
                    </div>

                </div>
            </div>
        }
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-brand">
                <i class="bi bi-mortarboard-fill"></i> APMoodle
            </div>
            <div class="footer-links">
                <a href="/FrontEnd/Privacy">Privacy</a>
            </div>
            <div class="footer-copy">
                &copy; @DateTime.Now.Year APMoodle - Built with <i class="bi bi-heart-fill"></i> for education
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>