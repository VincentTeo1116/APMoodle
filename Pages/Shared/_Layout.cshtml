@{
    var adminLayout = "Admin Portal";
    var lecturerLayout = "Lecturer Portal";
    var studentLayout = "Student Portal";
    
    // Check if user is authenticated safely
    var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - APMoodle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="custom-navbar navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">APMoodle</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/TestDB">Check Database</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    if (User.IsInRole("Admin"))
                                    {
                                        @adminLayout
                                    }
                                    else if (User.IsInRole("Lecturer"))
                                    {
                                        @lecturerLayout
                                    }
                                    else if (User.IsInRole("Student"))
                                    {
                                        @studentLayout
                                    }
                                    else
                                    {
                                        @:Dashboard
                                    }
                                }
                                else
                                {
                                    @:Dashboard
                                }
                            </a>
                        </li>

                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-login">
                                <a class="nav-link-login" href="/Login" title="Click here to login or register">Login/Register</a>
                            </li>
                        }
                        else
                        {
                            <!-- LOGOUT BUTTON (Shows when logged in) -->
                            <li class="nav-login">
                                <a class="nav-link-login" href="/Logout" title="Click here to logout" style="background: #dc3545;">Logout</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - APMoodle - <a href="/Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>